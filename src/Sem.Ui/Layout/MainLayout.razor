@inherits LayoutComponentBase
@implements IDisposable
@inject SessionHost Host
@inject NavigationManager Navigation
@inject DesignSync Sync
@inject FileQuestions Questions
@inject IServiceProvider Services

@*
    Where you are, and the frame around it.

    Three tabs and nothing else: the list, the wiki, and the app in a window. Everything that acts on
    the designs file used to be here too - Create, Import, Cloud, Save, Reset - which made navigation
    and actions look identical and put a band of file management above a wiki page about civics.
    Those are on the empire list now, where the file is; EmpireFileBar has them.

    What stays is the work rather than the asking. The way back from a provider's sign-in lands on
    whichever address the browser was sent to, so the code in it is spent here, and a file chosen on
    an earlier visit is fetched here - but the questions that come out of both go into FileQuestions
    and wait for the bar to draw them.
*@

<div class="sem-app @(_windows is null ? null : "framed")">
    <header class="sem-header">
        <span class="brand">Stellaris Empire Manager</span>

        @*
            The band of nothing between the brand and the file's controls, which on a host with no
            title bar is what a title bar was: press it to move the window, double-click it to
            maximise. Drawn only there, so a browser tab pays nothing for it.

            The mousedown is the only handler, and the double-click is not missing. The first press
            hands the pointer to the window for the move, so nothing after it - the release, the
            second press, the pair - ever reaches the page; a dblclick here never fired once. The
            host counts them instead, where it can see the move end.
        *@
        @if (_windows is not null)
        {
            <div class="sem-drag-region" @onmousedown="BeginDrag"></div>
        }

        @*
            The menu on a narrow screen. A checkbox and its label rather than a scripted button: the
            state is one boolean, the platform already has a control for exactly that, and it works
            whether or not the app has finished loading. Hidden entirely above the breakpoint, where
            the items fit on the line beside the brand.
        *@
        <input type="checkbox" id="header-menu" class="sem-header-toggle" />
        <label for="header-menu" class="sem-header-burger" aria-label="Menu" title="Menu">
            <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </label>

        <nav class="sem-header-actions">
            @* Goes through the designer's own guard, since an anchor's navigation is one Blazor
               routes through the NavigationManager like any other. *@
            <NavLink href="" Match="NavLinkMatch.All" class="sem-tab">Empires</NavLink>

            <NavLink href="wiki" class="sem-tab">Wiki</NavLink>

            @*
                And the same app with a real file behind it, for anyone who would rather have that.
                Drawn only where this is not already the answer: offering somebody a download of
                what they are running is an app that was not looking.
            *@
            @if (_releases is not null)
            {
                <button type="button" class="sem-tab"
                        title="Get the Windows app, which opens your designs file itself"
                        @onclick="OfferTheDesktop">
                    Download
                </button>
            }
        </nav>
    </header>

    @*
        The window's own three buttons, beside the header rather than inside it.

        Inside, they would have been trapped: the header is a stacking context of its own and sits
        below any dialog, so an open question would have covered the only way this window has of
        being closed. Out here they are always reachable, which for a window with no title bar is the
        difference between a dialog and a dead end.
    *@
    @if (_windows is { } window)
    {
        <div class="sem-window-buttons">
            <button type="button" class="sem-window-button" title="Minimise" aria-label="Minimise"
                    @onclick="window.Minimise">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                     stroke-width="1.2" aria-hidden="true" focusable="false">
                    <path d="M2 8h12" />
                </svg>
            </button>

            <button type="button" class="sem-window-button"
                    title="@(window.IsMaximised ? "Restore" : "Maximise")"
                    aria-label="@(window.IsMaximised ? "Restore" : "Maximise")"
                    @onclick="window.ToggleMaximise">
                @if (window.IsMaximised)
                {
                    @* Two overlapping frames, which is how every window has said "restore" since 95. *@
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                         stroke-width="1.2" aria-hidden="true" focusable="false">
                        <path d="M4.5 4.5V2.5h9v9h-2" />
                        <rect x="2.5" y="4.5" width="9" height="9" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                         stroke-width="1.2" aria-hidden="true" focusable="false">
                        <rect x="2.5" y="2.5" width="11" height="11" />
                    </svg>
                }
            </button>

            <button type="button" class="sem-window-button close" title="Close" aria-label="Close"
                    @onclick="window.Close">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                     stroke-width="1.2" aria-hidden="true" focusable="false">
                    <path d="M3 3l10 10M13 3L3 13" />
                </svg>
            </button>
        </div>
    }

    @*
        What the Desktop button opens.

        The download is offered from the first frame, because its address is fixed and asking GitHub
        anything is only how the size and the date are found out. That was the wrong way round: a
        rationed address - sixty requests an hour, shared with everything else on somebody's network
        - took the installer away with it, and the app looked like it had lost its own download.

        Only GitHub saying there is nothing there takes it away now, and then the button becomes the
        releases page.
    *@
    @if (_offering)
    {
        <ConfirmDialog Title="The Windows app" Message="@DesktopOffer"
                       OnDismiss="() => _offering = false">
            @if (_releases is { Offered: true })
            {
                @* An anchor, not a button: what it does is fetch a file, which is what a link is. *@
                <a class="sem-button" href="@(_build?.Address ?? Releases.Download)">
                    Download@(_build is { } build ? $" {build.Size}" : string.Empty)
                </a>
            }
            else
            {
                <a class="sem-button" href="@Releases.Page" target="_blank" rel="noopener">
                    Open the releases page
                </a>
            }

            <button type="button" @onclick="() => _offering = false">Close</button>
        </ConfirmDialog>
    }

    @*
        The two quiet lines, which stay on every page: one is the file falling out of step and the
        other a sign-in that lapsed, and neither is a modal. What the bar itself has to say about a
        file it just handled goes with the bar.
    *@
    @if (Sync.Note is { } trouble)
    {
        <p class="sem-header-error">@trouble</p>
    }
    else if (_cloud?.Note is { } cloudTrouble)
    {
        @*
            Said in the header rather than only inside the sheet, because the sheet is not open
            when this matters most: a sign-in that lapsed overnight is found on the next load, and
            a warning nobody opens a dialog to see is a warning nobody gets.
        *@
        <p class="sem-header-error">
            @cloudTrouble

            @if (_cloud.SessionEnded)
            {
                <button type="button" class="sem-inline"
                        @onclick="() => { Questions.Connecting = true; Questions.Announce(); }">
                    Connect again
                </button>
            }
        </p>
    }

    @*
        The content packs, across the top of every page. They decide what half the designer offers,
        so they sit where the designer can be watched changing as they are turned on and off.
    *@
    @if (_session is not null)
    {
        <CascadingValue Value="_session">
            <DlcPanel />
        </CascadingValue>
    }

    <main class="sem-main">
        @Body
    </main>

    @*
        The window's borders, drawn by the page because nothing else can reach them.

        A WindowChrome's resize borders are hit tested by the window they belong to, and this app
        covers that window entirely with the web view's own, which answers for every pixel the
        pointer is over. So the frame is where the pointer is: eight strips at the edges of the
        viewport, each of which tells the window which border was taken hold of and lets Windows do
        the rest. None of them when the window is already filling the screen, where there is nothing
        to drag and the strips would only sit over the content.
    *@
    @if (_windows is { IsMaximised: false })
    {
        <div class="sem-resize" aria-hidden="true">
            <div class="n" @onmousedown="() => Resize(WindowEdge.Top)"></div>
            <div class="s" @onmousedown="() => Resize(WindowEdge.Bottom)"></div>
            <div class="w" @onmousedown="() => Resize(WindowEdge.Left)"></div>
            <div class="e" @onmousedown="() => Resize(WindowEdge.Right)"></div>
            <div class="nw" @onmousedown="() => Resize(WindowEdge.TopLeft)"></div>
            <div class="ne" @onmousedown="() => Resize(WindowEdge.TopRight)"></div>
            <div class="sw" @onmousedown="() => Resize(WindowEdge.BottomLeft)"></div>
            <div class="se" @onmousedown="() => Resize(WindowEdge.BottomRight)"></div>
        </div>
    }
</div>

@*
    No error bar here. Both hosts carry their own — the web app styles it from css/app.css, the
    desktop from inline rules — and a third element sharing the id made the markup invalid and, being
    first in tree order, made itself the one Blazor's showErrorNotification found. Unstyled, and on
    the desktop clipped inside a container pinned to the viewport, so the app could not report a
    failure at all.
*@

@code {
    private DesignSession? _session;

    /// <summary>
    /// Connecting to a file at a provider, where keeping your own still points Save at it.
    /// </summary>
    /// <remarks>
    /// Shaped to <see cref="ArrivalQuestion"/> exactly, since it is handed over as one. The question
    /// itself is put where the file's own controls are drawn, which is not here and may not be on
    /// screen yet: somebody reading the wiki is not asked about a file they did not come for.
    /// </remarks>
    private Task<Arrival?> AskAboutArrival(string name, int holds) =>
        Questions.AskAsync(
            _session?.File?.Designs.Count ?? 0, holds, name,
            _cloud?.ProviderName ?? "the cloud", "Take Cloud",
            "Nothing is written to it until you save.");

    /// <summary>
    /// The window this app is drawn in, where it is drawn in one of its own.
    /// </summary>
    /// <remarks>
    /// Asked for rather than injected, because it is absent in a browser and an injected service
    /// that is not registered is an exception rather than a null. Null is the answer this wants:
    /// no window chrome, no resize grips, and nothing to keep up to date.
    /// </remarks>
    private IWindowControls? _windows;

    /// <summary>What the releases page is offering, where anything here can ask. Null on the desktop.</summary>
    private Releases? _releases;

    /// <summary>Whether the sheet about the desktop app is up.</summary>
    private bool _offering;

    /// <summary>The build it found, once it has found one.</summary>
    private DesktopBuild? _build;

    /// <summary>
    /// What the sheet says: the wait, the offer, or the reason there is not one.
    /// </summary>
    /// <remarks>
    /// The size and the date are the offer. There is one version of this app to have - the download
    /// is replaced every time the code changes - so "how new is it" is the only question a number
    /// answers here, and "how big" is the one most likely to change somebody's mind.
    /// </remarks>
    private string DesktopOffer =>
        _releases is { Offered: false } missing
            ? missing.Trouble ?? "There is nothing to download just now."
            : What + _releases switch
            {
                { Asking: true } => " Asking GitHub how big it is.",
                _ when _build is { } build =>
                    $" {build.Size}, built {build.Built.ToLocalTime():d MMMM yyyy}.",
                { Trouble: { Length: > 0 } why } => $" {why}",
                _ => string.Empty,
            };

    /// <summary>The half of it that is true whatever GitHub has to say.</summary>
    private const string What =
        "The same designer in a window, with your designs file already open in it - Save writes the "
        + "file the game reads, in place, and keeps a dated copy beside it. Windows 10 or 11, "
        + "64-bit.";

    /// <summary>Opens the sheet, then fills it in when GitHub answers.</summary>
    /// <remarks>
    /// The sheet first, so the press does something immediately and the wait happens where it can
    /// be seen. Asked rather than assumed to still be true: a visit can outlast a build.
    /// </remarks>
    private async Task OfferTheDesktop()
    {
        _offering = true;
        _build = null;

        if (_releases is not { } releases)
        {
            return;
        }

        StateHasChanged();

        _build = await releases.NewestAsync();
    }

    /// <summary>
    /// The provider the app can be pointed at, where this host has one.
    /// </summary>
    /// <remarks>
    /// Absent on the desktop, which already has the player's real file and needs nothing fetching.
    /// Asked for the same way as the window controls, and for the same reason.
    /// </remarks>
    private CloudConnection? _cloud;

    protected override async Task OnInitializedAsync()
    {
        _windows = Services.GetService(typeof(IWindowControls)) as IWindowControls;

        // Registered in the browser and nowhere else, which is what decides whether the button
        // that offers the desktop app is drawn at all.
        _releases = Services.GetService(typeof(Releases)) as Releases;

        // Started before anything that watches a file, so the first answer about whether anybody is
        // looking is the truth rather than an assumption that happens to be right most of the time.
        if (Services.GetService(typeof(PageAttention)) is PageAttention attention)
        {
            await attention.StartAsync();
        }

        if (_windows is not null)
        {
            // Snapping and the shortcuts maximise a window without going through the button, and
            // the glyph beside them has to say what the window actually did.
            _windows.StateChanged += OnWindowChanged;
        }

        _session = await Host.GetAsync();

        // The bar redraws when it is clicked because its own handler ran, not because it was told.
        // Anything else that changes which packs are owned — opening a file, or whatever comes next
        // — would otherwise leave it showing the old answer.
        if (_session is not null)
        {
            _session.Changed += OnChanged;

            // After the session exists, because it is what gets kept in step. This is also where a
            // remembered "yes" from the last visit is acted on, so the file is already in step
            // before the player touches anything.
            Sync.Changed += OnChanged;
            await Sync.AttachAsync(_session);

            // After the session exists, because connecting opens a file into it.
            _cloud = Services.GetService(typeof(CloudConnection)) as CloudConnection;

            if (_cloud is not null)
            {
                _cloud.Changed += OnChanged;

                // Whether this load is the way back from the provider is asked separately from
                // whether the sign-in worked, because what follows has to happen either way. Asking
                // the one question and reading it as both is what made pressing the provider loop:
                // a return that failed left the code in the address and put nothing on screen, so
                // the next press fetched another code onto a page that would not spend that either.
                var returning = CloudConnection.IsSignInReturn(Navigation.Uri);

                await _cloud.CompleteSignInAsync(Navigation.Uri, AskAboutArrival);

                if (returning)
                {
                    // Out of the address whatever came of it, so that a reload - or a link somebody
                    // copies out of the bar - is not carrying an answer that has been spent.
                    Navigation.NavigateTo(Navigation.BaseUri, replace: true);

                    // And the picker goes up, every time. Signing in was never the errand: somebody
                    // who pressed the provider was on their way to choosing a file, and the two
                    // endings that used to skip this - a remembered file quietly reopening, and a
                    // sign-in that did not finish - are the two where being left on the empty page
                    // with no way through is worst.
                    Questions.Connecting = true;
                }
                else if (_cloud.Remembers)
                {
                    // An ordinary load onto a file chosen before. The file is the copy that counts,
                    // so it is fetched before anything may be edited: the browser's copy is only
                    // what was here last time, and an edit made against it while this is in flight
                    // would be an edit to something about to be replaced.
                    Questions.Fetching(true);

                    try
                    {
                        // False here is a file that could not be opened rather than one that was
                        // not wanted, because Remembers has already said there is one.
                        Questions.Stranded =
                            !await _cloud.ResumeAsync(AskAboutArrival) && !_cloud.Connected;
                    }
                    finally
                    {
                        Questions.Fetching(false);
                    }
                }
            }
        }
    }

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
        }

        if (_windows is not null)
        {
            _windows.StateChanged -= OnWindowChanged;
        }

        Sync.Changed -= OnChanged;

        if (_cloud is not null)
        {
            _cloud.Changed -= OnChanged;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnWindowChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    /// <summary>Moves the window, from a press anywhere the header has nothing else to do.</summary>
    private void BeginDrag() => _windows?.BeginDrag();

    /// <summary>Resizes the window, from a press on one of the strips at the edge of the page.</summary>
    private void Resize(WindowEdge edge) => _windows?.BeginResize(edge);
}
