@inherits LayoutComponentBase
@implements IDisposable
@inject SessionHost Host
@inject IFileExchange Files
@inject NavigationManager Navigation
@inject UnsavedWorkGuard Guard
@inject EditorState Editor
@inject DesignSync Sync
@inject IServiceProvider Services

@*
    The file lives in the header: the empire list, a new empire, the file in, the file out, and
    the way to put it all back.

    All four are about the file rather than about whichever page happens to be open, and both pages
    used to carry their own card of them across the top. Two cards saying the same thing is one too
    many, and on the designer it put a band of file management above the empire being designed. Here
    they are once, reachable from anywhere, and both pages begin with their own content.

    Create and Import both abandon whatever is being edited, so both ask first — through the guard,
    since the question belongs to the designer and this is not it.
*@

<div class="sem-app @(_windows is null ? null : "framed")">
    <header class="sem-header">
        <span class="brand">Stellaris Empire Manager</span>

        @*
            The band of nothing between the brand and the file's controls, which on a host with no
            title bar is what a title bar was: press it to move the window, double-click it to
            maximise. Drawn only there, so a browser tab pays nothing for it.

            The mousedown is the only handler, and the double-click is not missing. The first press
            hands the pointer to the window for the move, so nothing after it - the release, the
            second press, the pair - ever reaches the page; a dblclick here never fired once. The
            host counts them instead, where it can see the move end.
        *@
        @if (_windows is not null)
        {
            <div class="sem-drag-region" @onmousedown="BeginDrag"></div>
        }

        @*
            The menu on a narrow screen. A checkbox and its label rather than a scripted button: the
            state is one boolean, the platform already has a control for exactly that, and it works
            whether or not the app has finished loading. Hidden entirely above the breakpoint, where
            the items fit on the line beside the brand.
        *@
        <input type="checkbox" id="header-menu" class="sem-header-toggle" />
        <label for="header-menu" class="sem-header-burger" aria-label="Menu" title="Menu">
            <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </label>

        <nav class="sem-header-actions">
            @* Goes through the designer's own guard, since an anchor's navigation is one Blazor
               routes through the NavigationManager like any other. *@
            <NavLink href="" Match="NavLinkMatch.All" class="sem-tab">Empires</NavLink>

            @if (_session is not null)
            {
                <button type="button" class="sem-tab" @onclick="Create">Create</button>

                @*
                    Two ways in, and only ever one of them on the page.

                    Where the browser has a file picker this is a plain button, because a picker
                    opened from code can be told to reopen in the folder the player last used - which
                    after one import is their Stellaris folder, and is the only way this app can ever
                    land there. A page may not name a directory itself.

                    Where it has not - Firefox and Safari have no picker - it falls back to the
                    label and the hidden input, which is the older arrangement and the reason for its
                    oddities: a file input cannot be opened from code, so the click has to be allowed
                    to reach it, and the input is hidden by size rather than by display because
                    display:none takes it out of the tab order and the label is not focusable either,
                    which once left Import the one item in this header no keyboard could reach.

                    Either way the question about unsaved work is asked once the file has arrived,
                    never before: a dialog would spend the click that the picker needs.
                *@
                @if (_canPickFiles)
                {
                    <button type="button" class="sem-tab" @onclick="Pick">Import</button>
                }
                else
                {
                    <label class="sem-tab" for="designs-file">Import</label>
                    <InputFile id="designs-file" OnChange="Import" class="sem-visually-hidden" accept=".txt" />
                }

                @*
                    Where the file lives, for a host that can be pointed at one somewhere else.
                    Beside Import because it is the same question - where the empires come from -
                    and marked active while it is answered, since that is what changes what Save
                    means. Drawn only in a browser: the desktop already has a real file.
                *@
                @if (_cloud is not null)
                {
                    @*
                        Always the one word. The path belongs in the sheet, where there is room for
                        it to be read - on a button it would either be cut short at the end that
                        identifies it or push the rest of the row off the line.
                    *@
                    <button type="button"
                            class="sem-tab sem-cloud-tab @(_cloud.Connected ? "active" : null) @(_cloud.SessionEnded ? "ended" : null)"
                            title="@(_cloud.Where is { } path
                                ? $"Saving to {path} in your {_cloud.ProviderName}"
                                : "Open a designs file you keep in the cloud")"
                            @onclick="() => _connecting = true">
                        Cloud
                    </button>
                }

                @*
                    Save, and the answer to whether saving is something you ask for at all.

                    Together, because they are one decision read left to right - the word, then
                    whether it happens by itself. A chip rather than another tab: it is a state the
                    file is in, which is what a chip means everywhere else in this app, and a tab
                    beside a tab read as a second button to press.

                    The switch cannot be inside the button, however much it belongs there: a label
                    with a checkbox in it is interactive content, and interactive content inside a
                    button is not something a browser will lay out. So they are set against each
                    other instead, and the button gives up its right-hand padding to close the gap.
                *@
                <div class="sem-save">
                    <button type="button" class="sem-tab"
                            disabled="@(Nothing || Sync.Enabled)"
                            title="@(Sync.Enabled ? "Your empires are written to the file as you go." : null)"
                            @onclick="AskToSave">
                        @Files.SaveVerb
                    </button>

                    @if (Sync.Available)
                    {
                        <label class="sem-auto" title="@SyncExplained">
                            <input type="checkbox" checked="@Sync.Enabled"
                                   @onchange="e => Sync.SetAsync(e.Value is true)" />
                            <span>Auto</span>
                        </label>
                    }
                </div>

                @*
                    Last in the row, and disabled by the same question as Export: both act on the
                    whole file, so both are meaningless when there is no file or nothing in it.
                    Plain sem-tab rather than danger - a red button in the header would shout from
                    every page, and the warning belongs on the dialog's confirm button, where the
                    two existing delete flows already put it.
                *@
                <button type="button" class="sem-tab"
                        disabled="@(Nothing)"
                        @onclick="Reset">
                    Reset
                </button>
            }
        </nav>
    </header>

    @*
        The window's own three buttons, beside the header rather than inside it.

        Inside, they would have been trapped: the header is a stacking context of its own and sits
        below any dialog, so an open question would have covered the only way this window has of
        being closed. Out here they are always reachable, which for a window with no title bar is the
        difference between a dialog and a dead end.
    *@
    @if (_windows is { } window)
    {
        <div class="sem-window-buttons">
            <button type="button" class="sem-window-button" title="Minimise" aria-label="Minimise"
                    @onclick="window.Minimise">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                     stroke-width="1.2" aria-hidden="true" focusable="false">
                    <path d="M2 8h12" />
                </svg>
            </button>

            <button type="button" class="sem-window-button"
                    title="@(window.IsMaximised ? "Restore" : "Maximise")"
                    aria-label="@(window.IsMaximised ? "Restore" : "Maximise")"
                    @onclick="window.ToggleMaximise">
                @if (window.IsMaximised)
                {
                    @* Two overlapping frames, which is how every window has said "restore" since 95. *@
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                         stroke-width="1.2" aria-hidden="true" focusable="false">
                        <path d="M4.5 4.5V2.5h9v9h-2" />
                        <rect x="2.5" y="4.5" width="9" height="9" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                         stroke-width="1.2" aria-hidden="true" focusable="false">
                        <rect x="2.5" y="2.5" width="11" height="11" />
                    </svg>
                }
            </button>

            <button type="button" class="sem-window-button close" title="Close" aria-label="Close"
                    @onclick="window.Close">
                <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor"
                     stroke-width="1.2" aria-hidden="true" focusable="false">
                    <path d="M3 3l10 10M13 3L3 13" />
                </svg>
            </button>
        </div>
    }

    @*
        Asked only where the button writes over something. In a browser it opens a dialog and the
        player picks the file, so asking first would be asking twice; on the desktop it replaces the
        designs file the game itself reads, which is worth a moment's pause even though a dated
        backup is written beside it.
    *@
    @if (_saving)
    {
        <ConfirmDialog Title="Replace your empire designs file?"
                       Message="@($"Your {Count(Empires)} will be written over the file the game reads.")"
                       OnDismiss="() => _saving = false">
            <Options>
                @*
                    Remembered as it is changed rather than when the file is written, so that
                    turning it off and then thinking better of the save still leaves it off next
                    time. It is an answer about backups, not about this one save.
                *@
                <label class="sem-choice">
                    <input type="checkbox" checked="@_backUp" @onchange="KeepBackup" />
                    <span>Keep a dated copy of the file it replaces</span>
                </label>
            </Options>
            <ChildContent>
                <button type="button" @onclick="() => _saving = false">Cancel</button>
                <button type="button" class="danger" @onclick="Export">Replace it</button>
            </ChildContent>
        </ConfirmDialog>
    }

    @if (_resetting)
    {
        <ConfirmDialog Title="@($"Delete all {Empires} of your empires?")"
                       Message="@ResetWarning"
                       OnDismiss="() => _resetting = false">
            <button type="button" @onclick="() => _resetting = false">Keep them</button>
            <button type="button" class="danger" @onclick="ClearEverything">Delete them all</button>
        </ConfirmDialog>
    }

    @*
        Asked only where it cannot be decided: the file changed underneath an empire carrying edits
        nobody has saved, and taking the file would take those with it. Everywhere else the file is
        simply loaded, which is the whole point of the thing being on.
    *@
    @if (Sync.Asking)
    {
        <ConfirmDialog Title="Your designs file changed while you were editing."
                       Message="@($"Something else has written {FileTitle}. Loading it replaces the "
                                 + $"changes you have not saved{Editing}.")"
                       OnDismiss="Sync.Decline">
            <button type="button" @onclick="Sync.Decline">Keep my changes</button>
            <button type="button" class="danger" @onclick="Sync.AcceptAsync">Load the file</button>
        </ConfirmDialog>
    }

    @*
        Signing in, choosing a file, and disconnecting - one sheet, because they are three steps of
        one errand. The question about unsaved work is handed in rather than asked here: connecting
        opens a different file, exactly as importing one does.
    *@
    @if (_connecting)
    {
        <CloudDialog OnClose="() => _connecting = false" ConfirmFirst="Guard.ConfirmAsync"
                     Decide="AskAboutArrival" />
    }

    @*
        What to do with the empires already open when a connected file turns out to hold its own.

        Asked only where both sides hold something and they differ, so an ordinary reload of a
        connection that is in step is not a question. Nothing here writes: every answer decides what
        is in front of you, and the file at the provider changes only when something saves.
    *@
    @*
        The wait while a remembered file is fetched. On screen rather than silent because it is the
        one moment the app is deliberately not ready: what is behind this is last visit's copy, and
        the file about to replace it is still on its way.
    *@
    @if (_opening)
    {
        <div class="sem-modal">
            <div class="sheet" role="dialog" aria-modal="true" aria-live="polite">
                <h2>Opening your file in @(_cloud?.ProviderName ?? "the cloud")</h2>
                <p>Reading your empires from the file you connected to. This takes a moment.</p>
            </div>
        </div>
    }

    @*
        And the answer when it could not be fetched at all - offline, or a sign-in that lapsed while
        the tab was shut. Asked rather than assumed: carrying on quietly would put somebody to work
        on a copy that is not the file they think they are editing, and refusing to open anything
        would hold their empires hostage to a network.
    *@
    @if (_stranded)
    {
        <ConfirmDialog Title="@($"Your file in {_cloud?.ProviderName ?? "the cloud"} could not be opened.")"
                       Message="@("This browser still has the copy it kept last time. You can connect "
                                 + "again to work on the file itself, or carry on with that copy - "
                                 + "which Export hands back, and which you can put into the file later.")"
                       OnDismiss="() => _stranded = false">
            <button type="button" @onclick="() => _stranded = false">Use this browser's copy</button>
            <button type="button" @onclick="Reconnect">Connect again</button>
        </ConfirmDialog>
    }

    @if (_arriving is { } arrival)
    {
        <ConfirmDialog Title="@($"You already have {Count(arrival.Mine)} open.")"
                       Message="@($"{arrival.Name} holds {Count(arrival.Holds)}. Merging keeps your "
                                 + "order and adds theirs to it; the choice is only which copy of an "
                                 + $"empire you both have is the one kept. {arrival.Note}")"
                       OnDismiss="() => Arrived(null)">
            <ArrivalChoices Theirs="@arrival.Theirs" Take="@arrival.Take"
                            OnChosen="(Arrival choice) => Arrived(choice)" />
        </ConfirmDialog>
    }

    @if (_message is { } note)
    {
        <p class="@(note.IsProblem ? "sem-header-error" : "sem-header-note")">@note.Text</p>
    }
    else if (Sync.Note is { } trouble)
    {
        <p class="sem-header-error">@trouble</p>
    }
    else if (_cloud?.Note is { } cloudTrouble)
    {
        @*
            Said in the header rather than only inside the sheet, because the sheet is not open
            when this matters most: a sign-in that lapsed overnight is found on the next load, and
            a warning nobody opens a dialog to see is a warning nobody gets.
        *@
        <p class="sem-header-error">
            @cloudTrouble

            @if (_cloud.SessionEnded)
            {
                <button type="button" class="sem-inline" @onclick="() => _connecting = true">
                    Connect again
                </button>
            }
        </p>
    }

    @*
        The content packs, across the top of every page. They decide what half the designer offers,
        so they sit where the designer can be watched changing as they are turned on and off.
    *@
    @if (_session is not null)
    {
        <CascadingValue Value="_session">
            <DlcPanel />
        </CascadingValue>
    }

    <main class="sem-main">
        @Body
    </main>

    @*
        The window's borders, drawn by the page because nothing else can reach them.

        A WindowChrome's resize borders are hit tested by the window they belong to, and this app
        covers that window entirely with the web view's own, which answers for every pixel the
        pointer is over. So the frame is where the pointer is: eight strips at the edges of the
        viewport, each of which tells the window which border was taken hold of and lets Windows do
        the rest. None of them when the window is already filling the screen, where there is nothing
        to drag and the strips would only sit over the content.
    *@
    @if (_windows is { IsMaximised: false })
    {
        <div class="sem-resize" aria-hidden="true">
            <div class="n" @onmousedown="() => Resize(WindowEdge.Top)"></div>
            <div class="s" @onmousedown="() => Resize(WindowEdge.Bottom)"></div>
            <div class="w" @onmousedown="() => Resize(WindowEdge.Left)"></div>
            <div class="e" @onmousedown="() => Resize(WindowEdge.Right)"></div>
            <div class="nw" @onmousedown="() => Resize(WindowEdge.TopLeft)"></div>
            <div class="ne" @onmousedown="() => Resize(WindowEdge.TopRight)"></div>
            <div class="sw" @onmousedown="() => Resize(WindowEdge.BottomLeft)"></div>
            <div class="se" @onmousedown="() => Resize(WindowEdge.BottomRight)"></div>
        </div>
    }
</div>

@*
    No error bar here. Both hosts carry their own — the web app styles it from css/app.css, the
    desktop from inline rules — and a third element sharing the id made the markup invalid and, being
    first in tree order, made itself the one Blazor's showErrorNotification found. Unstyled, and on
    the desktop clipped inside a container pinned to the viewport, so the app could not report a
    failure at all.
*@

@code {
    private DesignSession? _session;

    /// <summary>What the header has to say about the last file it handled, and how loudly.</summary>
    /// <remarks>
    /// Two unlike things end up here. A file that would not open is a failure and is coloured as
    /// one. A file that downloaded because this browser has no save dialog, or one that opened
    /// under a name the game would not recognise, is a remark - true, worth reading once, and
    /// nothing the player did wrong. Shown in the same red, the remarks read as failures and the
    /// failures stopped standing out.
    /// </remarks>
    private (string Text, bool IsProblem)? _message;

    /// <summary>Whether the "delete everything" question is on screen.</summary>
    private bool _resetting;

    /// <summary>Whether the "replace your designs file" question is on screen.</summary>
    private bool _saving;

    /// <summary>Whether this save keeps a dated copy of the file it writes over.</summary>
    private bool _backUp = true;

    /// <summary>Asks first where the answer would overwrite something, and otherwise gets on with it.</summary>
    private async Task AskToSave()
    {
        if (Files.SavesInPlace)
        {
            _backUp = _session?.Preferences.KeepsBackup ?? true;
            _saving = true;
            return;
        }

        await Export();
    }

    /// <summary>Remembers whether to keep the copy, for this save and for every one after it.</summary>
    private void KeepBackup(ChangeEventArgs e)
    {
        _backUp = e.Value is true;
        _session?.Preferences.SetKeepsBackup(_backUp);
    }

    /// <summary>
    /// A connected file's empires, waiting to hear what to do with the ones already open.
    /// </summary>
    /// <remarks>
    /// The answer is awaited rather than acted on afterwards, because the connection is part-way
    /// through when it asks: it has read the file and has deliberately not touched the session yet,
    /// and the answer is what it does next. Import does not need this - it has already finished by
    /// the time it asks - which is why that one is a plain field and this one carries a promise.
    /// </remarks>
    private Arriving? _arriving;

    /// <summary>
    /// A file that has arrived, and the promise waiting on what to do about it.
    /// </summary>
    /// <param name="Mine">How many empires are open now, for the question to weigh against.</param>
    /// <param name="Holds">How many the arriving file holds.</param>
    /// <param name="Name">What to call it in the question - a file name, or a whole path.</param>
    /// <param name="Theirs">The short form, for a sentence: "the file", "OneDrive".</param>
    /// <param name="Take">The last button's words: "Take File", "Take Cloud".</param>
    /// <param name="Note">What is and is not written, which differs by where the file came from.</param>
    /// <param name="Answer">Completed by whichever answer is pressed, or by dismissal.</param>
    private sealed record Arriving(
        int Mine,
        int Holds,
        string Name,
        string Theirs,
        string Take,
        string Note,
        TaskCompletionSource<Arrival?> Answer);

    /// <summary>
    /// Connecting to a file at a provider, where keeping your own still points Save at it.
    /// </summary>
    /// <remarks>
    /// Shaped to <see cref="ArrivalQuestion"/> exactly, since it is handed over as one.
    /// </remarks>
    private Task<Arrival?> AskAboutArrival(string name, int holds) =>
        Asking(name, holds, _cloud?.ProviderName ?? "the cloud", "Take Cloud",
            "Nothing is written to it until you save.");

    /// <summary>Importing one from disk, which writes nothing anywhere whatever the answer.</summary>
    private Task<Arrival?> AskAboutImport(string name, int holds) =>
        Asking(name, holds, "the file", "Take File",
            "Your own file on disk is not touched either way.");

    /// <summary>Puts the question up, and answers whoever asked once something is pressed.</summary>
    private Task<Arrival?> Asking(string name, int holds, string theirs, string take, string note)
    {
        var answer = new TaskCompletionSource<Arrival?>(
            TaskCreationOptions.RunContinuationsAsynchronously);

        _arriving = new Arriving(
            _session?.File?.Designs.Count ?? 0, holds, name, theirs, take, note, answer);

        StateHasChanged();

        return answer.Task;
    }

    /// <summary>Takes the question down and lets the connection carry on, or stop.</summary>
    private void Arrived(Arrival? choice)
    {
        var waiting = _arriving?.Answer;

        _arriving = null;
        waiting?.TrySetResult(choice);
    }

    /// <summary>Whether there is a file with anything in it for the whole-file buttons to act on.</summary>
    private bool Nothing => _session?.File is null || _session.File.Designs.Count == 0;

    /// <summary>How many empires Reset would take, which the question has to say out loud.</summary>
    private int Empires => _session?.File?.Designs.Count ?? 0;

    /// <summary>
    /// What Reset costs, and - the part worth reading - what it does not.
    /// </summary>
    /// <remarks>
    /// The reassurance is the thing that makes the button safe to press. Nothing here can touch the
    /// file the game reads: this app has never written it, and only ever offers a copy through a
    /// save dialog the player drives. Someone about to delete an evening's work needs to know that
    /// their designs file is not what is being deleted.
    /// </remarks>
    private string ResetWarning =>
        $"All {Empires} empires you have made here are removed and the file is closed, leaving the "
        + "app as it was on your first visit. Your Stellaris designs file is not touched - nothing "
        + "on disk changes unless you export."
        + (_cloud is { Connected: true } cloud
            ? $" You are let go of {cloud.Where}, which is left exactly as it is."
            : string.Empty)
        + " There is no undo.";

    /// <summary>
    /// Whether this browser can be asked to show a file picker.
    /// </summary>
    /// <remarks>
    /// Asked of the host once the page exists, because it is a question about the browser and the
    /// answer needs script to get at. False keeps the file input in the page, which is the only way
    /// in on a browser without a picker, and is also what the desktop gets - it opens the player's
    /// own file without asking and has no use for a dialog.
    /// </remarks>
    private bool _canPickFiles;

    /// <summary>
    /// The window this app is drawn in, where it is drawn in one of its own.
    /// </summary>
    /// <remarks>
    /// Asked for rather than injected, because it is absent in a browser and an injected service
    /// that is not registered is an exception rather than a null. Null is the answer this wants:
    /// no window chrome, no resize grips, and nothing to keep up to date.
    /// </remarks>
    private IWindowControls? _windows;

    /// <summary>
    /// The thing that decides where a save goes, where that can change during a visit.
    /// </summary>
    /// <remarks>
    /// Asked for the same way as the window, and absent for the same reason: the desktop has one
    /// file exchange for the life of the window, so there is nothing there to hear about.
    /// </remarks>
    private FileExchangeRouter? _files;

    /// <summary>Whether the connect-to-a-provider sheet is on screen.</summary>
    private bool _connecting;

    /// <summary>Whether a file chosen on an earlier visit is still being fetched.</summary>
    private bool _opening;

    /// <summary>
    /// Whether a file was wanted, could not be had, and somebody has to say what to do about it.
    /// </summary>
    private bool _stranded;

    /// <summary>Takes the question down and goes to the provider to try again.</summary>
    private void Reconnect()
    {
        _stranded = false;
        _connecting = true;
    }

    /// <summary>
    /// The provider the app can be pointed at, where this host has one.
    /// </summary>
    /// <remarks>
    /// Absent on the desktop, which already has the player's real file and needs nothing fetching.
    /// Asked for the same way as the window controls, and for the same reason.
    /// </remarks>
    private CloudConnection? _cloud;

    /// <summary>What the sync box does, in the one sentence a tooltip has.</summary>
    private string SyncExplained =>
        Sync.Enabled
            ? "Your empires are written to your designs file as you go, and changes made to it "
              + "outside this app are loaded. Untick to go back to saving when you say so."
            : "Write to your designs file as you go, and load anything the game writes to it. "
              + "No dated backups are kept while this is on.";

    /// <summary>The file the question is about, named where there is a name to use.</summary>
    private string FileTitle =>
        _session?.FileName is { Length: > 0 } named ? named : "your empire designs file";

    /// <summary>" to Iferyx Amalgamated Fleets" - or nothing, where nothing is open.</summary>
    private string Editing =>
        _session?.Current is { } design
            ? $" to {_session.Localizer.Name(design.Name, design.Key)}"
            : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _windows = Services.GetService(typeof(IWindowControls)) as IWindowControls;

        // The header draws itself from the exchange - Save or Export, and whether to ask before
        // replacing a file - so it has to be told when the exchange underneath changes.
        _files = Services.GetService(typeof(FileExchangeRouter)) as FileExchangeRouter;

        if (_files is not null)
        {
            _files.Changed += OnChanged;
        }

        if (_windows is not null)
        {
            // Snapping and the shortcuts maximise a window without going through the button, and
            // the glyph beside them has to say what the window actually did.
            _windows.StateChanged += OnWindowChanged;
        }

        _session = await Host.GetAsync();

        // The bar redraws when it is clicked because its own handler ran, not because it was told.
        // Anything else that changes which packs are owned — opening a file, or whatever comes next
        // — would otherwise leave it showing the old answer.
        if (_session is not null)
        {
            _session.Changed += OnChanged;

            // After the session exists, because it is what gets kept in step. This is also where a
            // remembered "yes" from the last visit is acted on, so the file is already in step
            // before the player touches anything.
            Sync.Changed += OnChanged;
            await Sync.AttachAsync(_session);

            // After the session exists, because connecting opens a file into it.
            _cloud = Services.GetService(typeof(CloudConnection)) as CloudConnection;

            if (_cloud is not null)
            {
                _cloud.Changed += OnChanged;

                // Whether this load is the way back from the provider is asked separately from
                // whether the sign-in worked, because what follows has to happen either way. Asking
                // the one question and reading it as both is what made pressing the provider loop:
                // a return that failed left the code in the address and put nothing on screen, so
                // the next press fetched another code onto a page that would not spend that either.
                var returning = CloudConnection.IsSignInReturn(Navigation.Uri);

                await _cloud.CompleteSignInAsync(Navigation.Uri, AskAboutArrival);

                if (returning)
                {
                    // Out of the address whatever came of it, so that a reload - or a link somebody
                    // copies out of the bar - is not carrying an answer that has been spent.
                    Navigation.NavigateTo(Navigation.BaseUri, replace: true);

                    // And the picker goes up, every time. Signing in was never the errand: somebody
                    // who pressed the provider was on their way to choosing a file, and the two
                    // endings that used to skip this - a remembered file quietly reopening, and a
                    // sign-in that did not finish - are the two where being left on the empty page
                    // with no way through is worst.
                    _connecting = true;
                }
                else if (_cloud.Remembers)
                {
                    // An ordinary load onto a file chosen before. The file is the copy that counts,
                    // so it is fetched before anything may be edited: the browser's copy is only
                    // what was here last time, and an edit made against it while this is in flight
                    // would be an edit to something about to be replaced.
                    _opening = true;
                    StateHasChanged();

                    try
                    {
                        // False here is a file that could not be opened rather than one that was
                        // not wanted, because Remembers has already said there is one.
                        _stranded = !await _cloud.ResumeAsync(AskAboutArrival) && !_cloud.Connected;
                    }
                    finally
                    {
                        _opening = false;
                    }
                }
            }
        }
    }

    /// <summary>
    /// Finds out whether this host can show a file picker, once there is a page to ask from.
    /// </summary>
    /// <remarks>
    /// After the first render rather than before it, because the answer comes from script and there
    /// is none to run until then. Until it is known the header shows the file input, which works
    /// everywhere - so the worst a slow answer costs is that Import is briefly the older control.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var canPick = await Files.CanOpenAsync();

        if (canPick != _canPickFiles)
        {
            _canPickFiles = canPick;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
        }

        if (_windows is not null)
        {
            _windows.StateChanged -= OnWindowChanged;
        }

        Sync.Changed -= OnChanged;

        if (_files is not null)
        {
            _files.Changed -= OnChanged;
        }

        if (_cloud is not null)
        {
            _cloud.Changed -= OnChanged;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnWindowChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    /// <summary>Moves the window, from a press anywhere the header has nothing else to do.</summary>
    private void BeginDrag() => _windows?.BeginDrag();

    /// <summary>Resizes the window, from a press on one of the strips at the edge of the page.</summary>
    private void Resize(WindowEdge edge) => _windows?.BeginResize(edge);

    /// <summary>
    /// Opens a designs file in place of whatever is open.
    /// </summary>
    /// <remarks>
    /// Asked about first, because this replaces the whole file and an empire being edited goes with
    /// it. Declining drops the chosen file and leaves the session alone.
    /// </remarks>
    private async Task Import(InputFileChangeEventArgs e)
    {
        _message = null;

        if (!await Guard.ConfirmAsync())
        {
            return;
        }

        try
        {
            // Generous enough for any real designs file; the player's own is about forty kilobytes.
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            await Load(e.File.Name, buffer.ToArray());
        }
        catch (Exception ex) when (ex is Sem.Clausewitz.CwSyntaxException or IOException)
        {
            // Loading half a damaged file would be worse than refusing it.
            _message = ($"That file could not be read: {ex.Message}", true);
        }
    }

    /// <summary>
    /// Asks the browser for a designs file, and opens whatever comes back.
    /// </summary>
    /// <remarks>
    /// The picker first and the question afterwards, which is not the tidy order. A picker may only
    /// be opened while a click is still being handled, and the question is a dialog waiting on a
    /// person - ask it first and the click is long spent by the time the answer arrives. So the file
    /// is chosen, then asked about, and declining drops it.
    /// </remarks>
    private async Task Pick()
    {
        _message = null;

        if (await Files.OpenAsync() is not { } chosen)
        {
            // No picker, or the player closed it. Neither is a failure and neither is worth saying.
            return;
        }

        if (!await Guard.ConfirmAsync())
        {
            return;
        }

        try
        {
            await Load(chosen.Name, chosen.Contents);
        }
        catch (Exception ex) when (ex is Sem.Clausewitz.CwSyntaxException or IOException)
        {
            _message = ($"That file could not be read: {ex.Message}", true);
        }
    }

    /// <summary>Opens a designs file, asking first where there is unsaved work to weigh against it.</summary>
    private async Task Load(string name, byte[] contents)
    {
        // Parsed here rather than after the question, so a file that will not parse is refused with
        // the reason - the callers' catch is what turns that into a message.
        var incoming = EmpireDesignsFile.Load(contents);
        var arrival = Arrival.TakeTheirs;

        // The same three rules connecting to a file at a provider follows, because it is the same
        // question. Nothing open means nothing to lose. A file holding nothing is the one that used
        // to go wrong here: it was treated as having nothing to lose either, and opened - which
        // emptied the list, without asking, to gain nothing at all.
        if (_session!.File is { Designs.Count: > 0 })
        {
            if (incoming.Designs.Count == 0)
            {
                _message = ($"{name} holds no empires, so nothing was imported.", false);
                return;
            }

            // Dismissed, or answered "keep what I have" - which for an import are the same thing.
            // Connecting is the only place those two part company, because there keeping your own
            // still leaves Save pointed at the file.
            if (await AskAboutImport(name, incoming.Designs.Count) is not { } answered
                || answered is Arrival.KeepMine)
            {
                return;
            }

            arrival = answered;
        }

        // Closed either way. Merging can replace the very empire the editor is holding, and taking
        // the file throws away the one it came from - and an editor left open over a file that has
        // just changed underneath it is showing something nobody asked to see.
        Editor.IsOpen = false;

        if (arrival is Arrival.TakeTheirs)
        {
            _session.Open(incoming, name);
        }
        else
        {
            _session.Merge(incoming, replacingMatches: arrival is Arrival.TheirsWin);
        }
    }

    /// <summary>Adds the imported empires to the ones already open, name for name.</summary>
    /// <summary>Throws the open file away and keeps the imported one, which is what import did.</summary>
    /// <summary>A number of empires, said the way a sentence would say it.</summary>
    private static string Count(int empires) => empires == 1 ? "one empire" : $"{empires} empires";

    /// <summary>
    /// Starts a new empire and opens it.
    /// </summary>
    /// <remarks>
    /// Reachable from the designer as well as from the list, which means it can be pressed with
    /// unsaved work in hand.
    /// </remarks>
    private async Task Create()
    {
        // Asked before anything is built. Adding the empire first and asking afterwards would leave
        // a stray empire behind whenever the answer was no — and worse, selecting it would have
        // taken the previous empire's unsaved changes as its saved state on the way past.
        if (!await Guard.ConfirmAsync())
        {
            return;
        }

        var name = Available("New Empire");
        var template = _session!.Data.Database.NewEmpireTemplate;

        // Created rather than added: it belongs to the designer until it is saved, so that opening
        // the page to look at what a new empire starts as and going back again leaves nothing
        // behind. The game keeps a blank template of its own, which is what makes a new empire
        // playable straight away rather than an empty shell.
        _session.CreateEmpire(file =>
        {
            var design = string.IsNullOrEmpty(template)
                ? file.Add(name)
                : file.AddFromTemplate(template, name);

            // Named as well as keyed. The game's blank template carries name="" - it is a template
            // rather than a playable empire - so a new empire arrived with the key standing in for a
            // name everywhere it was shown, while the design itself had none. Harmless until the
            // rules learned to check for it, at which point a brand new empire read "the empire has
            // no name" beside a heading showing exactly the name it appeared to have.
            design.Name.SetLiteral(name);

            return design;
        });

        // To the list, which opens its editor on whatever is in hand. The empire is already made by
        // now, so this is only a matter of getting to the page the editor lives on - and from the
        // list itself it is not even a navigation.
        Editor.IsOpen = true;
        Navigation.NavigateTo(string.Empty);
    }

    /// <summary>A name nothing in the file has yet.</summary>
    private string Available(string wanted)
    {
        if (_session?.File?.Find(wanted) is null)
        {
            return wanted;
        }

        for (var i = 2; ; i++)
        {
            var candidate = $"{wanted} {i}";
            if (_session.File.Find(candidate) is null)
            {
                return candidate;
            }
        }
    }

    /// <summary>
    /// Asks whether to throw away every empire, once the designer has had its say.
    /// </summary>
    /// <remarks>
    /// Two questions in a row, and both are earned: the first is about the empire being edited and
    /// can be answered by saving it, the second is about the whole file. Running them in this order
    /// matters - asking "delete everything?" and then "save your changes first?" would be asking
    /// someone to save work that is about to be deleted.
    /// </remarks>
    private async Task Reset()
    {
        if (!await Guard.ConfirmAsync())
        {
            return;
        }

        _resetting = true;
    }

    /// <summary>
    /// Puts the session back to a first visit.
    /// </summary>
    /// <remarks>
    /// The same call the app makes when it finds nothing kept from a previous visit, which is what
    /// makes this a genuine start over rather than an emptied file: the imported name goes with it,
    /// so the next export suggests the game's own filename again. Nothing is written here - the
    /// host mirrors the empty file to browser storage on its own, and the player's real file is
    /// only ever reached through Export.
    /// </remarks>
    private async Task ClearEverything()
    {
        _resetting = false;
        _message = null;

        // The file at the provider is let go of first. Reset means the app as it was on a first
        // visit, and there is no first visit that is connected to anything - staying would leave
        // Save pointed at a file holding empires the list no longer shows, which is the most
        // confusing of the three states this could end in.
        if (_cloud is { Connected: true })
        {
            await _cloud.DisconnectAsync();
        }

        _session!.StartEmptyFile();

        // Back to the list, with nothing open over it. The editor would otherwise be left holding
        // an empire that no longer exists, and StartEmptyFile has already cleared the unsaved flag,
        // so nothing asks again on the way out.
        Editor.IsOpen = false;
        Navigation.NavigateTo(string.Empty);
    }

    /// <summary>Hands the file over: a save dialog where there is one, a download where there is not.</summary>
    /// <remarks>
    /// Only a file the player named settles the work. The other three outcomes all leave it
    /// outstanding and are told apart because they want different things said: a dismissed dialog
    /// wants nothing said at all, and a download wants explaining, since the file has landed
    /// somewhere the game will never look.
    /// </remarks>
    private async Task Export()
    {
        _saving = false;

        var name = _session!.FileName is { Length: > 0 } existing ? existing : EmpireDesignsFile.FileName;

        try
        {
            switch (await Files.SaveAsync(name, _session.Save(), _backUp))
            {
                case SaveOutcome.Saved:
                    // Kept before it is called saved. The file the player named is not the copy this
                    // app restores from - in a browser that is local storage - and marking the work
                    // saved without writing it there disabled the Save button, stopped the warning on
                    // the way out, and lost the edit on the next reload.
                    if (await Host.RememberAsync() is { } problem)
                    {
                        _message = (problem, true);
                        break;
                    }

                    _message = null;
                    _session.MarkSaved();
                    break;

                // They closed the dialog. They know what they did, and nothing was written or handed
                // over, so there is nothing to report.
                case SaveOutcome.Cancelled:
                    break;

                // Nothing to say. A browser with no save dialog downloads instead, and on a phone
                // that is every save - so the sentence explaining it was not news after the first
                // time, it was a notice to dismiss on the way out of every save. The browser
                // already says a file arrived, and where it went is the browser's business rather
                // than this app's.
                case SaveOutcome.Downloaded:
                    _message = null;
                    break;

                // Two quite different things, told apart by whether this host writes the file
                // itself. A browser that would not open its save dialog has still handed the work
                // over, so there is a file and the sentence says where it went. A host that writes
                // in place has not: nothing was downloaded and nothing was written, and telling
                // somebody their file had arrived would be a plain untruth about work still at
                // risk - which is why the second of these is a problem and the first is not.
                case SaveOutcome.Refused:
                    _message = Files.SavesInPlace
                        ? ($"{name} could not be written, and nothing was downloaded instead. "
                            + "Your empires are still here - export them to a file to be sure of them.", true)
                        : ($"This browser would not open a save dialog, so {name} was downloaded "
                            + "instead. Move it into your Stellaris folder for the game to find it.", false);
                    break;

                // The one failure with a button behind it, so it says which button. Worded as the
                // sync says it, because they are the same event reached two ways and somebody who
                // meets both should not have to work out that they mean the same thing.
                case SaveOutcome.SignedOut:
                    _message = ("Your cloud sign-in has ended, so nothing was written. "
                        + "Connect again to carry on saving there.", true);
                    break;

                // Not a failure to save: the file moved on since it was read, and writing would
                // have gone over the top of whatever arrived. Nothing was lost here - the work is
                // still in hand, and still unsaved, which is why this says so rather than clearing.
                case SaveOutcome.Conflicted:
                    _message = ($"{name} changed somewhere else while you were editing, so nothing "
                        + "was written over it. Reload it to see what arrived.", true);
                    break;

                // An outcome this was not written for, which is a mistake in this app rather than
                // anything the player did. It is here because the alternative is silence: a switch
                // statement over an enum is not checked for exhaustiveness, so a new member added
                // later would fall straight through - no message, the work still marked unsaved,
                // and nothing anywhere to say why. Better to say something imperfect out loud.
                default:
                    _message = ($"{name} was not saved, and this app does not know why. "
                        + "Export it to a file to be sure of it.", true);
                    break;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            // The desktop throws where a browser returns a value: no designs folder to write to, or a
            // file something else is holding. This was the one save path with no guard, so those
            // reached the error bar as an unhandled failure instead of the sentence written for them.
            _message = ($"Your empires could not be saved: {ex.Message}", true);
        }
    }
}
