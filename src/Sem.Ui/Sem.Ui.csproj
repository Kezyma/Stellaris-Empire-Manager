<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!--
    The frozen table a v2 share link encodes against. Carried in the assembly rather than fetched
    with the game data, because it must not change when the game data is re-extracted: a link
    stores a position in these lists, so the lists have to outlive the database they came from.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Services\LinkDictionary.v2.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <!--
    Sem.Clausewitz is referenced directly, not only through Sem.Designs: the share-link codecs and
    the file-open paths catch CwSyntaxException by name. It used to arrive transitively, which
    compiled but meant Sem.Ui would break the day Sem.Designs stopped needing the parser.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sem.Clausewitz\Sem.Clausewitz.csproj" />
    <ProjectReference Include="..\Sem.Designs\Sem.Designs.csproj" />
    <ProjectReference Include="..\Sem.GameData\Sem.GameData.csproj" />
    <ProjectReference Include="..\Sem.Rules\Sem.Rules.csproj" />
  </ItemGroup>

</Project>
