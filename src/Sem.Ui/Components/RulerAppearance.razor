@inject IGameDataSource Source

@*
    The ruler's likeness, and the four things about it a design can hold.

    The game's leader editor offers six spinners and four of them are here. Phenotype picks which
    likeness of the portrait's group is worn; the rest are numbers into lists the portrait offers.

    Of the two that are not: Evolution Variant is not a value of its own — every tied texture in the
    three files that use them names exactly one variant, in file order, so the variant index is the
    texture index, which the colour control already writes. Evolution Stage is not stored at all; the
    note where its control would be says how that was established.
*@

<div class="sem-appearance">
    @*
        The likeness itself is drawn by RulerFigure, which the lite card's ruler panel draws too.
        Where a host publishes no wardrobe - the desktop builds its cache without one - it falls
        back to the portrait's own flat picture, and the controls that need the pieces are left out
        below rather than shown doing nothing.
    *@
    <div class="figure">
        <RulerFigure @ref="_figure" />
    </div>

    <div class="controls">
        @if (Members.Count > 1)
        {
            <Stepper Label="@Session.Localizer.Label("LEADER_SUB_PORTRAIT", "Phenotype")"
                     Value="@PhenotypeIndex" Count="@Members.Count"
                     Caption="@PhenotypeName"
                     OnChange="ChoosePhenotype" />
        }

        @*
            A control is shown only where there is something to choose between. On a host that
            publishes no wardrobe the portrait still knows how many skins it has, so the colour
            variant survives and the other two are absent rather than present and inert.
        *@
        @if (Count(PortraitSlot.Character) > 0)
        {
            <Stepper Label="@Session.Localizer.Label("VARIATION", "Color Variant")"
                     Value="@(Design.Ruler.Texture ?? 0)" Count="@Count(PortraitSlot.Character)"
                     OnChange="value => Session.Edit(d => d.Ruler.Texture = value)" />
        }

        @if (Count(PortraitSlot.Clothes) > 0)
        {
            <Stepper Label="@Session.Localizer.Label("CLOTHES", "Clothes")"
                     Value="@(Design.Ruler.Clothes ?? 0)" Count="@Count(PortraitSlot.Clothes)"
                     OnChange="value => Session.Edit(d => d.Ruler.Clothes = value)" />
        }

        @if (Count(PortraitSlot.Attachment) > 0)
        {
            <Stepper Label="@AttachmentLabel"
                     Value="@(Design.Ruler.Attachment ?? 0)" Count="@Count(PortraitSlot.Attachment)"
                     OnChange="value => Session.Edit(d => d.Ruler.Attachment = value)" />
        }

        @*
            No line saying the wardrobe is missing. Every control above it is drawn from a count that
            is zero without one, so there is nothing on the panel to explain: what a design already
            holds is still written back either way.
        *@

        @*
            No evolution stage control, and the reason is worth writing down so nobody adds one back.

            The game's editor has the spinner, but it does not persist: setting it and saving leaves
            evolution_mask at zero, which is what all sixty-eight designs to hand hold — the fifty-two
            the game ships, and sixteen of the player's own including one deliberately set to stage
            three. Nothing under common/ reads the field either.

            What the spinner does is preview. Each stage in a portrait_evolution block carries a
            trigger — has_cybernetization_stage_1, has_become_psionic, has_biogenesis_evolution_stage_1
            — and the game evaluates those against the leader at the time of drawing. The form is
            derived, never stored, so there is nothing here for a design to record.

            The extraction and the blending stay: the ascended skins are baked and PortraitFigure
            draws whichever one it is handed, so a preview control is a small thing to add the day
            it is wanted. What is gone is writing a number into the player's file that the game will
            never write and never read.
        *@
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    /// <summary>
    /// The figure being drawn, asked only what pieces it found.
    /// </summary>
    /// <remarks>
    /// The controls below have to know how many choices each slot offers, and only the wardrobe
    /// says - so the fetch belongs to whoever draws the picture, and this reads the answer off it
    /// rather than fetching a second copy.
    /// </remarks>
    private RulerFigure? _figure;

    private PortraitOutfit? Outfit => _figure?.Outfit;

    /// <summary>
    /// The likeness actually worn, which for a group is one of its members.
    /// </summary>
    /// <remarks>
    /// A design stores the group — the game's own United Nations of Earth records
    /// <c>portrait = "human"</c> — and the group picks a face by gender. The wardrobe is keyed by
    /// the face rather than the group, so it is the face that has to be looked up.
    /// </remarks>
    private string? Likeness => PortraitArtwork.Resolve(
        Session.Data.Database, Design.Ruler.Portrait, Design.Ruler.Gender);

    private PortraitDefinition? Portrait => Session.Data.Database.Portraits
        .FirstOrDefault(p => p.Key == Design.Ruler.Portrait);

    /// <summary>
    /// The group the worn likeness belongs to, whether the design named the group or the face.
    /// </summary>
    /// <remarks>
    /// A design may hold either. The game's own empires hold the group and let gender decide; one
    /// saved after a player used the appearance controls holds the face — <c>human_female_05</c> —
    /// and the shelf it came off is the group that lists it.
    /// </remarks>
    private PortraitDefinition? Group => Portrait is { IsGroup: true }
        ? Portrait
        : Session.Data.Database.Portraits.FirstOrDefault(p =>
            p.IsGroup && p.Phenotypes.Values.Any(faces => faces.Contains(Design.Ruler.Portrait!)));

    /// <summary>
    /// What this portrait calls the thing on its head.
    /// </summary>
    /// <remarks>
    /// The game lets a portrait rename the control, and forty-six do: a human's is a hairstyle, a
    /// reptilian's a hat, and three wear masks. One that renames nothing keeps the general word.
    /// </remarks>
    private string AttachmentLabel => Session.Localizer.Label(
        Portrait?.AttachmentLabelKey ?? "ATTACHMENTS",
        Portrait?.AttachmentLabelKey is null ? "Attachments" : "Attachment");

    /// <summary>
    /// The faces the phenotype control steps through, which are the group's for this gender.
    /// </summary>
    /// <remarks>
    /// Gender-dependent because the game's are: the human group lists five male faces and five
    /// female ones, and its editor offers whichever run matches the ruler. A ruler of no stated
    /// gender is offered everything the group has.
    /// </remarks>
    private IReadOnlyList<string> Members
    {
        get
        {
            if (Group is not { } group)
            {
                return [];
            }

            return group.PhenotypesFor(Design.Ruler.Gender) is { Count: > 0 } forGender
                ? forGender
                : [.. group.Phenotypes.Values.SelectMany(f => f).Distinct(StringComparer.Ordinal)];
        }
    }

    private int PhenotypeIndex => Likeness is { } face
        ? Math.Max(0, Members.ToList().IndexOf(face))
        : 0;

    private string? PhenotypeName => Members.Count > PhenotypeIndex
        ? Localizer.Prettify(Members[PhenotypeIndex])
        : null;

    /// <summary>
    /// Drawn a second time once the figure has its pieces.
    /// </summary>
    /// <remarks>
    /// The counts under the picture come from the wardrobe, which the figure fetches after its
    /// first render. Without this the steppers would render against no wardrobe and stay that way.
    /// </remarks>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender || Outfit is null != _drawnWithout)
        {
            _drawnWithout = Outfit is null;
            StateHasChanged();
        }
    }

    private bool _drawnWithout = true;

    /// <summary>
    /// How many choices a slot offers.
    /// </summary>
    /// <remarks>
    /// From the wardrobe where there is one. Failing that the portrait's own count of body textures
    /// still stands, so the colour variant works on a host with no wardrobe published; the other two
    /// have nothing to count and offer nothing.
    /// </remarks>
    private int Count(PortraitSlot slot) => Outfit?.CountFor(slot)
        ?? (slot == PortraitSlot.Character ? Portrait?.TextureCount ?? 0 : 0);

    /// <summary>
    /// Wears a different face of the group.
    /// </summary>
    /// <remarks>
    /// Writes the face rather than the group, which is what a player choosing one means. A design
    /// that held the group and let gender decide keeps doing so until this is touched.
    /// </remarks>
    private void ChoosePhenotype(int index)
    {
        if (index >= 0 && index < Members.Count)
        {
            Session.Edit(d => d.Ruler.Portrait = Members[index]);
        }
    }
}
