@using Microsoft.JSInterop
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    The empires in the loaded file, with whichever ones the game would refuse marked as such.
*@

<CascadingValue Value="Session">
    @if (Session.File is null)
    {
        <div class="sem-empty">
            <p>No file open.</p>
        </div>
    }
    else if (Session.File.Designs.Count == 0)
    {
        <div class="sem-empty">
            <p>This file has no empires in it yet.</p>
        </div>
    }
    else
    {
        @*
            Reordering is driven by pointer events rather than by HTML5 drag and drop, and the grip
            is the reason: dragging is the only way to reorder now, and HTML5 dragging does nothing
            whatever on a touch screen. One pointer path covers a mouse, a finger and a pen, and the
            arrow keys on the grip cover anyone who has none of them.

            Which card the pointer is over is a question only the browser can answer, so the
            listening is in sem.js and it reports back the two positions.
        *@
        <div class="sem-empires" @ref="_list">
            @for (var position = 0; position < Session.File.Designs.Count; position++)
            {
                var index = position;
                var design = Session.File.Designs[index];

                @*
                    One context, used for both questions asked of each empire — what its government
                    turned out to be, and whether the game would accept it. Validating built one of
                    its own before.
                *@
                var context = Read(design);

                <div class="sem-empire-drag" data-index="@index" @key="design">
                <EmpireCard Flag="@design.Flag"
                            Portrait="@Thumbnail(design)"
                            Name="@Session.Localizer.Name(design.Name, design.Key)"
                            Government="@Government(design, context)"
                            SpeciesClass="@Session.Localizer.Text(design.Species.Class)"
                            Selected="@ReferenceEquals(design, Session.Current)"
                            Broken="@(!Session.Rules.Validate(context, design).IsValid)"
                            OnCopyLink="@(OnCopyLink.HasDelegate ? EventCallback.Factory.Create(this, () => OnCopyLink.InvokeAsync(design)) : default)"
                            CopyTitle="@(CopyTitle?.Invoke(design) ?? "Copy a link to this empire")"
                            OnMove="@(by => Move(design, index + by))"
                            OnClick="() => Choose(design)" />
                </div>
            }
        </div>
    }
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public required DesignSession Session { get; set; }

    /// <summary>Raised when an empire is chosen, so the host can move to the designer.</summary>
    [Parameter]
    public EventCallback<EmpireDesign> OnSelected { get; set; }

    /// <summary>
    /// Raised to copy a link to one empire. Where nothing is given, the cards have no share button.
    /// </summary>
    /// <remarks>
    /// Handled by the page rather than here: building the link needs the address the app is
    /// published at, and putting it on the clipboard needs the host, neither of which a list of
    /// cards has any business knowing about.
    /// </remarks>
    [Parameter]
    public EventCallback<EmpireDesign> OnCopyLink { get; set; }

    /// <summary>
    /// What each card's share button should say, which the page varies to report the last press.
    /// </summary>
    [Parameter]
    public Func<EmpireDesign, string>? CopyTitle { get; set; }

    protected override void OnInitialized() => Session.Changed += OnChanged;

    public void Dispose() => Session.Changed -= OnChanged;

    /// <summary>
    /// Lets go of the script and of the reference it was calling back through.
    /// </summary>
    /// <remarks>
    /// The renderer calls this one rather than the other when a component has both, so it does the
    /// unsubscribing too - as the empire list on the front page does. Disconnection is caught
    /// because a page that has already gone cannot be told anything.
    /// </remarks>
    public async ValueTask DisposeAsync()
    {
        Dispose();

        _self?.Dispose();
        _self = null;

        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // Nothing left to release.
        }

        _module = null;
    }

    private void OnChanged()
    {
        // What the rules make of an empire only changes when the empire or the packs do, and both
        // of those raise this.
        _read.Clear();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// What the rules make of one empire in the list, held until something changes.
    /// </summary>
    /// <remarks>
    /// Building a context walks every government the game defines, and this list draws one per
    /// empire on every render — while the designer beside it raises a change on every keystroke.
    /// The same fix was made for the game's fifty-two built-in empires and not for the player's own.
    /// </remarks>
    private DesignContext Read(EmpireDesign design)
    {
        if (!_read.TryGetValue(design, out var context))
        {
            context = Session.Rules.CreateContext(design, Session.OwnedDlc);
            _read[design] = context;
        }

        return context;
    }

    private readonly Dictionary<EmpireDesign, DesignContext> _read = [];

    private ElementReference _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<EmpireBrowser>? _self;

    /// <summary>
    /// Hands the list to the script that watches its grips for a drag.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Every render, and only once there is a list to hand over. The script keeps its own flag on
    /// the element, so being asked again costs one call and returns.
    /// </para>
    /// <para>
    /// The condition is the branch that draws the list, rather than the one that draws a file. A
    /// file with no empires in it yet draws neither - and an unrendered reference is not null, it
    /// is an object the script cannot use, which the script has a guard against and which used to
    /// arrive at it. Asking once was the worse half of that: a file that opened empty was the one
    /// render this ever got, so when the first empire arrived there was nobody left to ask, and
    /// dragging was gone until the page was loaded again.
    /// </para>
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session.File is not { Designs.Count: > 0 })
        {
            return;
        }

        try
        {
            // Both held rather than made again. This runs on every render now, and a fresh module
            // handle or a fresh reference to this component per render is the same leak by another
            // name - one of them disposed at the end and the rest simply dropped.
            _module ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sem.Ui/sem.js").ConfigureAwait(true);

            _self ??= DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("enableCardReorder", _list, _self).ConfigureAwait(true);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to drag.
        }
    }

    /// <summary>
    /// Called from the script when a card has been dragged from one position to another.
    /// </summary>
    /// <remarks>
    /// Positions rather than keys, because the script knows where the cards sit and nothing else
    /// about them. Checked rather than trusted: what arrives is whatever the page said.
    /// </remarks>
    [JSInvokable]
    public void Reorder(int from, int to)
    {
        if (Session.File?.Designs is not { } designs
            || from < 0 || from >= designs.Count || to < 0 || to >= designs.Count)
        {
            return;
        }

        Move(designs[from], to);
    }

    /// <summary>Moves an empire, and tells whoever is showing the list to draw it again.</summary>
    private void Move(EmpireDesign design, int toIndex)
    {
        Session.MoveEmpire(design, toIndex);
        StateHasChanged();
    }

    private async Task Choose(EmpireDesign design)
    {
        Session.Select(design);
        await OnSelected.InvokeAsync(design);
    }

    /// <summary>
    /// What the game would call this empire's government.
    /// </summary>
    /// <remarks>
    /// Derived rather than stored — the game names a government after the authority, ethics and
    /// civics an empire holds. An empire too incomplete for any government to fit falls back to its
    /// authority, so the line is never blank.
    /// </remarks>
    private string Government(EmpireDesign design, DesignContext context) =>
        Session.Rules.DeriveGovernment(context) is { } government
            ? Session.Localizer.Text(government.Key)
            : Session.Localizer.Text(design.Authority);

    /// <summary>The ruler's likeness, falling back to the species' own.</summary>
    private string? Thumbnail(EmpireDesign design) =>
        PortraitArtwork.For(Session.Data.Database, design.Ruler.Portrait, design.Ruler.Gender)
        ?? PortraitArtwork.For(Session.Data.Database, design.Species.Portrait, design.Species.Gender);
}