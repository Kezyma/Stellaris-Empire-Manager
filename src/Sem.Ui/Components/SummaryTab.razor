@*
    The whole empire in one place, with anything the game would object to.
*@

<div class="sem-columns">
    <div>
        <div class="sem-panel">
            <h3>Status</h3>

            @if (Session.Report.IsValid && Session.Report.Warnings.Count == 0)
            {
                <p class="sem-status ok">This empire is ready to play.</p>
            }

            @foreach (var problem in Session.Report.Errors)
            {
                <div class="sem-problem">
                    <div class="area">@problem.Area</div>
                    <div>@problem.Message</div>

                    @foreach (var reason in problem.Reasons.Distinct())
                    {
                        <div class="why">@Session.Localizer.Text(reason)</div>
                    }
                </div>
            }

            @foreach (var problem in Session.Report.Warnings)
            {
                <div class="sem-problem warning">
                    <div class="area">@problem.Area</div>
                    <div>@problem.Message</div>
                </div>
            }
        </div>

        <div class="sem-panel">
            <h3>Empire</h3>

            <div class="sem-field">
                <label for="empire-name">Name</label>
                <div class="sem-row" style="flex-wrap:nowrap">
                    <input id="empire-name" type="text" value="@Design.Name.Key"
                           @onchange="e => Session.Edit(d => d.Name.SetLiteral(e.Value?.ToString() ?? string.Empty))" />
                    <button type="button" title="The species adjective and a form of government"
                            @onclick="RandomiseName">Randomise</button>
                </div>
            </div>

            <div class="sem-field">
                <label for="empire-adjective">Adjective</label>
                <input id="empire-adjective" type="text" value="@Design.Adjective.Key"
                       @onchange="e => Session.Edit(d => d.Adjective.SetLiteral(e.Value?.ToString() ?? string.Empty))" />
            </div>

            <div class="sem-field">
                <label for="spawn-enabled">Appears as an AI empire</label>
                <select id="spawn-enabled" @onchange="e => Session.Edit(d => d.SpawnEnabled = e.Value?.ToString())">
                    <option value="no" selected="@(Design.SpawnEnabled != "always" && Design.SpawnEnabled != "yes")">Never</option>
                    <option value="yes" selected="@(Design.SpawnEnabled == "yes")">Sometimes</option>
                    <option value="always" selected="@(Design.SpawnEnabled == "always")">Always</option>
                </select>
            </div>
        </div>
    </div>

    <div class="sem-panel">
        <h3>At a glance</h3>

        <div class="sem-row" style="margin-bottom:12px">
            <FlagPreview Flag="@Design.Flag" Class="small" />
            <div>
                <div style="font-weight:600">@Session.Localizer.Text(Design.Name.Key, Design.Key)</div>
                <div class="sem-hint">@GovernmentName</div>
            </div>
        </div>

        <dl class="sem-summary">
            @Row("Species", Session.Localizer.Text(Design.Species.Class))
            @Row("Ethics", string.Join(", ", Design.Ethics.Select(e => Session.Localizer.Text(e))))
            @Row("Authority", Session.Localizer.Text(Design.Authority))
            @Row("Civics", string.Join(", ", Design.Civics.Select(c => Session.Localizer.Text(c))))
            @Row("Origin", Session.Localizer.Text(Design.Origin))
            @Row("Homeworld", Session.Localizer.Text(Design.PlanetClass))
            @Row("Traits", string.Join(", ", Design.Species.Traits.Select(t => Session.Localizer.Text(t))))
            @Row("Ruler", Session.Localizer.Text(Design.Ruler.Name.FullNames?.Key, "unnamed"))
        </dl>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    /// <summary>
    /// Names an empire the way the game most often does: the species adjective followed by a form of
    /// government that suits its authority.
    /// </summary>
    private void RandomiseName()
    {
        var species = Design.Species.Name.Key;

        if (Session.Names.Empire(species, Design.Authority) is not { Length: > 0 } name)
        {
            return;
        }

        Session.Edit(d =>
        {
            d.Name.SetLiteral(name);
            d.Adjective.SetLiteral(NameGenerator.Adjective(species));
        });
    }

    private string GovernmentName =>
        Session.Rules.DeriveGovernment(Session.Context!) is { } government
            ? Session.Localizer.Text(government.Key)
            : "No government";

    private RenderFragment Row(string label, string? value) => builder =>
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.OpenElement(0, "dt");
        builder.AddContent(1, label);
        builder.CloseElement();

        builder.OpenElement(2, "dd");
        builder.AddContent(3, value);
        builder.CloseElement();
    };
}
