@*
    One of the game's icons, with a placeholder for the many entities that have none.
    A missing icon is normal rather than an error, so it takes the same space and stays quiet.
*@

@*
    No size parameter. There was one, offering "small" and "large", and nothing ever passed either —
    so its only effect was that the placeholder had three sizes while the image it stands in for had
    one, and "large" had no rule in the stylesheet at all. An icon is the size the stylesheet says,
    which is now one number in one place.
*@
@if (!string.IsNullOrEmpty(Path))
{
    <img class="sem-icon" src="@Session.Data.AssetUrl(Path)" alt="@Alt" loading="lazy" />
}
else
{
    <span class="sem-icon sem-icon-placeholder" aria-hidden="true"></span>
}

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>Where the icon lives in the extracted assets, as the database records it.</summary>
    [Parameter]
    public string? Path { get; set; }

    /// <summary>Alternative text, normally the thing's display name.</summary>
    [Parameter]
    public string? Alt { get; set; }
}
