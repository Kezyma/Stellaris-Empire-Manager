@*
    The empire as a card you can press.

    The same facts the showcase reads out, arranged by what opens them: press the flag and the flag
    picker opens, press the room and the room picker opens, press a trait and the trait picker opens.
    Everything derived comes from the shared EmpireView, so this and the showcase cannot drift about
    what an empire is - only about how it is laid out, which is the whole point of there being two.

    The empire's name is the exception and is edited here rather than in a dialog: a name is a few
    characters and opening a window to type them would be the heaviest possible way to do the lightest
    thing on the card.

    What is *not* here is anything that only governs. Portrait duplication rides in the portrait
    dialog, the spawn settings ride with the empire, the special flags ride with the empire. The card
    shows what an empire looks like; the dialogs carry what it does.
*@

@using Sem.Rules

<div class="sem-lite">

    @*
        The scene: the room, the world through its window, the city on it and the ruler in front. It
        is the largest thing on the card and it stands for the largest group of choices, so it opens
        the room and city picker.
    *@
    <button type="button" class="sem-lite-scene" title="Room and city"
            aria-label="Edit the room and city" @onclick="() => Open(LitePart.Room)">
        <RoomScene Room="View.Room" World="View.World" City="View.City" Portrait="@View.RulerPortrait"
                   Flag="@Design.Flag" Alt="@Session.Localizer.Name(Design.Species.Name, string.Empty)" />
        <span class="sem-lite-hint" aria-hidden="true"><ActionIcon Name="edit-pencil" /></span>
    </button>

    <div class="sem-lite-identity">
        <button type="button" class="sem-lite-flag" title="Flag"
                aria-label="Edit the flag" @onclick="() => Open(LitePart.Flag)">
            <FlagPreview Flag="@Design.Flag" Class="medium" />
        </button>

        <div class="sem-lite-titles">
            @*
                Click the name and it becomes a field; click away and it commits. Refused when the
                name is another empire's, which the session decides so that this and the empire
                section cannot disagree about what a duplicate is.
            *@
            @if (_naming)
            {
                <input type="text" class="sem-lite-name-field" value="@_draft" @ref="_nameField"
                       aria-label="@Session.Localizer.Label("EMPIRE_NAME", "Empire Name")"
                       @oninput="e => _draft = e.Value?.ToString() ?? string.Empty"
                       @onblur="CommitName"
                       @onkeydown="OnNameKey" />
            }
            else
            {
                <button type="button" class="sem-lite-name" title="Rename this empire"
                        @onclick="StartNaming">
                    @Session.Localizer.Name(Design.Name, Design.Key)
                </button>
            }

            @if (_clash is { } rejected)
            {
                <p class="sem-status bad">Another empire in this file already has the name @rejected.</p>
            }

            <button type="button" class="sem-lite-sub" title="Ethics, authority and civics"
                    aria-label="Edit the government" @onclick="() => Open(LitePart.Government)">
                @View.Government
            </button>

            <button type="button" class="sem-lite-sub faint" title="The ruler"
                    aria-label="Edit the ruler" @onclick="() => Open(LitePart.Ruler)">
                @(View.Ruler is { Length: > 0 } ruler ? ruler : "No ruler named")
            </button>
        </div>

        @*
            The empire's own settings - its adjective, its ship prefix, the special flags, whether it
            spawns as an AI. None of them is a thing you can see, so none of them is on the card;
            they are all behind this.
        *@
        <button type="button" class="icon sem-lite-settings" title="Empire settings"
                aria-label="Edit the empire's settings" @onclick="() => Open(LitePart.Empire)">
            <ActionIcon Name="edit" />
        </button>
    </div>

    @* The species: its face, its name, and the two things the game's own header puts beside them. *@
    <div class="sem-lite-species">
        <button type="button" class="sem-lite-face" title="Portrait"
                aria-label="Edit the species portrait" @onclick="() => Open(LitePart.Portrait)">
            @if (View.SpeciesPortrait is { Length: > 0 } face)
            {
                <img src="@Session.Data.AssetUrl(face)" alt="" loading="lazy">
            }
            else
            {
                <span class="sem-lite-noface" aria-hidden="true"></span>
            }
        </button>

        <div class="sem-lite-about">
            <button type="button" class="sem-lite-species-name" title="Edit the species"
                    @onclick="() => Open(LitePart.Species)">
                <span class="name">@Session.Localizer.Name(Design.Species.Name, Design.Species.Class)</span>
                <span class="kind">@Session.Localizer.Text(Design.Species.Class)</span>
            </button>
        </div>
    </div>

    @*
        Everything the game states as a list of options, in rows. The authority and the origin are
        one-item rows rather than something of their own: they are the same kind of thing as an
        ethic or a civic, they carry the same chip, and giving them a different shape would say
        they were a different kind of choice.
    *@
    @Chips(Session.Localizer.Heading("ORIGIN", "Origin"), One(Design.Origin, View.Origin?.Icon, View.Origin?.Effects), LitePart.Origin)
    @Chips(Session.Localizer.Heading("ETHICS", "Ethics"), View.Ethics, LitePart.Government)
    @Chips(Session.Localizer.Heading("GOVERNMENT_AUTHORITY_AND_TYPE", "Authority"), One(Design.Authority, View.Authority?.Icon, View.Authority?.Effects), LitePart.Government)
    @Chips(Session.Localizer.Heading("CIVICS_LABEL", "Civics"), View.Civics, LitePart.Government)
    @Chips(Session.Localizer.Heading("TRAITS", "Traits"), View.Traits, LitePart.Traits)

    @if (Design.SecondarySpecies is { } second)
    {
        @Chips(View.SecondName(second), View.TraitsOf(second), LitePart.SecondSpecies)
    }

    @*
        The rest, as tiles rather than a list of words. Everything with artwork shows it - the world,
        the ships, the city, the advisor's badge, the arkship a nomad flies - and the four things the
        game has no picture for stay as text, because inventing one would be worse than not having it.
    *@
    <div class="sem-lite-tiles">
        @Tile(Session.Localizer.Heading("HOMEWORLD_CLASS_LABEL", "Homeworld"), View.Homeworld,
              View.World?.Icon, LitePart.Homeworld)

        @if (Design.IsNomadic == true)
        {
            @Tile(Session.Localizer.Heading("arkship_cap", "Arkship"),
                  View.Arkship is { } ark ? Session.Localizer.Text(ark.NameKey, Localizer.Prettify(ark.Key)) : null,
                  View.Arkship?.Preview ?? View.Arkship?.Icon, LitePart.Homeworld)
        }

        @Tile(Session.Localizer.Heading("SHIPSETS_LABEL", "Shipset"), View.CultureName(Design.GraphicalCulture),
              View.Shipset?.ShipPreview, LitePart.Shipset)

        @Tile(Session.Localizer.Heading("EMPIRE_CREATION_CITY_APPEARANCE", "City"),
              View.CultureName(Design.CityGraphicalCulture), View.City?.CityPreview, LitePart.Room)

        @Tile(Session.Localizer.Heading("EMPIRE_ADVISOR", "Advisor"),
              Design.AdvisorVoiceType is { Length: > 0 }
                  ? Session.Localizer.Text(Design.AdvisorVoiceType)
                  : "Automatic",
              View.Advisor?.Icon, LitePart.Advisor)

        @* No artwork exists for any of these, so they are words on purpose. *@
        @Tile(Session.Localizer.Heading("NAME_LIST", "Name List"),
              Session.Localizer.Text(Design.Species.NameList), null, LitePart.Species)

        @Tile(Session.Localizer.Heading("SELECT_SYSTEM_INITIALIZER_LABEL", "Starting System"),
              View.StartingSystem, null, LitePart.Homeworld)
    </div>

    <CombinedEffects Context="@View.Context" Baseline="@Baseline" />
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The empire being edited.</summary>
    [Parameter, EditorRequired]
    public required EmpireDesign Design { get; set; }

    /// <summary>Raised with the part whose editor should open.</summary>
    [Parameter]
    public EventCallback<LitePart> OnEdit { get; set; }

    /// <summary>The empire as it was last saved, for the totals to compare against.</summary>
    [Parameter]
    public DesignContext? Baseline { get; set; }

    private EmpireView View => _view ??= new EmpireView(Session, Design);

    private EmpireView? _view;

    /// <summary>Whether the name is being typed rather than shown.</summary>
    private bool _naming;

    private string _draft = string.Empty;

    private string? _clash;

    private ElementReference _nameField;

    /// <summary>Whether the field still needs the keyboard, which it does only just after opening.</summary>
    private bool _focusName;

    protected override void OnParametersSet() => _view = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusName)
        {
            _focusName = false;
            await _nameField.FocusAsync();
        }
    }

    private void StartNaming()
    {
        _draft = Session.Localizer.Name(Design.Name, Design.Key);
        _naming = true;
        _focusName = true;
        _clash = null;
    }

    /// <summary>
    /// Escape puts the name back; Enter commits it, which is what leaving the field does anyway.
    /// </summary>
    private void OnNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _naming = false;
            _clash = null;
        }
        else if (e.Key == "Enter")
        {
            CommitName();
        }
    }

    private void CommitName()
    {
        var wanted = _draft.Trim();

        // An unchanged name is not an edit, and neither is an emptied one - the field closes and the
        // design keeps the name it had.
        if (wanted.Length == 0 || wanted == Session.Localizer.Name(Design.Name, Design.Key))
        {
            _naming = false;
            _clash = null;
            return;
        }

        if (Session.TryRename(wanted))
        {
            _naming = false;
            _clash = null;
            _view = null;
            return;
        }

        // Taken. The field stays open holding what was typed, so it can be changed rather than
        // retyped, and the reason is said underneath.
        _clash = wanted;
    }

    private Task Open(LitePart part) => OnEdit.InvokeAsync(part);

    /// <summary>The authority and the origin as chip rows, since a row is what they are shown as.</summary>
    private static IEnumerable<EmpireChoice> One(string? key, string? icon, EffectSet? effects) =>
        key is { Length: > 0 } ? [new EmpireChoice(key, icon, effects)] : [];

    /// <summary>A labelled row of chips, the label opening the editor those chips came from.</summary>
    /// <remarks>
    /// The label is the button and the chips are not. A chip is already one: it carries the popover
    /// that says what the option does, and a button inside a button is both invalid HTML and
    /// unusable - a single press would open the description and the dialog at once, so the thing
    /// that explains an ethic and the thing that changes it would be the same click. The row
    /// therefore explains itself where you press a chip, and edits where you press its name.
    /// </remarks>
    private RenderFragment Chips(string label, IEnumerable<EmpireChoice> items, LitePart part)
    {
        // Once. Each of these costs a lookup in the database, and the row asks twice below.
        var listed = items.ToList();

        return @<div class="sem-lite-chips">
            <button type="button" class="heading" title="@($"Edit {label}")"
                    @onclick="() => Open(part)">@label</button>

            @if (listed.Count == 0)
            {
                // Said rather than left blank. An empty row on a card you can press is an
                // invitation; an empty row on one you cannot is a fault, which is why the showcase
                // omits it and this does not.
                <span class="sem-lite-empty">none chosen</span>
            }

            @foreach (var choice in listed)
            {
                <OptionChip @key="choice.Key" Key="@choice.Key"
                            Name="@Session.Localizer.Text(choice.Key)"
                            Icon="@choice.Icon" Effects="@choice.Effects" />
            }
        </div>;
    }

    /// <summary>One of the remaining choices, with its artwork where the game has any.</summary>
    private RenderFragment Tile(string label, string? value, string? image, LitePart part) =>
        @<button type="button" class="sem-lite-tile" title="@($"Edit {label}")"
                 @onclick="() => Open(part)">
            @if (image is { Length: > 0 })
            {
                <img class="art" src="@Session.Data.AssetUrl(image)" alt="" loading="lazy">
            }

            <span class="label">@label</span>
            <span class="value">@(value is { Length: > 0 } ? value : "not set")</span>
        </button>;
}
