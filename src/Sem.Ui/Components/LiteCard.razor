@*
    The empire as a card you can press.

    Grouped the way an empire is thought about rather than the way it is stored: the picture, then
    who the empire is, then how it is governed, then its species, its ruler, and where in the galaxy
    it starts. Every group is a block of the same shape the showcase already draws its species in,
    so the card reads as one thing rather than as a list of unrelated rows.

    Pressing anything opens the editor for that one thing and nothing else. Pressing the ethics opens
    the ethics, not the authority beside them; pressing a chip does what pressing its row's name
    does, which is what a chip looks like it should do.

    Everything derived comes from the shared EmpireView, so this and the showcase cannot drift about
    what an empire is - only about how it is laid out, which is the whole point of there being two.
*@

@using Sem.Rules

<div class="sem-lite">
    <div class="sem-lite-main">

        @*
            The scene: the room, the world through its window, the city on it and the ruler in front.
            It is the largest thing on the card and it stands for the largest group of choices, so it
            opens the room and city picker.
        *@
        <button type="button" class="sem-lite-scene" title="Room and city"
                aria-label="Edit the room and city" @onclick="() => Open(LitePart.Room)">
            <RoomScene Room="View.Room" World="View.World" City="View.City" Portrait="@View.RulerPortrait"
                       Flag="@Design.Flag" Alt="@Session.Localizer.Name(Design.Species.Name, string.Empty)" />
            <span class="sem-lite-hint" aria-hidden="true"><ActionIcon Name="edit-pencil" /></span>
        </button>

        @* ----------------------------------------------------------------- the empire *@
        <div class="sem-block">
            <button type="button" class="face-button" title="Edit the flag"
                    @onclick="() => Open(LitePart.Flag)">
                <FlagPreview Flag="@Design.Flag" Class="medium" />
            </button>

            <div class="about">
                <button type="button" class="name-button" title="Edit the empire's name"
                        @onclick="() => Open(LitePart.Naming)">
                    <span class="name">@Session.Localizer.Name(Design.Name, Design.Key)</span>

                    @*
                        Bracketed and in italics beside the name, because it is the same name in
                        another form rather than a second fact about the empire.
                    *@
                    @if (View.Adjective is { Length: > 0 } adjective)
                    {
                        <span class="aside">(@adjective)</span>
                    }
                </button>

                @*
                    The scripted country flags. Nothing to do with the flag beside them, which is why
                    they are named in full and kept at this end of the block - see docs/empire-flags.md,
                    written because the two were confusable enough to need it.
                *@
                <div class="sem-lite-field">
                    <span class="label">Special empire flags</span>

                    @if (_flagging)
                    {
                        <EmpireFlagSets OnChosen="() => _flagging = false" />
                    }
                    else
                    {
                        <button type="button" class="value" title="Choose a set of scripted country flags"
                                @onclick="() => _flagging = true">
                            @(View.FlagSetLabel ?? "None")
                        </button>
                    }
                </div>

                <SpawnToggle />
            </div>
        </div>

        @* ----------------------------------------------------------------- how it is governed *@
        <div class="sem-block wide">
            <div class="about">
                @*
                    The name the game works out from all three rows under it. Pressing it opens all
                    three together, which is the one view that shows a gestalt closing off half the
                    civics as it is chosen.
                *@
                <button type="button" class="name-button" title="Edit ethics, authority and civics together"
                        @onclick="() => Open(LitePart.Government)">
                    <span class="name">@View.Government</span>

                    @if (!View.HasGovernment)
                    {
                        <span class="aside bad">no government matches these</span>
                    }
                </button>

                <div class="sem-lite-choices">
                    @Chips(Session.Localizer.Heading("ETHICS", "Ethics"), View.Ethics, LitePart.Ethics)
                    @Chips(Session.Localizer.Heading("GOVERNMENT_AUTHORITY_AND_TYPE", "Authority"),
                           View.AuthorityChoice, LitePart.Authority)
                    @Chips(Session.Localizer.Heading("CIVICS_LABEL", "Civics"), View.Civics, LitePart.Civics)
                </div>
            </div>
        </div>

        @* ----------------------------------------------------------------- the founder species *@
        <div class="sem-block wide">
            <button type="button" class="face-button" title="Edit the species portrait"
                    @onclick="() => Open(LitePart.Portrait)">
                @if (View.SpeciesPortrait is { Length: > 0 } speciesFace)
                {
                    <img class="face" src="@Session.Data.AssetUrl(speciesFace)" alt="" loading="lazy">
                }
                else
                {
                    <span class="face noface" aria-hidden="true"></span>
                }
            </button>

            <div class="about">
                <button type="button" class="name-button" title="Edit the species' names"
                        @onclick="() => Open(LitePart.Species)">
                    <span class="name">@Session.Localizer.Name(Design.Species.Name, Design.Species.Class)</span>
                    <span class="kind">@Session.Localizer.Text(Design.Species.Class)</span>
                </button>

                <GenderPicker Value="@Design.Species.Gender"
                              OnChange="key => Session.Edit(_ => Design.Species.Gender = key)" />

                <div class="sem-lite-choices">
                    @Chips(Session.Localizer.Heading("TRAITS", "Traits"), View.Traits, LitePart.Traits)
                    @Row(Session.Localizer.Heading("NAME_LIST", "Name List"),
                         Session.Localizer.Text(Design.Species.NameList), LitePart.Species)
                </div>
            </div>
        </div>

        @* ----------------------------------------------------------------- the ruler *@
        <div class="sem-block wide">
            <button type="button" class="face-button" title="Edit the ruler's appearance"
                    @onclick="() => Open(LitePart.RulerAppearance)">
                @if (View.RulerPortrait is { Length: > 0 } rulerFace)
                {
                    <img class="face" src="@Session.Data.AssetUrl(rulerFace)" alt="" loading="lazy">
                }
                else
                {
                    <span class="face noface" aria-hidden="true"></span>
                }
            </button>

            <div class="about">
                <button type="button" class="name-button" title="Edit the ruler's name and titles"
                        @onclick="() => Open(LitePart.Ruler)">
                    <span class="name">
                        @(View.RulerName is { Length: > 0 } named ? named : "No ruler named")
                    </span>

                    @if (View.RulerTitle is { Length: > 0 } title)
                    {
                        <span class="kind">@title</span>
                    }
                </button>

                <div class="sem-lite-pickers">
                    <GenderPicker Value="@Design.Ruler.Gender"
                                  OnChange="key => Session.Edit(d => d.Ruler.Gender = key)" />
                    <RulerClassPicker />
                </div>

                <div class="sem-lite-choices">
                    @Chips(Session.Localizer.Heading("TRAITS", "Traits"), View.RulerTraits, LitePart.RulerTraits)
                </div>
            </div>
        </div>

        @* ----------------------------------------------------------------- a second species *@
        @if (Design.SecondarySpecies is { } second)
        {
            <div class="sem-block wide">
                <button type="button" class="face-button" title="Edit the second species"
                        @onclick="() => Open(LitePart.SecondSpecies)">
                    @if (PortraitArtwork.For(Session.Data.Database, second.Portrait, second.Gender) is { Length: > 0 } secondFace)
                    {
                        <img class="face" src="@Session.Data.AssetUrl(secondFace)" alt="" loading="lazy">
                    }
                    else
                    {
                        <span class="face noface" aria-hidden="true"></span>
                    }
                </button>

                <div class="about">
                    <button type="button" class="name-button" title="Edit the second species"
                            @onclick="() => Open(LitePart.SecondSpecies)">
                        <span class="name">@Session.Localizer.Name(second.Name, second.Class)</span>
                        <span class="kind">Second species · @Session.Localizer.Text(second.Class)</span>
                    </button>

                    <div class="sem-lite-choices">
                        @Chips(Session.Localizer.Heading("TRAITS", "Traits"),
                               View.TraitsOf(second), LitePart.SecondSpecies)
                    </div>
                </div>
            </div>
        }

        @* ----------------------------------------------------------------- where it starts *@
        <div class="sem-block wide">
            <div class="about">
                <div class="sem-lite-choices">
                    @Chips(Session.Localizer.Heading("ORIGIN", "Origin"), View.OriginChoice, LitePart.Origin)
                    @Chips(Session.Localizer.Heading("EMPIRE_ADVISOR", "Advisor Voice"),
                           View.AdvisorChoice, LitePart.Advisor, empty: "Automatic")
                    @Row(Session.Localizer.Heading("SELECT_SYSTEM_INITIALIZER_LABEL", "Starting System"),
                         View.StartingSystem, LitePart.Homeworld)
                </div>

                @*
                    The rest as tiles, because these are the three the game has real artwork for. The
                    others were tiles with an empty picture box where a planet should be, which is
                    what made the grid look broken.
                *@
                <div class="sem-lite-tiles">
                    @Tile(Session.Localizer.Heading("HOMEWORLD_CLASS_LABEL", "Homeworld"), View.Homeworld,
                          View.World?.Icon, LitePart.Homeworld)

                    @if (Design.IsNomadic == true)
                    {
                        @Tile(Session.Localizer.Heading("arkship_cap", "Arkship"),
                              View.Arkship is { } ark ? Session.Localizer.Text(ark.NameKey, Localizer.Prettify(ark.Key)) : null,
                              View.Arkship?.Preview ?? View.Arkship?.Icon, LitePart.Homeworld)
                    }

                    @Tile(Session.Localizer.Heading("SHIPSETS_LABEL", "Shipset"), View.CultureName(Design.GraphicalCulture),
                          View.Shipset?.ShipPreview, LitePart.Shipset)
                </div>
            </div>
        </div>
    </div>

    @*
        What the empire adds up to, and what is wrong with it, following the page as the designer's
        own pane does. The problems had no home in this editor at all - the sections put a count on
        every header and the showcase beside them carried the messages, and a lite user got neither.
    *@
    <div class="sem-lite-totals">
        <ProblemsPanel Report="@View.Report" />
        <CombinedEffects Context="@View.Context" Baseline="@Baseline" />
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The empire being edited.</summary>
    [Parameter, EditorRequired]
    public required EmpireDesign Design { get; set; }

    /// <summary>Raised with the part whose editor should open.</summary>
    [Parameter]
    public EventCallback<LitePart> OnEdit { get; set; }

    /// <summary>The empire as it was last saved, for the totals to compare against.</summary>
    [Parameter]
    public DesignContext? Baseline { get; set; }

    private EmpireView View => _view ??= new EmpireView(Session, Design);

    private EmpireView? _view;

    /// <summary>Whether the flag-set box is showing in place of the value it holds.</summary>
    private bool _flagging;

    protected override void OnParametersSet() => _view = null;

    private Task Open(LitePart part) => OnEdit.InvokeAsync(part);

    /// <summary>
    /// A labelled row of chips, where the label and every chip open the same editor.
    /// </summary>
    /// <remarks>
    /// The chips are siblings of the label rather than inside it. A chip is already a button, and a
    /// button within a button is both invalid and unusable; as siblings they can each carry the
    /// press without nesting. OptionChip gives up its own click when it is given something to open,
    /// so a chip still describes itself on hover but no longer does two things at once.
    /// </remarks>
    private RenderFragment Chips(string label, IEnumerable<EmpireChoice> items, LitePart part,
                                 string empty = "none chosen")
    {
        // Once. Each of these costs a lookup in the database, and the row asks twice below.
        var listed = items.ToList();

        return @<div class="sem-lite-chips">
            <button type="button" class="heading" title="@($"Edit {label}")"
                    @onclick="() => Open(part)">@label</button>

            <div class="chips">
                @if (listed.Count == 0)
                {
                    <button type="button" class="sem-lite-empty" title="@($"Edit {label}")"
                            @onclick="() => Open(part)">@empty</button>
                }

                @foreach (var choice in listed)
                {
                    <OptionChip @key="choice.Key" Key="@choice.Key" Name="@choice.Name"
                                Icon="@choice.Icon" Effects="@choice.Effects"
                                OnSelect="() => Open(part)" />
                }
            </div>
        </div>;
    }

    /// <summary>One fact the game has no picture for, as a labelled line.</summary>
    private RenderFragment Row(string label, string? value, LitePart part) =>
        @<div class="sem-lite-chips">
            <button type="button" class="heading" title="@($"Edit {label}")"
                    @onclick="() => Open(part)">@label</button>

            <div class="chips">
                <button type="button" class="value" title="@($"Edit {label}")"
                        @onclick="() => Open(part)">@(value is { Length: > 0 } ? value : "not set")</button>
            </div>
        </div>;

    /// <summary>One of the choices the game draws a picture for.</summary>
    private RenderFragment Tile(string label, string? value, string? image, LitePart part) =>
        @<button type="button" class="sem-lite-tile" title="@($"Edit {label}")"
                 @onclick="() => Open(part)">
            @if (image is { Length: > 0 })
            {
                <img class="art" src="@Session.Data.AssetUrl(image)" alt="" loading="lazy">
            }

            <span class="label">@label</span>
            <span class="value">@(value is { Length: > 0 } ? value : "not set")</span>
        </button>;
}
