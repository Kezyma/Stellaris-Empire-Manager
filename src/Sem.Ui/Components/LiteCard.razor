@*
    The empire as a set of panels you can press.

    The picture at the top, then one panel per thing an empire is: what it is called, how it is
    governed, who lives in it, who rules it, where it starts, and what it flies. Every option the
    designer can set appears on one of them - the card is the whole empire, not a summary of it.

    Every panel is shaped the same way, because they are all the same kind of thing: a picture on
    the left, a name at the top of the rest, the other forms of that name bracketed beside it, small
    settings as icons in the corner, and labelled rows only for what genuinely needs a label. A
    species' plural is not a fact about a species - it is the species' name again, so it reads as
    one rather than taking a line of its own.

    Pressing anything opens the editor for that one thing. The exceptions are the two the game
    itself joins: a name comes with its other forms, and a portrait comes with what decides which
    portrait is worn - the class and the gender. Pressing a chip does what pressing its row's name
    does, because that is what a chip looks like it should do.

    Everything derived comes from the shared EmpireView, so this and the showcase cannot drift about
    what an empire is - only about how it is laid out, which is the whole point of there being two.
*@

@using Sem.Rules

<div class="sem-lite">
    <div class="sem-lite-main">

        @*
            The room, the world through its window, the city on it and the ruler in front. One
            picture made of four choices, and pressing it opens the two that are not editable
            anywhere else on the card.
        *@
        <button type="button" class="sem-lite-scene" title="Room and city"
                aria-label="Edit the room and city" @onclick="() => Open(LitePart.Room)">
            <RoomScene Room="View.Room" World="View.World" City="View.City" Portrait="@View.RulerPortrait"
                       Flag="@Design.Flag" Alt="@Session.Localizer.Name(Design.Species.Name, string.Empty)" />
            <span class="sem-lite-hint" aria-hidden="true"><ActionIcon Name="edit-pencil" /></span>
        </button>

        <div class="sem-lite-panels">

            @* ------------------------------------------------------------- the empire *@
            <section class="sem-panel">
                <div class="head">
                    <h3>Empire</h3>

                    @* Whether it may turn up in somebody else's game: one setting, one icon. *@
                    <SpawnToggle Compact="true" />
                </div>

                <div class="body">
                    <button type="button" class="face-button" title="Edit the flag"
                            @onclick="() => Open(LitePart.Flag)">
                        <FlagPreview Flag="@Design.Flag" Class="medium" />
                    </button>

                    <div class="about">
                        @Named(Session.Localizer.Name(Design.Name, Design.Key),
                               [View.Adjective],
                               Session.Localizer.Name(Design.ShipPrefix, string.Empty) is { Length: > 0 } prefix
                                   ? $"{prefix} - ship prefix"
                                   : null,
                               LitePart.Naming, "Edit the empire's name")

                        <div class="sem-lite-choices">
                            @*
                                The scripted country flags. Nothing to do with the flag beside them,
                                which is why they are named in full - see docs/empire-flags.md,
                                written because the two were confusable enough to need it.
                            *@
                            <div class="sem-lite-chips">
                                <span class="heading">Special empire flags</span>

                                <div class="chips">
                                    @if (_flagging)
                                    {
                                        <EmpireFlagSets OnDone="() => _flagging = false" />
                                    }
                                    else
                                    {
                                        <button type="button" class="value"
                                                title="Choose a set of scripted country flags"
                                                @onclick="() => _flagging = true">
                                            @(View.FlagSetLabel ?? "None")
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @* ------------------------------------------------------------- how it is governed *@
            <section class="sem-panel">
                <div class="head">
                    <h3>Government</h3>
                </div>

                <div class="body">
                    <div class="about">
                        @Named(View.Government, [], null, LitePart.Government,
                               "Edit ethics, authority and civics together",
                               warning: View.HasGovernment ? null : "no government matches these")

                        <div class="sem-lite-choices">
                            @Chips(Session.Localizer.Heading("ETHICS", "Ethics"), View.Ethics, LitePart.Ethics)
                            @Chips(Session.Localizer.Heading("GOVERNMENT_AUTHORITY_AND_TYPE", "Authority"),
                                   View.AuthorityChoice, LitePart.Authority)
                            @Chips(Session.Localizer.Heading("CIVICS_LABEL", "Civics"), View.Civics, LitePart.Civics)
                        </div>
                    </div>
                </div>
            </section>

            @* ------------------------------------------------------------- who lives in it *@
            @Species(Design.Species, "Species", LitePart.Species, LitePart.Portrait, LitePart.Traits)

            @if (Design.SecondarySpecies is { } second)
            {
                @Species(second, "Second species", LitePart.SecondSpecies, LitePart.SecondPortrait,
                         LitePart.SecondTraits)
            }

            @* ------------------------------------------------------------- who rules it *@
            <section class="sem-panel">
                <div class="head">
                    <h3>Ruler</h3>

                    @Icon(GenderPicker.Held(Design.Ruler.Gender), LitePart.Ruler)
                    @Icon((RulerClassName, RulerClass?.Icon), LitePart.Ruler, sprite: false)
                </div>

                <div class="body">
                    @*
                        The ruler as they actually look, not the species' stock face: the design's
                        own phenotype, colour, clothes and whatever is on its head.
                    *@
                    <button type="button" class="face-button figure" title="Edit the ruler's appearance"
                            @onclick="() => Open(LitePart.RulerAppearance)">
                        <RulerFigure />
                    </button>

                    <div class="about">
                        @Named(View.RulerName is { Length: > 0 } named ? named : "No ruler named",
                               [], View.RulerTitle, LitePart.Ruler, "Edit the ruler's name and titles")

                        <div class="sem-lite-choices">
                            @Chips(Session.Localizer.Heading("TRAITS", "Traits"), View.RulerTraits,
                                   LitePart.RulerTraits)
                        </div>

                        <BiographyField Value="@RulerBiography"
                                        For="@Session.Localizer.Heading("RULER_TITLE", "Ruler")"
                                        Placeholder="Who this ruler is, and how they came to rule."
                                        OnChange="SetRulerBiography" />
                    </div>
                </div>
            </section>

            @* ------------------------------------------------------------- where it starts *@
            <section class="sem-panel">
                <div class="head">
                    <h3>Origin</h3>
                </div>

                <div class="body">
                    @*
                        The world itself, as a picture, the way a species has one. It was a tile
                        under everything else - a picture in a box beneath a panel that had room for
                        it at the side.
                    *@
                    <button type="button" class="face-button" title="Edit the homeworld"
                            @onclick="() => Open(LitePart.Homeworld)">
                        @if (View.World?.Icon is { Length: > 0 } world)
                        {
                            <img class="face contain" src="@Session.Data.AssetUrl(world)" alt="" loading="lazy">
                        }
                        else
                        {
                            <span class="face noface" aria-hidden="true"></span>
                        }
                    </button>

                    <div class="about">
                        @Named(Session.Localizer.Name(Design.PlanetName, "Unnamed world"),
                               [Session.Localizer.Name(Design.SystemName, string.Empty)],
                               Session.Localizer.Text(View.Context.EffectivePlanetClass),
                               LitePart.Homeworld, "Edit the homeworld and its system")

                        <div class="sem-lite-choices">
                            @Chips(Session.Localizer.Heading("ORIGIN", "Origin"), View.OriginChoice, LitePart.Origin)
                            @Row(Session.Localizer.Heading("SELECT_SYSTEM_INITIALIZER_LABEL", "Starting System"),
                                 View.StartingSystem, LitePart.Homeworld)

                            @if (Design.IsNomadic == true)
                            {
                                @Row(Session.Localizer.Heading("arkship_cap", "Arkship"),
                                     View.Arkship is { } ark
                                         ? Session.Localizer.Text(ark.NameKey, Localizer.Prettify(ark.Key))
                                         : null,
                                     LitePart.Homeworld)
                            }
                        </div>
                    </div>
                </div>
            </section>

            @* ------------------------------------------------------------- what it flies *@
            <section class="sem-panel">
                <div class="head">
                    <h3>@Session.Localizer.Heading("SHIPSETS_LABEL", "Shipset")</h3>
                </div>

                <div class="body">
                    <button type="button" class="face-button" title="Edit the shipset"
                            @onclick="() => Open(LitePart.Shipset)">
                        @if (View.Shipset?.ShipPreview is { Length: > 0 } ships)
                        {
                            <img class="face contain" src="@Session.Data.AssetUrl(ships)" alt="" loading="lazy">
                        }
                        else
                        {
                            <span class="face noface" aria-hidden="true"></span>
                        }
                    </button>

                    <div class="about">
                        @Named(View.CultureName(Design.GraphicalCulture) ?? "not set", [], null,
                               LitePart.Shipset, "Edit the shipset")
                    </div>
                </div>
            </section>

            @*
                ------------------------------------------------------------- the voice

                Its own panel because it belongs to none of the others: it is not what the empire
                looks like, nor how it is run, nor where it starts. It changes nothing about the
                empire either, which is why its chip has no effects to show.
            *@
            <section class="sem-panel">
                <div class="head">
                    <h3>@Session.Localizer.Heading("EMPIRE_ADVISOR", "Advisor Voice")</h3>
                </div>

                <div class="body">
                    <div class="about">
                        @Chips(null, View.AdvisorChoice, LitePart.Advisor, empty: "Automatic")
                    </div>
                </div>
            </section>
        </div>
    </div>

    @*
        What the empire adds up to, and what is wrong with it, following the page as the designer's
        own pane does. The problems had no home in this editor at all - the sections put a count on
        every header and the showcase beside them carried the messages, and a lite user got neither.
    *@
    <div class="sem-lite-totals">
        <ProblemsPanel Report="@View.Report" />
        <CombinedEffects Context="@View.Context" Baseline="@Baseline" />
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The empire being edited.</summary>
    [Parameter, EditorRequired]
    public required EmpireDesign Design { get; set; }

    /// <summary>Raised with the part whose editor should open.</summary>
    [Parameter]
    public EventCallback<LitePart> OnEdit { get; set; }

    /// <summary>The empire as it was last saved, for the totals to compare against.</summary>
    [Parameter]
    public DesignContext? Baseline { get; set; }

    private EmpireView View => _view ??= new EmpireView(Session, Design);

    private EmpireView? _view;

    /// <summary>Whether the flag-set box is showing in place of the value it holds.</summary>
    private bool _flagging;

    protected override void OnParametersSet() => _view = null;

    private Task Open(LitePart part) => OnEdit.InvokeAsync(part);

    /// <summary>The kind of leader who rules, where the design names one.</summary>
    private LeaderClassDefinition? RulerClass => Session.Data.Database.LeaderClasses
        .FirstOrDefault(c => c.Key == Design.Ruler.LeaderClass);

    private string RulerClassName => RulerClass is { } held
        ? Session.Localizer.Text(held.NameKey, Localizer.Prettify(held.Key))
        : "No leader class";

    /// <summary>
    /// The ruler's own story, which the game keeps as a name rather than as plain text.
    /// </summary>
    /// <remarks>
    /// Written <c>custom_biography = { key="…" literal=yes }</c>, the same shape as a name, while a
    /// species' biography beside it is a bare quoted string. That asymmetry is the game's.
    /// </remarks>
    private string? RulerBiography => Session.Localizer.Name(Design.Ruler.CustomBiography, string.Empty);

    private void SetRulerBiography(string? value)
    {
        Session.Edit(d =>
        {
            // An emptied box takes the block out rather than leaving an empty one, so a design
            // nobody wrote a biography for stays as it was.
            if (string.IsNullOrWhiteSpace(value))
            {
                d.Ruler.RemoveCustomBiography();
                return;
            }

            d.Ruler.GetOrAddCustomBiography().SetLiteral(value);
        });
    }

    /// <summary>
    /// One species, founder or second, as a panel of its own.
    /// </summary>
    /// <remarks>
    /// The same panel either way, because the questions are the same either way - which is the
    /// reason the species editor itself serves both. Only which editors its presses open differ,
    /// and those are handed in.
    /// </remarks>
    private RenderFragment Species(SpeciesDesign species, string title, LitePart names,
                                   LitePart portrait, LitePart traits) =>
        @<section class="sem-panel">
            <div class="head">
                <h3>@title</h3>

                @* The gender decides which face of the group is worn, so it opens the portrait. *@
                @Icon(GenderPicker.Held(species.Gender), portrait)
            </div>

            <div class="body">
                <button type="button" class="face-button" title="Edit the portrait, class and gender"
                        @onclick="() => Open(portrait)">
                    @if (PortraitArtwork.For(Session.Data.Database, species.Portrait, species.Gender) is { Length: > 0 } face)
                    {
                        <img class="face" src="@Session.Data.AssetUrl(face)" alt="" loading="lazy">
                    }
                    else
                    {
                        <span class="face noface" aria-hidden="true"></span>
                    }
                </button>

                <div class="about">
                    @Named(Session.Localizer.Name(species.Name, species.Class),
                           [Session.Localizer.Name(species.Plural, string.Empty),
                            Session.Localizer.Name(species.Adjective, string.Empty)],
                           Session.Localizer.Text(species.Class),
                           names, "Edit the species' names")

                    <div class="sem-lite-choices">
                        @Row(Session.Localizer.Heading("NAME_LIST", "Name List"),
                             Session.Localizer.Text(species.NameList), names)
                        @Chips(Session.Localizer.Heading("TRAITS", "Traits"), View.TraitsOf(species), traits)
                    </div>

                    <BiographyField Value="@species.Biography"
                                    For="@Session.Localizer.Name(species.Name, "this species")"
                                    Placeholder="What this species is, and where it came from."
                                    OnChange="value => Session.Edit(_ => species.Biography = value)" />
                </div>
            </div>
        </section>;

    /// <summary>
    /// A name, the other forms of it, and the one line that describes it.
    /// </summary>
    /// <remarks>
    /// The variants are bracketed and italic beside the name rather than given rows of their own. A
    /// species' plural and adjective are not two more facts about it - they are its name again, and
    /// as labelled rows they took two lines each to say so.
    /// </remarks>
    private RenderFragment Named(string name, IEnumerable<string?> variants, string? sub,
                                 LitePart part, string title, string? warning = null)
    {
        var forms = variants.Where(v => v is { Length: > 0 }).ToList();

        return @<button type="button" class="name-button" title="@title" @onclick="() => Open(part)">
            <span class="name">@name</span>

            @if (forms.Count > 0)
            {
                <span class="aside">(@string.Join(", ", forms))</span>
            }

            @if (warning is { Length: > 0 })
            {
                <span class="aside bad">@warning</span>
            }

            @if (sub is { Length: > 0 })
            {
                <span class="kind">@sub</span>
            }
        </button>;
    }

    /// <summary>
    /// One held setting, as the icon it is and nothing else.
    /// </summary>
    /// <remarks>
    /// In the panel's corner rather than in a row, because a gender is one glyph and a row to hold
    /// it is two lines of panel spent saying what the picture already says. The word is the title,
    /// so it is there for a pointer and for a screen reader without being drawn.
    /// </remarks>
    private RenderFragment Icon((string Label, string? Key) held, LitePart part, bool sprite = true)
    {
        var path = held.Key is { Length: > 0 } key
            ? sprite ? Session.Data.Database.Icons.GetValueOrDefault(key) : key
            : null;

        return @<button type="button" class="badge" title="@held.Label" aria-label="@held.Label"
                        @onclick="() => Open(part)">
            @if (path is { Length: > 0 })
            {
                <img src="@Session.Data.AssetUrl(path)" alt="">
            }
            else
            {
                <span>@held.Label</span>
            }
        </button>;
    }

    /// <summary>
    /// A labelled row of chips, where the label and every chip open the same editor.
    /// </summary>
    /// <remarks>
    /// The chips are siblings of the label rather than inside it. A chip is already a button, and a
    /// button within a button is both invalid and unusable; as siblings they can each carry the
    /// press without nesting. OptionChip gives up its own click when it is given something to open,
    /// so a chip still describes itself on hover but no longer does two things at once.
    /// </remarks>
    private RenderFragment Chips(string? label, IEnumerable<EmpireChoice> items, LitePart part,
                                 string empty = "none chosen")
    {
        // Once. Each of these costs a lookup in the database, and the row asks twice below.
        var listed = items.ToList();

        return @<div class="sem-lite-chips @(label is null ? "bare" : null)">
            @if (label is not null)
            {
                <button type="button" class="heading" title="@($"Edit {label}")"
                        @onclick="() => Open(part)">@label</button>
            }

            <div class="chips">
                @if (listed.Count == 0)
                {
                    <button type="button" class="sem-lite-empty" title="@($"Edit {label ?? empty}")"
                            @onclick="() => Open(part)">@empty</button>
                }

                @foreach (var choice in listed)
                {
                    <OptionChip @key="choice.Key" Key="@choice.Key" Name="@choice.Name"
                                Icon="@choice.Icon" Effects="@choice.Effects"
                                OnSelect="() => Open(part)" />
                }
            </div>
        </div>;
    }

    /// <summary>One fact the game has no picture for, as a labelled line.</summary>
    private RenderFragment Row(string label, string? value, LitePart part) =>
        @<div class="sem-lite-chips">
            <button type="button" class="heading" title="@($"Edit {label}")"
                    @onclick="() => Open(part)">@label</button>

            <div class="chips">
                <button type="button" class="value" title="@($"Edit {label}")"
                        @onclick="() => Open(part)">@(value is { Length: > 0 } ? value : "not set")</button>
            </div>
        </div>;
}
