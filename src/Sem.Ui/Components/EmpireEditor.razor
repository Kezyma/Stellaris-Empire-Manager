@implements IDisposable
@inject SessionHost Host
@inject IFileExchange Files
@inject NavigationManager Navigation
@inject UnsavedWorkGuard Unsaved

@*
    Editing one empire: the buttons, the questions they ask, and the guard that stops the work being
    walked away from.

    Everything here used to be Designer.razor's, when the designer was the only place an empire could
    be edited. There are two now - the card in a dialog on the list, and the sections on their own
    page - and every one of these is the same in both. A second copy of Save is a second thing to
    keep right, and a second copy of the unsaved-work question is a way for one of them to stop being
    asked.

    So this owns the empire and the two callers own the layout. The body is handed the row of buttons
    rather than drawing its own, which is what lets the card put them in its corner and the sections
    put them across the top without either knowing what is in the row.
*@

@if (Session.Current is null)
{
    <div class="sem-empty">
        <p>No empire is open.</p>
    </div>
}
else
{
    @if (_confirming == Asking.Delete)
    {
        <ConfirmDialog Title="@($"Delete {Title}?")"
                       Message="The empire is removed from your file. There is no undo."
                       OnDismiss="() => _confirming = Asking.None">
            <button type="button" @onclick="() => _confirming = Asking.None">Keep it</button>
            <button type="button" class="danger" @onclick="Delete">Delete</button>
        </ConfirmDialog>
    }
    else if (_confirming == Asking.Revert)
    {
        <ConfirmDialog Title="Throw away your changes?"
                       Message="@($"{Title} goes back to how it was when you opened it, or last saved it.")"
                       OnDismiss="() => _confirming = Asking.None">
            <button type="button" @onclick="() => _confirming = Asking.None">Keep editing</button>
            <button type="button" class="danger" @onclick="RevertEdits">Throw them away</button>
        </ConfirmDialog>
    }
    else if (_confirming == Asking.Leaving)
    {
        @*
            Dismissing answers "stay here" rather than merely hiding the question. Escape and a
            click on the backdrop both arrive as OnDismiss, and a dismissal that only cleared the
            dialog left whoever asked waiting on an answer that never came: the navigation neither
            happened nor was called off, the click that started it was swallowed, and the page was
            left believing it was on its way out for the rest of the session.
        *@
        <ConfirmDialog Title="@($"Save your changes to {Title}?")"
                       Message="Leaving without saving puts the empire back to how it was when you opened it."
                       OnDismiss="() => Answer(false)">
            <button type="button" @onclick="() => Answer(false)">Stay here</button>
            <button type="button" class="danger" @onclick="DiscardAndLeave">Discard changes</button>
            <button type="button" class="primary" @onclick="SaveAndLeave">Save and leave</button>
        </ConfirmDialog>
    }

    @if (_saveError is { } failure)
    {
        <p class="sem-status bad">@failure</p>
    }

    @Body(Actions)
}

@code {
    [Parameter, EditorRequired]
    public required DesignSession Session { get; set; }

    /// <summary>
    /// The editor itself, handed the row of buttons to put wherever it keeps them.
    /// </summary>
    /// <remarks>
    /// A fragment taking a fragment, rather than markup here with the editor inside it. Where the
    /// buttons sit is a decision about the editor - the card wants them in the corner of its second
    /// column, inside a box this knows nothing about - and the row itself is the same either way.
    /// </remarks>
    [Parameter, EditorRequired]
    public required RenderFragment<RenderFragment> Body { get; set; }

    /// <summary>
    /// The way out: back to the list, with the empire still in hand.
    /// </summary>
    /// <remarks>
    /// Not a navigation here, because for one of the two callers it is not one - closing a dialog
    /// on the page you are already on. The guard has had its say by the time this runs.
    /// </remarks>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Called once the empire has been deleted, so there is nothing left to show.</summary>
    [Parameter]
    public EventCallback OnDeleted { get; set; }

    /// <summary>
    /// The button across to the other editor, which each of them names for the other.
    /// </summary>
    /// <remarks>
    /// A slot rather than a parameter or two, because the two are not variations on one button: one
    /// opens a page and the other closes a dialog, and neither is "the other editor" from where the
    /// row is drawn.
    /// </remarks>
    [Parameter]
    public RenderFragment? Across { get; set; }

    /// <summary>
    /// Whether a destination is another view of this same empire rather than a way out of it.
    /// </summary>
    /// <remarks>
    /// Given the route: base-relative, query stripped, slashes trimmed. Anything this accepts goes
    /// ahead without a question, which is what makes moving between the card and the sections free -
    /// the empire is in hand either side, unsaved work and all, so there is nothing to abandon.
    /// </remarks>
    [Parameter]
    public Func<string, bool>? StaysHere { get; set; }

    /// <summary>
    /// Whether this editor is drawn in a dialog rather than on a page of its own.
    /// </summary>
    /// <remarks>
    /// Only the way out differs. A page is left by going back to the list; a dialog is closed, and
    /// a back arrow on one is describing a journey that is not being made.
    /// </remarks>
    [Parameter]
    public bool InDialog { get; set; }

    /// <summary>
    /// Whether to keep the empire in the address bar, so the link can be shared by copying it.
    /// </summary>
    /// <remarks>
    /// The list does; the sections do not. Two pages writing the same address would be two pages
    /// claiming the same link, and the one that reads it back is the list.
    /// </remarks>
    [Parameter]
    public bool TracksAddress { get; set; }

    /// <summary>The questions this stops to ask.</summary>
    private enum Asking
    {
        None,
        Delete,
        Revert,
        Leaving,
    }

    /// <summary>Which of them is on screen.</summary>
    private Asking _confirming;

    /// <summary>Why the last save did not happen, where it did not.</summary>
    private string? _saveError;

    /// <summary>
    /// The unanswered question, where one is on screen.
    /// </summary>
    /// <remarks>
    /// A navigation waits on this, and so does the header's Create or Import, and so does closing
    /// the editor. One question with one answer, rather than a dialog per way of asking it.
    /// </remarks>
    private TaskCompletionSource<bool>? _answer;

    /// <summary>
    /// Set once the editor is on its way out, so nothing it does on the way rewrites the address.
    /// </summary>
    /// <remarks>
    /// Saving and reverting both change the empire, and a change redraws the address bar to match —
    /// which, in the middle of a navigation being held open, replaced the destination with the
    /// editor's own address. Discarding a new empire and pressing Empires left you looking at the
    /// editor.
    ///
    /// Raised by the navigation guard alone, and lowered again if the answer was to stay. Nothing
    /// else raises it, because nothing else is leaving.
    /// </remarks>
    private bool _leaving;

    /// <summary>What the host was last told about unsaved work, so it is only told when it changes.</summary>
    private bool? _warned;

    /// <summary>Removes the navigation guard when the editor goes away.</summary>
    private IDisposable? _guard;

    /// <summary>The empire the address bar is currently showing, so it is only rewritten when it changes.</summary>
    private string? _shown;

    /// <summary>Null until the share button has been pressed; then whether the copy happened.</summary>
    private bool? _copied;

    private string Title => Session.Current is { } design
        ? Session.Localizer.Name(design.Name, design.Key)
        : "Designer";

    /// <summary>
    /// The row of things you can do to the empire.
    /// </summary>
    /// <remarks>
    /// Icons because there is room for five of them beside a flag and not for five words, and in the
    /// order both editors have always had them: the way back, a link, whatever is destructive, the
    /// way across, and then the one thing the row is really for.
    /// </remarks>
    private RenderFragment Actions => @<text>
        @*
            The way out, at whichever end of the row it belongs to. A page is left by going back, and
            a back arrow reads leftwards - it is the first thing in the row for the same reason it is
            the first thing in a browser's toolbar. A dialog is closed, and a close belongs in the
            corner: the row is against the right edge of the card, so last is the corner.
        *@
        @if (!InDialog)
        {
            @WayOut
        }

        @* A copy that did not happen says so, rather than looking exactly like one that did. *@
        <button type="button" class="icon" title="@ShareTitle"
                aria-label="Copy a link to this empire" @onclick="CopyLink">
            <ActionIcon Name="share" />
        </button>

        @if (Session.IsModified)
        {
            <button type="button" class="icon" title="Throw away your changes"
                    aria-label="Throw away your changes" @onclick="() => _confirming = Asking.Revert">
                <ActionIcon Name="revert" />
            </button>
        }

        @Across

        @*
            What the button is for depends on what is in hand. An empire of the player's own is
            saved, and the button is dark until there is something to save; one of the game's,
            untouched, is not theirs at all yet - so it offers to make the copy, which is what the
            preview used to offer beside it, and turns into Save the moment anything is changed.
        *@
        @if (Copying)
        {
            <button type="button" class="icon good" title="Add this empire to your file"
                    aria-label="Add this empire to your file" @onclick="SaveEdits">
                <ActionIcon Name="duplicate" />
            </button>
        }
        else
        {
            <button type="button" class="icon good" disabled="@(!Session.IsModified)"
                    title="@(Session.IsModified ? "Save this empire" : "Saved")"
                    aria-label="@(Session.IsModified ? "Save this empire" : "Saved")"
                    @onclick="SaveEdits">
                <ActionIcon Name="save" />
            </button>
        }

        <button type="button" class="icon danger" title="Delete this empire"
                aria-label="Delete this empire" @onclick="() => _confirming = Asking.Delete">
            <ActionIcon Name="delete" />
        </button>

        @if (InDialog)
        {
            @WayOut
        }
    </text>;

    /// <summary>The way out, drawn wherever the row wants it.</summary>
    private RenderFragment WayOut => @<text>
        <button type="button" class="icon" title="@LeaveTitle"
                aria-label="@LeaveTitle" @onclick="Leave">
            <ActionIcon Name="@(InDialog ? "close" : "back")" />
        </button>
    </text>;

    /// <summary>What the way out is called, which depends on whether there is anywhere to go.</summary>
    private string LeaveTitle => InDialog ? "Close the editor" : "Back to the empire list";

    /// <summary>
    /// Takes the way out, without writing to the address on the way.
    /// </summary>
    /// <remarks>
    /// The address is this editor's business only while it is open. Whoever is asked on the way out
    /// may change the empire - discarding one that was never saved selects another - and that change
    /// would otherwise be written into the address as the editor disappeared, leaving the list
    /// showing an empire nobody had open. The page then read its own leftover address as somebody
    /// opening a link and put the editor straight back up.
    ///
    /// Lowered again afterwards, which only matters if the editor is still here - that is the answer
    /// having been to stay.
    /// </remarks>
    private async Task Leave()
    {
        _leaving = true;
        await OnBack.InvokeAsync();
        _leaving = false;
    }

    /// <summary>
    /// Whether the button offers to take this empire rather than to save it.
    /// </summary>
    /// <remarks>
    /// True for one of the game's own, opened and not yet touched: it is in the file's list only
    /// because the editor needs something to work on, and pressing this is what makes it the
    /// player's. A shared link and a brand-new empire are held out in the same way but count as
    /// unsaved work from the start, so they are already showing Save.
    /// </remarks>
    private bool Copying => Session.IsHeldOut && !Session.IsModified;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        ShowInAddressBar();

        // Three ways out, one question. This catches the app's own links; the header asks the same
        // question through the shared guard before it starts an empire or opens a file; and the
        // browser's own warning covers the tab being closed.
        _guard = Navigation.RegisterLocationChangingHandler(Leaving);
        Unsaved.Ask = AskAboutUnsavedWork;
        await SyncLeaveWarning();
    }

    /// <summary>
    /// Stops a move away from the empire while there is unsaved work, and asks about it.
    /// </summary>
    /// <remarks>
    /// The list rewrites its own address on every save, to keep the shareable link current, so the
    /// first thing to establish is whether this is a move at all. Without that check the reader
    /// would be asked whether they meant to leave every time they picked a trait.
    /// </remarks>
    private async ValueTask Leaving(LocationChangingContext context)
    {
        if (StaysOnThisPage(context.TargetLocation))
        {
            return;
        }

        // From here the address bar is no longer this editor's business. Answering the question may
        // put the empire back, and the change that comes with it would rewrite the address and
        // supersede the very navigation being waited on. The editor goes a moment later, so nothing
        // has to undo this.
        //
        // Set here rather than when the question is answered, because the header asks the same
        // question through the guard and then does not navigate. Setting it there latched it on for
        // good: Create or Import from the header on an edited empire left the page mounted with the
        // address frozen, and the share link never updated again.
        _leaving = true;

        // The navigation waits here while the dialog is on screen. Holding it open is what lets the
        // answer decide, rather than cancelling the move and then having to remember where it was
        // going in order to make it again.
        if (!await AskAboutUnsavedWork())
        {
            _leaving = false;
            context.PreventNavigation();
        }
    }

    /// <summary>
    /// Puts the unsaved-work question on screen and waits for it to be answered.
    /// </summary>
    /// <remarks>
    /// True to carry on, and by then the work has been dealt with: saved, or put back. False to
    /// stay. With nothing unsaved it answers true without asking anything, which is what makes it
    /// safe for the header to call before every Create and every Import.
    /// </remarks>
    private Task<bool> AskAboutUnsavedWork()
    {
        if (!Session.IsModified)
        {
            return Task.FromResult(true);
        }

        // Whoever is still waiting is told to stay, rather than being left holding a task that
        // will never complete. Asking twice over should not be possible, but a dropped answer is
        // silent and this is one line.
        _answer?.TrySetResult(false);

        _answer = new TaskCompletionSource<bool>();
        _confirming = Asking.Leaving;
        StateHasChanged();

        return _answer.Task;
    }

    /// <summary>Answers the question above, and takes the dialog down.</summary>
    /// <remarks>
    /// Says nothing about the address bar. Whether the empire is being left is the caller's to know:
    /// a navigation is leaving, and the header asking before it starts an empire or opens a file is
    /// not.
    /// </remarks>
    private void Answer(bool proceed)
    {
        _confirming = Asking.None;
        _answer?.TrySetResult(proceed);
        _answer = null;
    }

    /// <summary>
    /// Whether a destination is another view of this same empire.
    /// </summary>
    /// <remarks>
    /// The destination arrives however it was written — "e/…" from the address rewrite, "" from the
    /// Empires button, and an absolute address from a link. ToBaseRelativePath looks like the tool
    /// for this and is not: it throws on anything already relative, and a guard that throws is a
    /// guard that lets everything past.
    /// </remarks>
    private bool StaysOnThisPage(string target)
    {
        var path = target.StartsWith(Navigation.BaseUri, StringComparison.OrdinalIgnoreCase)
            ? target[Navigation.BaseUri.Length..]
            : target;

        return StaysHere?.Invoke(path.Split('?')[0].Trim('/')) is true;
    }

    private async Task SaveAndLeave()
    {
        _saveError = await Host.SaveAsync();

        // A save that did not happen is not a reason to go anyway: that would be leaving the work
        // behind with nothing said about it.
        Answer(_saveError is null);
    }

    /// <summary>
    /// Puts the empire back, then allows whatever was asking to go ahead.
    /// </summary>
    /// <remarks>
    /// Reverted rather than merely left behind. Unsaved edits carried out of the editor would be
    /// picked up as the empire's saved state the next time it was opened — the Save button would say
    /// "Saved" over changes nothing had stored — and would show in the list as an empire that is not
    /// the empire in the file. Leaving without saving means what it says.
    /// </remarks>
    private void DiscardAndLeave()
    {
        Session.Revert();
        Answer(true);
    }

    private async Task SaveEdits() => _saveError = await Host.SaveAsync();

    private void RevertEdits()
    {
        _confirming = Asking.None;
        _saveError = null;
        Session.Revert();
    }

    /// <summary>Tells the host whether closing the tab would lose anything, when the answer changes.</summary>
    private async Task SyncLeaveWarning()
    {
        var unsaved = Session.IsModified;

        if (_warned == unsaved)
        {
            return;
        }

        _warned = unsaved;
        await Files.WarnBeforeLeavingAsync(unsaved);
    }

    /// <summary>
    /// Puts the empire being edited in the address bar, so it can be shared by copying it.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Replacing rather than pushing, so that editing an empire does not fill the back button with
    /// one entry per keystroke. Only written when it actually changed, since navigating is not free
    /// and this runs on every edit.
    /// </para>
    /// <para>
    /// Only ever the saved empire. It used to follow every keystroke, which was fine while every
    /// keystroke was also being stored — the address and the store agreed, so reloading the tab
    /// found the empire the address named and simply opened it. Now that editing waits for Save,
    /// a bar carrying unsaved work would not match anything stored, and a reload read its own
    /// address as a stranger's link and added the half-finished empire to the file as a second
    /// copy. Copy link builds its own address from what is on screen, so nothing is lost by this:
    /// what changes is that the bar names the empire rather than the draft.
    /// </para>
    /// </remarks>
    private void ShowInAddressBar()
    {
        if (!TracksAddress || _leaving || Session.Current is not { } design || Session.IsModified)
        {
            return;
        }

        var encoded = DesignLink.Encode(design);

        if (encoded == _shown)
        {
            return;
        }

        _shown = encoded;
        Navigation.NavigateTo(DesignLink.Address(encoded), replace: true);
    }

    /// <summary>What the share button says, which depends on whether the last press worked.</summary>
    private string ShareTitle => _copied switch
    {
        true => "Link copied",
        false => "The clipboard would not take it",
        null => "Copy a link to this empire",
    };

    private async Task CopyLink()
    {
        if (Session.Current is not { } design)
        {
            return;
        }

        // Built against the address the link can actually be opened at, which on the desktop is the
        // published site rather than the window's own origin — a web view serves the app from
        // somewhere only this process can reach.
        var origin = Files.ShareBaseUri ?? Navigation.BaseUri;

        _copied = await Files.CopyToClipboardAsync(origin + DesignLink.Address(DesignLink.Encode(design)));
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;

        // The question goes with the editor that knew how to ask it.
        if (Unsaved.Ask == AskAboutUnsavedWork)
        {
            Unsaved.Ask = null;
        }

        _guard?.Dispose();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        ShowInAddressBar();
        StateHasChanged();
        await SyncLeaveWarning();
    });

    private async Task Delete()
    {
        if (Session.Current is { } design)
        {
            _confirming = Asking.None;

            // As above: what follows changes the empire in hand, and none of it is the address's
            // business now.
            _leaving = true;

            Session.EditFile(file => file.Remove(design));
            Session.Select(Session.File?.Designs.FirstOrDefault());

            // Selecting something else has already cleared the unsaved flag, so the guard on the way
            // out finds nothing to ask about: there is no point asking whether to save an empire
            // that no longer exists.
            await OnDeleted.InvokeAsync();
        }
    }
}
