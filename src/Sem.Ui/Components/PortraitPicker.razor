@*
    The species class, and the faces it allows.

    The two belong together: the class is what decides which portraits exist, so choosing one and
    then looking elsewhere for the other would hide the connection. Every valid portrait is shown at
    once rather than split across tabs — the categories divide a Humanoid from its cybernetic and
    synthetic variants, which is a distinction worth seeing side by side rather than behind a click.

    Portraits are three-dimensional models rather than pictures, so a thumbnail exists only where one
    has been drawn. Where none has, the portrait is still offered: a picker that works without
    artwork is better than no picker.
*@

@* The game's own four, in its own order. *@
<div class="sem-field">
    <label>@Session.Localizer.Label("GENDER", "Gender")</label>
    <GenderPicker Value="@Species.Gender" OnChange="key => Session.Edit(_ => Species.Gender = key)" />
</div>

@*
    Whether the galaxy may hand this face to somebody else as well. The designs file has carried
    ignore_portrait_duplication all along and nothing has ever been able to set it, so an empire
    written with it kept the setting and an empire made here could never have it.

    Drawn here because this is the portrait it governs, and drawn once: it belongs to the empire
    rather than to a species, so a second species — which shares this editor — must not offer a
    second answer to it.
*@
@if (Founder)
{
    <div class="sem-field">
        <label>Portrait duplication</label>
        <button type="button" class="sem-toggle" aria-pressed="@(Shared ? "true" : "false")"
                @onclick="() => Session.Edit(d => d.IgnorePortraitDuplication = d.IgnorePortraitDuplication != true)">
            @(Shared ? "Allowed" : "Disallowed")
        </button>
    </div>
}

@*
    The classes on the left and their faces on the right, as the game arranges them. A dropdown hid
    which classes exist behind a click, and the class is not an afterthought to the portrait — it is
    the thing that decides which portraits there are.
*@
<div class="sem-portrait-picker">
    @*
        A group of buttons rather than a listbox. A listbox's children have to be options, and a
        browser prunes the ones that are not — so a screen reader was told "listbox, 0 items" over a
        list of species classes. These are buttons, and saying so is what makes them readable.
    *@
    <div class="sem-class-list" role="group" aria-label="@Session.Localizer.Label("SPECIES_CLASS_LABEL", "Species Class")">
        @foreach (var option in ClassOptions)
        {
            <button type="button"
                    aria-pressed="@(option.Key == Species.Class ? "true" : "false")"
                    class="@(option.Key == Species.Class ? "selected" : null) @(option.Enabled || option.Key == Species.Class ? null : "blocked")"
                    disabled="@(!option.Enabled && option.Key != Species.Class)"
                    @onclick="() => SetClass(option.Key)">
                @Session.Localizer.Text(option.Key)
            </button>
        }
    </div>

    @if (Portraits.Count == 0)
    {
        <p class="sem-hint">No portraits for this class.</p>
    }
    else
    {
        <div class="sem-portraits">
            @foreach (var portrait in Portraits)
            {
                var thumbnail = Thumbnail(portrait.Key);

                @*
                    No caption. The game gives portraits no names — its own picker is a bare grid of
                    faces — so a label here could only be the file's key, which is what "avi18" was.
                *@
                <button type="button"
                        class="sem-portrait @(portrait.Key == Selected ? "selected" : null) @(portrait.Enabled ? null : "blocked")"
                        disabled="@(!portrait.Enabled && portrait.Key != Selected)"
                        title="@Caption(portrait.Key)"
                        @onclick="() => Choose(portrait.Key)">

                    @if (thumbnail is not null)
                    {
                        <img src="@Session.Data.AssetUrl(thumbnail)" alt="@Caption(portrait.Key)" loading="lazy" />
                    }
                    else
                    {
                        <span class="silhouette" aria-hidden="true"></span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The species whose portrait is being chosen.</summary>
    [Parameter, EditorRequired]
    public required SpeciesDesign Species { get; set; }

    /// <summary>
    /// Whether this is the empire's founding species rather than a second one.
    /// </summary>
    /// <remarks>
    /// Told rather than worked out. Both SpeciesDesign properties hand back a fresh view over the
    /// same block every time they are read, so no two reads are the same object and comparing them
    /// says nothing; the block underneath could be compared, but reading it is what creates it, and
    /// a comparison that writes to the design is not a comparison. The caller already knows.
    /// </remarks>
    [Parameter]
    public bool Founder { get; set; }

    /// <summary>The rules as they apply to the species this control is editing.</summary>
    private DesignContext Context => Session.ContextFor(Species)!;

    /// <summary>Whether the game has been told not to keep this portrait to this empire.</summary>
    private bool Shared => Session.Current?.IgnorePortraitDuplication == true;

    private IEnumerable<OptionState> ClassOptions =>
        Session.Rules.GetSpeciesClassOptions(Context).Where(o => o.Visible);

    /// <summary>
    /// Something to read aloud or hover over.
    /// </summary>
    /// <remarks>
    /// Only a handful of portraits have text of their own. For the rest the key is all there is, and
    /// made readable it is at least an identifier rather than an eyesore — but it stays out of the
    /// grid itself, where the picture is the point.
    /// </remarks>
    private string Caption(string key) =>
        Session.Localizer.Has(key) ? Session.Localizer.Text(key) : Localizer.Prettify(key);

    /// <summary>
    /// Every portrait the chosen class allows, in the game's own order.
    /// </summary>
    /// <remarks>
    /// The rules return these grouped by the category tabs the game uses, already filtered by
    /// species class. A portrait can belong to more than one category, so the groups are flattened
    /// and the duplicates dropped rather than shown twice.
    /// </remarks>
    private IReadOnlyList<OptionState> Portraits
    {
        get
        {
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var all = new List<OptionState>();

            foreach (var portrait in Session.Rules.GetPortraitOptions(Context).SelectMany(g => g.Portraits))
            {
                if (seen.Add(portrait.Key))
                {
                    all.Add(portrait);
                }
            }

            return all;
        }
    }

    private string? Selected => Species.Portrait;

    /// <summary>
    /// The rendered likeness, when one exists. A group stands in for a portrait and takes its
    /// artwork from whichever the group defaults to.
    /// </summary>
    private string? Thumbnail(string key) =>
        PortraitArtwork.For(Session.Data.Database, key, Species.Gender);

    private void Choose(string key)
    {
        Session.Edit(_ =>
        {
            Species.Portrait = key;

            // The ruler wears the founder species' likeness unless deliberately given another,
            // and leaving a portrait from a different species behind looks like a fault.
            if (Session.Current is { } design && !design.IsSecondary(Species))
            {
                design.Ruler.Portrait = key;
            }
        });
    }

    private void SetClass(string? key)
    {
        if (key is not { Length: > 0 })
        {
            return;
        }

        Session.Edit(_ =>
        {
            Species.Class = key;

            // A class carries a trait of its own, and leaving the previous class's behind would
            // give the species two contradictory ones.
            var classTraits = Session.Data.Database.SpeciesClasses
                .Select(c => c.ForcedTrait)
                .OfType<string>()
                .ToHashSet(StringComparer.Ordinal);

            var kept = Species.Traits.Where(t => !classTraits.Contains(t)).ToList();

            if (Session.Data.Database.SpeciesClasses.FirstOrDefault(c => c.Key == key)?.ForcedTrait is { } trait)
            {
                kept.Insert(0, trait);
            }

            Species.SetTraits(kept);
        });
    }
}
