@*
    One part of the designer, collapsible.

    Sections start closed. Eight of them open at once is a page taller than any screen, and the
    header carries what is chosen in it, so a closed designer still reads as a summary of the whole
    empire — which is the thing worth seeing first.
*@

<section class="sem-section @(IsOpen ? "open" : "closed")">
    <button type="button" class="head" aria-expanded="@(IsOpen ? "true" : "false")" @onclick="Toggle">
        <span class="chevron">@(IsOpen ? "▾" : "▸")</span>
        <span class="title">@Title</span>

        @if (Summary is { Length: > 0 })
        {
            <span class="summary">@Summary</span>
        }

        @if (Problems > 0)
        {
            <span class="count">@Problems</span>
        }
    </button>

    @if (IsOpen)
    {
        <div class="body">
            @ChildContent
        </div>
    }
</section>

@code {
    /// <summary>Whether this one is open when nobody is coordinating them.</summary>
    private bool _open;

    /// <summary>The section's name.</summary>
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    /// <summary>What is currently chosen, shown in the header so a closed section still says so.</summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>How many problems belong to this section.</summary>
    [Parameter]
    public int Problems { get; set; }

    /// <summary>Whether it begins open.</summary>
    [Parameter]
    public bool StartOpen { get; set; }

    /// <summary>
    /// Which section the page has open, where a page is keeping them to one at a time.
    /// </summary>
    /// <remarks>
    /// Given, this section is open when the name matches and the page decides what happens on a
    /// click; the section keeps no opinion of its own. Eleven sections open at once is a page of
    /// several thousand pixels to scroll past whatever was actually being edited.
    /// </remarks>
    [Parameter]
    public string? OpenSection { get; set; }

    /// <summary>Called with this section's title when its head is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnToggle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool Coordinated => OnToggle.HasDelegate;

    private bool IsOpen => Coordinated ? OpenSection == Title : _open;

    private Task Toggle()
    {
        if (Coordinated)
        {
            return OnToggle.InvokeAsync(Title);
        }

        _open = !_open;
        return Task.CompletedTask;
    }

    protected override void OnInitialized() => _open = StartOpen;
}
