@*
    Everything about how an empire looks and sounds: its flag, the room its leader stands in, its
    ships and cities, and the voice that advises it.
*@

<div class="sem-columns">
    <div class="sem-panel">
        <h3>Flag</h3>

        <div class="sem-row" style="align-items:flex-start">
            <FlagPreview Flag="@Design.Flag" Class="large" />

            <div style="flex:1;min-width:200px">
                @for (var slot = 0; slot < EmpireFlag.ColorSlots; slot++)
                {
                    var index = slot;

                    <div class="sem-field">
                        <label for="@($"flag-color-{index}")">@ColorLabel(index)</label>
                        <select id="@($"flag-color-{index}")" @onchange="e => SetColor(index, e.Value?.ToString())">
                            <option value="null" selected="@(ColorAt(index) is null)">None</option>

                            @foreach (var color in Session.Data.Database.FlagColors)
                            {
                                <option value="@color.Key" selected="@(color.Key == ColorAt(index))">
                                    @Localizer.Prettify(color.Key)
                                </option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>

        <div class="sem-field">
            <label for="flag-background">Background</label>
            <select id="flag-background" @onchange="e => SetBackground(e.Value?.ToString())">
                @foreach (var file in BackgroundFiles)
                {
                    <option value="@file" selected="@(file == Design.Flag.Background.File)">
                        @System.IO.Path.GetFileNameWithoutExtension(file)
                    </option>
                }
            </select>
        </div>

        <div class="sem-field">
            <label for="emblem-category">Emblem</label>
            <select id="emblem-category" @onchange="e => _emblemCategory = e.Value?.ToString() ?? _emblemCategory">
                @foreach (var category in EmblemCategories)
                {
                    <option value="@category.Key" selected="@(category.Key == EmblemCategory)">
                        @Session.Localizer.Text(category.NameKey, Localizer.Prettify(category.Key))
                    </option>
                }
            </select>
        </div>

        <div class="sem-thumbs" style="grid-template-columns:repeat(auto-fill,minmax(52px,1fr))">
            @foreach (var file in EmblemFiles)
            {
                var name = System.IO.Path.GetFileNameWithoutExtension(file);

                <button type="button"
                        class="sem-thumb-option @(file == Design.Flag.Icon.File && EmblemCategory == Design.Flag.Icon.Category ? "selected" : null)"
                        title="@name"
                        @onclick="() => SetEmblem(file)">
                    <img class="sem-thumb"
                         src="@Session.Data.AssetUrl($"flags/{EmblemCategory}/{name}.png")"
                         alt="@name" loading="lazy" />
                </button>
            }
        </div>
    </div>

    <div>
        <div class="sem-panel">
            <h3>Room</h3>
            <p class="sem-hint">The game gives these no names, so they are shown as they look.</p>

            <div class="sem-thumbs">
                @foreach (var room in Session.Data.Database.Rooms)
                {
                    <button type="button"
                            class="sem-thumb-option @(room.Key == Design.Room ? "selected" : null)"
                            @onclick="() => Session.Edit(d => d.Room = room.Key)">
                        @if (room.Image is not null)
                        {
                            <img class="sem-thumb" src="@Session.Data.AssetUrl(room.Image)" alt="@room.Key" loading="lazy" />
                        }
                        <span class="caption">@Localizer.Prettify(room.Key.Replace("_room", string.Empty, StringComparison.Ordinal))</span>
                    </button>
                }
            </div>
        </div>

        <div class="sem-panel">
            <h3>Ships and cities</h3>

            <div class="sem-field">
                <label for="ship-set">Ship appearance</label>
                <select id="ship-set" @onchange="e => Session.Edit(d => d.GraphicalCulture = e.Value?.ToString())">
                    @foreach (var culture in ShipSets)
                    {
                        <option value="@culture.Key" selected="@(culture.Key == Design.GraphicalCulture)">
                            @Localizer.Prettify(culture.Key)
                        </option>
                    }
                </select>
            </div>

            <div class="sem-field">
                <label for="city-set">City appearance</label>
                <select id="city-set" @onchange="e => Session.Edit(d => d.CityGraphicalCulture = e.Value?.ToString())">
                    @foreach (var culture in CitySets)
                    {
                        <option value="@culture.Key" selected="@(culture.Key == Design.CityGraphicalCulture)">
                            @Localizer.Prettify(culture.Key)
                        </option>
                    }
                </select>
            </div>

            @if (CityPreview is { } preview)
            {
                <img class="sem-thumb" src="@Session.Data.AssetUrl(preview)" alt="City appearance" loading="lazy" />
            }

            <div class="sem-field" style="margin-top:12px">
                <label for="ship-prefix">Fleet prefix</label>
                <input id="ship-prefix" type="text" value="@Design.ShipPrefix.Key"
                       @onchange="e => Session.Edit(d => d.ShipPrefix.SetLiteral(e.Value?.ToString() ?? string.Empty))" />
            </div>
        </div>

        <div class="sem-panel">
            <h3>Advisor</h3>

            <div class="sem-options">
                @foreach (var voice in Voices)
                {
                    <OptionCard Name="@Session.Localizer.Text(voice.NameKey, Localizer.Prettify(voice.Key))"
                                Icon="@voice.Icon"
                                Selected="@(voice.Key == Design.AdvisorVoiceType)"
                                OnSelect="() => Session.Edit(d => d.AdvisorVoiceType = voice.Key)" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private string? _emblemCategory;

    private string EmblemCategory =>
        _emblemCategory ?? Design.Flag.Icon.Category ?? EmblemCategories.FirstOrDefault()?.Key ?? "pointy";

    private IReadOnlyList<FlagCategoryDefinition> EmblemCategories =>
        [.. Session.Data.Database.FlagCategories.Where(c => !c.IsBackground)];

    private IReadOnlyList<string> EmblemFiles =>
        Session.Data.Database.FlagCategories.FirstOrDefault(c => c.Key == EmblemCategory)?.Files ?? [];

    private IReadOnlyList<string> BackgroundFiles =>
        Session.Data.Database.FlagCategories.FirstOrDefault(c => c.IsBackground)?.Files ?? [];

    private IEnumerable<GraphicalCultureDefinition> ShipSets =>
        Session.Data.Database.GraphicalCultures
            .Where(c => Session.Rules.Database.GraphicalCultures.Contains(c))
            .Where(c => IsSelectable(c))
            .OrderBy(c => c.Key, StringComparer.Ordinal);

    private IEnumerable<GraphicalCultureDefinition> CitySets =>
        ShipSets.Where(c => c.HasCityArt);

    private string? CityPreview =>
        Session.Data.Database.GraphicalCultures
            .FirstOrDefault(c => c.Key == Design.CityGraphicalCulture)?.CityPreview;

    private IEnumerable<AdvisorVoiceDefinition> Voices => Session.Data.Database.AdvisorVoices;

    private bool IsSelectable(GraphicalCultureDefinition culture) =>
        new RequirementEvaluator().IsSatisfied(culture.Selectable, Session.Context!);

    private string ColorLabel(int slot) => slot switch
    {
        0 => "Primary",
        1 => "Secondary",
        2 => "Emblem",
        _ => "Spare",
    };

    private string? ColorAt(int slot)
    {
        var colors = Design.Flag.Colors;
        return slot < colors.Count && colors[slot] != EmpireFlag.EmptyColor ? colors[slot] : null;
    }

    private void SetColor(int slot, string? value)
    {
        Session.Edit(d =>
        {
            var colors = d.Flag.Colors.ToList();
            while (colors.Count < EmpireFlag.ColorSlots)
            {
                colors.Add(EmpireFlag.EmptyColor);
            }

            colors[slot] = string.IsNullOrEmpty(value) ? EmpireFlag.EmptyColor : value;
            d.Flag.SetColors(colors);
        });
    }

    private void SetBackground(string? file)
    {
        if (file is null)
        {
            return;
        }

        Session.Edit(d =>
        {
            d.Flag.Background.Category = "backgrounds";
            d.Flag.Background.File = file;
        });
    }

    private void SetEmblem(string file)
    {
        var category = EmblemCategory;

        Session.Edit(d =>
        {
            d.Flag.Icon.Category = category;
            d.Flag.Icon.File = file;
        });
    }
}
