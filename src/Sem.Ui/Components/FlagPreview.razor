@*
    An empire flag, drawn from its parts.

    The background is a greyscale shape and the emblem is a transparent stencil, so both are used
    as masks over flat colour: the shape by its brightness, the emblem by its transparency. That
    is exactly what the game does with them, and the browser can do it without any script, which
    matters when a list shows dozens of flags at once.
*@

<div class="sem-flag @Class" style="@RootStyle" title="@Title">
    @if (BackgroundUrl is not null)
    {
        <div class="layer" style="background:@Primary; -webkit-mask-image:url('@BackgroundUrl'); mask-image:url('@BackgroundUrl'); -webkit-mask-mode:luminance; mask-mode:luminance;"></div>
    }

    @if (EmblemUrl is not null)
    {
        <div class="layer" style="background:@Emblem; -webkit-mask-image:url('@EmblemUrl'); mask-image:url('@EmblemUrl');"></div>
    }
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The flag to draw.</summary>
    [Parameter, EditorRequired]
    public required EmpireFlag Flag { get; set; }

    /// <summary>Extra classes for sizing.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Tooltip text.</summary>
    [Parameter]
    public string? Title { get; set; }

    private IReadOnlyDictionary<string, FlagColorDefinition> Palette =>
        _palette ??= Session.Data.Database.FlagColors.ToDictionary(c => c.Key, StringComparer.Ordinal);

    private IReadOnlyDictionary<string, FlagColorDefinition>? _palette;

    /// <summary>The base colour, which the background's dark areas take.</summary>
    private string Secondary => Css(FlagComposer.Resolve(Flag.Colors, 1, Palette)) ?? "#1b1b1b";

    /// <summary>The colour the background's bright areas take.</summary>
    private string Primary => Css(FlagComposer.Resolve(Flag.Colors, 0, Palette)) ?? "#808080";

    /// <summary>The emblem's colour, falling back to the primary for a two-colour scheme.</summary>
    private string Emblem =>
        Css(FlagComposer.Resolve(Flag.Colors, 2, Palette)) ?? Primary;

    private string RootStyle => $"background:{Secondary}";

    private string? BackgroundUrl => Url(Flag.Background.Category, Flag.Background.File);

    private string? EmblemUrl => Url(Flag.Icon.Category, Flag.Icon.File);

    private string? Url(string? category, string? file)
    {
        if (string.IsNullOrEmpty(category) || string.IsNullOrEmpty(file))
        {
            return null;
        }

        // The database records the source file names; the extracted images are PNG.
        var name = System.IO.Path.GetFileNameWithoutExtension(file);
        return Session.Data.AssetUrl($"flags/{category}/{name}.png");
    }

    private static string? Css((byte R, byte G, byte B)? color) =>
        color is { } c ? $"rgb({c.R},{c.G},{c.B})" : null;
}
