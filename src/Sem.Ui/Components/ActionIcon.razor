@*
    The handful of glyphs the interface needs for itself.

    Drawn here rather than fetched. Everything else in this app that shows a picture is showing the
    game's artwork, and these are not that: they are save, share and delete, which the game has no
    icons for. Inline so the page asks for nothing — the site is served from GitHub Pages with no
    control over what it may request — and stroked in currentColor so a disabled button and a
    dangerous one colour their own glyph without a second copy of it.

    Sized in em, so a button's font size decides how big its icon is.
*@

<svg class="sem-action-icon" viewBox="0 0 24 24" width="1.15em" height="1.15em"
     fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "save":
            @* A disk: the shape everything still means "save" by. *@
            <path d="M5 3h11l3 3v15H5z" />
            <path d="M8 3v6h7V3" />
            <path d="M8 14h8v7H8z" />
            break;

        case "share":
            @* Two links of a chain, for a thing that becomes an address. *@
            <path d="M10 14a4 4 0 0 0 6 .5l2.5-2.5a4 4 0 0 0-5.7-5.7L11.5 7.5" />
            <path d="M14 10a4 4 0 0 0-6-.5L5.5 12a4 4 0 0 0 5.7 5.7l1.3-1.3" />
            break;

        case "delete":
            @* A bin, with the lid raised so the shape reads at sixteen pixels. *@
            <path d="M4 7h16" />
            <path d="M9 7V4h6v3" />
            <path d="M6 7l1 13h10l1-13" />
            <path d="M10 11v6M14 11v6" />
            break;

        case "revert":
            @* An arrow turning back on itself. *@
            <path d="M4 9h9a5 5 0 0 1 0 10h-6" />
            <path d="M7 5 3 9l4 4" />
            break;

        case "edit":
            @* A pencil laid across the tile, nib to the lower left. *@
            <path d="M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16z" />
            <path d="M14 6l4 4" />
            break;

        case "duplicate":
            @* Two sheets, the second offset behind the first. *@
            <path d="M9 9h10v12H9z" />
            <path d="M15 5H5v12" />
            break;

        case "lite":
            @* One large pane over two small ones: the card, which is one thing to read. *@
            <path d="M4 4h16v9H4z" />
            <path d="M4 17h7v3H4zM13 17h7v3h-7z" />
            break;

        case "advanced":
            @* A stack of rows: the sections, which are a list of them. *@
            <path d="M4 5h16M4 10h16M4 15h16M4 20h16" />
            break;

        case "close":
            @* A cross, for the corner of a dialog. *@
            <path d="M6 6l12 12M18 6L6 18" />
            break;

        case "edit-pencil":
            @* The pencil again, small, for the hint that a thing on the card can be pressed. *@
            <path d="M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16z" />
            break;
    }
</svg>

@code {
    /// <summary>
    /// Which glyph: <c>save</c>, <c>share</c>, <c>delete</c>, <c>revert</c>, <c>edit</c>,
    /// <c>duplicate</c>, <c>close</c>, <c>edit-pencil</c>, <c>lite</c> or <c>advanced</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public required string Name { get; set; }
}
