@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    The empire's flag: its colours, the pattern behind them, and the emblem over them.

    Its own panel rather than a quarter of one called "Appearance", which is how the game has it —
    the flag is a tab of its own in the game's editor, beside the room and the ships rather than
    inside a drawer with them.
*@

<div class="sem-row top">
    <FlagPreview Flag="@Design.Flag" Class="large" />

    @*
        Two colours, of the four the file stores.

        A background is three shapes packed into one file's red, green and blue channels, each tinted
        with one of the first three colours - but across all sixty-three the game ships, the
        brightest pixel in any blue channel is 11 of 255. Nothing is drawn there, so the third colour
        cannot change a flag, and it is not offered as though it could: it is the empire's colour on
        the galaxy map and it is edited with the empire's own settings. The fourth does nothing at
        all - the shader line for it is commented out, and three hundred and one of the three
        hundred and three colour blocks the game ships leave it empty.

        The same arrangement as the two pickers below, and for the same reason: two palettes of
        seventy-two side by side where there is room for them, and one at a time behind a pair of
        tabs where there is not. Beside the flag while the row is wide enough for both, and under it
        when it is not - which is what a phone gets, where the pair sitting in a column beside a
        160px picture had a palette narrower than one swatch and pushed the dialog sideways.

        It was a fold, which answered the height and not the width. Nothing is folded now: the tab
        you are not on says which colour is set in it, and draws it.
    *@
    <div class="sem-pickers colors three">
        <PickerTabs Label="Flag colours" Selected="_slot" SelectedChanged="s => _slot = s"
                    Tabs="ColorTabs" />

        @for (var at = 0; at < EditableColorSlots; at++)
        {
            var slot = at;

            <section class="sem-picker @(_slot == slot ? null : "away")">
                <PickerHead Tab="ColorTabs[slot]" />

                <div class="sem-swatches">
                    @foreach (var color in Session.Data.Database.FlagColors)
                    {
                        <button type="button"
                                class="sem-swatch @(color.Key == ColorAt(slot) ? "selected" : null)"
                                style="background:@Swatch(color)"
                                title="@Localizer.Prettify(color.Key)"
                                @onclick="() => SetColor(slot, color.Key)"></button>
                    }
                </div>
            </section>
        }
    </div>
</div>

@*
    The two halves of a flag: side by side where there is room for both, and one at a time behind a
    pair of tabs where there is not.

    They used to stack instead of tabbing, which is the arrangement that was never worth it — two
    boxes of pictures under a picture is a section taller than the window it opens in, and in a
    dialog that was the only arrangement there was ever room for.

    Nothing is lost by showing one. Picking a pattern and picking an emblem are two halves of one
    decision, and the answer to both is the flag drawn above, which does not move. So the narrow
    arrangement gives its list the whole width, and the tab you are not on says what it holds.
*@
<div class="sem-pickers">
    <PickerTabs Label="Flag" Selected="_tab" SelectedChanged="Show" Tabs="Tabs" />

    @*
        Patterns as pictures, drawn in the empire's own colours. The pattern files themselves cannot
        be shown — each is three shapes packed into a red, a green and a blue channel and reads as
        coloured wedges — so each tile is the flag that pattern would make.
    *@
    <section class="sem-picker @(_tab == PatternList ? null : "away")">
        <PickerHead Tab="Tabs[PatternList]" />

        <div class="sem-scroll-list">
            <div class="sem-thumbs sem-patterns">
                @foreach (var file in BackgroundFiles)
                {
                    <button type="button"
                            class="sem-thumb-option @(file == Design.Flag.Background.File ? "selected" : null)"
                            aria-pressed="@(file == Design.Flag.Background.File ? "true" : "false")"
                            title="@System.IO.Path.GetFileNameWithoutExtension(file)"
                            @onclick="() => SetBackground(file)">
                        <FlagPreview Flag="@Design.Flag" BackgroundFile="@file" HideEmblem="true" />
                    </button>
                }
            </div>
        </div>
    </section>

    @*
        Every emblem the game has, in one box, with each category named where it begins.

        They used to come a category at a time from a dropdown, which is how the game's own editor
        does it — but the game has a panel the size of the screen and this has a column of one.
        Picking an emblem is looking for one, and eighteen categories behind a control that shows one
        at a time is eighteen things to open before you have seen what there is. Two hundred and
        eighty-three tiles is a great deal to put on a page and nothing at all to put in a box that
        scrolls.
    *@
    <section class="sem-picker @(_tab == EmblemList ? null : "away")">
        <PickerHead Tab="Tabs[EmblemList]" />

        @*
            The game's own categories first, then the three its designer never draws. Kept apart for
            the same reason the rooms are: a design may name any of them and the game accepts it —
            its own scripts hand these emblems out by writing exactly this category and file — but
            choosing one is stepping outside what the designer offers, and should look like it.
        *@
        <div class="sem-scroll-list" @ref="_emblems">
            @Emblems(OfferedEmblems)

            @if (UnlistedEmblems.Count > 0)
            {
                <h5 class="sem-subhead apart">Emblems the game does not offer</h5>

                @Emblems(UnlistedEmblems)
            }
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private const int PatternList = 0;
    private const int EmblemList = 1;

    /// <summary>Which of the two lists is on show.</summary>
    /// <remarks>
    /// The patterns, to begin with, which is the order the game asks for them in and the order they
    /// go on the flag. Not remembered between openings: the tab you last used is a poor guess at
    /// the one you came back for, and both are one press away.
    /// </remarks>
    private int _tab = PatternList;

    /// <summary>
    /// The two lists, named and with what each holds, for the tabs and the headings alike.
    /// </summary>
    /// <remarks>
    /// One source for both, because both are drawn every render and only the stylesheet decides
    /// which is on the page. Two copies of these words would be two places for them to drift.
    /// </remarks>
    private PickerTabs.Tab[] Tabs =>
    [
        new(Session.Localizer.Label("EMBLEM_BACKGROUND_PATTERN", "Patterns"), PatternName),
        new(Session.Localizer.Label("CHOOSE_SYMBOL", "Choose Symbol"), EmblemName),
    ];

    /// <summary>The scrolling box of emblems, so the chosen one can be brought into it.</summary>
    private ElementReference _emblems;

    /// <summary>
    /// The script module, imported once however many callers ask for it at once.
    /// </summary>
    /// <remarks>
    /// Held as the task rather than its result. Written as <c>_module ??= await Import()</c> the
    /// check and the assignment sat either side of an await, so a second caller arriving during the
    /// import started another - and the reference the loser assigned was overwritten and never
    /// released. Holding the task closes that without a lock: nothing can yield between the test
    /// and the store.
    /// </remarks>
    private Task<IJSObjectReference>? _module;

    /// <summary>
    /// Opens the emblems on the one the design already has, where both lists are on show at once.
    /// </summary>
    /// <remarks>
    /// Where they are not, the emblems are not drawn and there is nothing to scroll — the call
    /// measures zeroes and moves nothing, and switching to that tab does the work instead. Cheaper
    /// than asking the page which arrangement the stylesheet settled on.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Reveal().ConfigureAwait(true);
        }
    }

    /// <summary>
    /// Shows one of the two lists, and opens the emblems on the one the design already has.
    /// </summary>
    /// <remarks>
    /// Two hundred and eighty-three of them under eighteen headings: without this the box opens on
    /// the first category every time, and the emblem the empire actually wears is somewhere below.
    /// A list that is not on show is not drawn, so it has no height to scroll and forgets where it
    /// was — which is why this is here rather than done once when the tab is built.
    ///
    /// The patterns need none of it. There are forty and they fit.
    /// </remarks>
    private async Task Show(int tab)
    {
        _tab = tab;

        if (tab == EmblemList)
        {
            // After the browser has drawn it, or there is still nothing to measure.
            await Task.Yield();
            await Reveal().ConfigureAwait(true);
        }
    }

    private async Task Reveal()
    {
        // Guarded because this runs after a render and the page may already have gone - navigating
        // away mid-render otherwise surfaced as an unhandled error. Every DisposeAsync in the app
        // catches this; the two Reveal calls did not.
        try
        {
            var module = await (_module ??= Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sem.Ui/sem.js").AsTask()).ConfigureAwait(true);

            await module.InvokeVoidAsync("revealSelected", _emblems, ".sem-thumb-option.selected")
                .ConfigureAwait(true);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there was nothing left to scroll.
        }
    }

    /// <summary>Releases the script reference when the section closes, as the room picker does.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await (await _module.ConfigureAwait(false)).DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
        catch (JSException)
        {
            // The import never succeeded, so it left nothing to release. Reachable only now
            // that the task is what is held: a failed import used to leave the field null.
        }
    }

    private RenderFragment Emblems(IReadOnlyList<FlagCategoryDefinition> categories) =>
        @<text>
            @foreach (var category in categories)
            {
                <h5 class="sem-subhead">@CategoryName(category)</h5>

                <div class="sem-thumbs emblems">
                    @foreach (var file in category.Files)
                    {
                        var name = System.IO.Path.GetFileNameWithoutExtension(file);
                        var chosen = file == Design.Flag.Icon.File && category.Key == Design.Flag.Icon.Category;

                        <button type="button"
                                class="sem-thumb-option @(chosen ? "selected" : null)"
                                aria-pressed="@(chosen ? "true" : "false")"
                                title="@name"
                                @onclick="() => SetEmblem(category.Key, file)">
                            <img class="sem-thumb"
                                 src="@Session.Data.AssetUrl($"flags/{category.Key}/{name}.png")"
                                 alt="@name" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </text>;

    /// <summary>The emblem categories the game's own designer lists.</summary>
    private IReadOnlyList<FlagCategoryDefinition> OfferedEmblems =>
        [.. Session.Data.Database.FlagCategories.Where(c => !c.IsBackground && c.IsOffered)];

    /// <summary>
    /// The three it hides: the enclaves, the pre-FTL ages, and the special emblems.
    /// </summary>
    /// <remarks>
    /// Turned off by <c>show_in_designer = no</c> in the category's own <c>usage.txt</c>, which
    /// governs what the designer draws and nothing else. Checked in game before being offered here.
    /// </remarks>
    private IReadOnlyList<FlagCategoryDefinition> UnlistedEmblems =>
        [.. Session.Data.Database.FlagCategories.Where(c => !c.IsBackground && !c.IsOffered)];

    /// <summary>
    /// What to head a category with.
    /// </summary>
    /// <remarks>
    /// The game builds these names from the folder name and ships none for the categories it never
    /// draws, so those have no string to find. Prettifying the folder name covers two of the three;
    /// the third would read "Pre Ftl", which is nobody's name for it.
    /// </remarks>
    private string CategoryName(FlagCategoryDefinition category) =>
        Session.Localizer.Text(category.NameKey, string.Empty) is { Length: > 0 } named
            ? named
            : category.Key switch
            {
                "pre_ftl" => "Pre-FTL",
                var key => Localizer.Prettify(key),
            };

    /// <summary>What a folded box says is chosen inside it.</summary>
    private string EmblemName =>
        Design.Flag.Icon.File is { Length: > 0 } file
            ? Localizer.Prettify(System.IO.Path.GetFileNameWithoutExtension(file))
            : "Not set";

    private string PatternName =>
        Design.Flag.Background.File is { Length: > 0 } file
            ? Localizer.Prettify(System.IO.Path.GetFileNameWithoutExtension(file))
            : "Not set";

    private IReadOnlyList<string> BackgroundFiles =>
        Session.Data.Database.FlagCategories.FirstOrDefault(c => c.IsBackground)?.Files ?? [];

    /// <summary>
    /// How many colours a flag actually has, which is the first two.
    /// </summary>
    /// <remarks>
    /// Three of the six, and they are the three the flag is drawn from: the background is one file
    /// whose red, green and blue channels each hold a shape, and each channel is tinted with one of
    /// these. The other three belong to the fleet and the galaxy map and are edited where those are.
    /// All six are preserved whichever is being changed - every write goes through the whole slot
    /// list, so setting a flag colour carries the rest through as they were.
    ///
    /// The tertiary draws nothing on any background the game currently ships, since the brightest
    /// pixel in any blue channel across all sixty-three of them is 11 of 255. It is offered anyway:
    /// it is a flag colour by the game's own reckoning, the game keeps a name for it
    /// (TERTIARY_COLOR) and a picker for it that is commented out rather than deleted, and it is
    /// what the map falls back to for its fill when the secondary sits too close to the primary.
    /// </remarks>
    private const int EditableColorSlots = 3;

    /// <summary>
    /// What each colour slot is called on its tab.
    /// </summary>
    /// <remarks>
    /// One word each, rather than the game's own "Primary Flag Color" and "Secondary Flag Color".
    /// The game says those on buttons stacked down a column, where their length costs nothing; these
    /// are three tabs side by side, and a title is deliberately the one part of a tab that will not
    /// shrink - so three of the long form could not fit a 375px screen and put a horizontal
    /// scrollbar on the dialog.
    ///
    /// The same shortening the map colours already use, where the game's "Map Border Color" is a tab
    /// headed Border. Nothing is lost: the panel above says these are the flag's colours, and every
    /// swatch names itself on hover.
    /// </remarks>
    private static string ColorLabel(int slot) => slot switch
    {
        EmpireFlag.PrimarySlot => "Primary",
        EmpireFlag.SecondarySlot => "Secondary",
        EmpireFlag.TertiarySlot => "Tertiary",
        _ => string.Empty,
    };

    /// <summary>
    /// A swatch, in the colour the flag would actually be.
    /// </summary>
    /// <remarks>
    /// The game keeps two colours against every name - one for a flag and one for the map - and
    /// these are flags, so they are the flag's. The map's are drawn in the map colour, beside the
    /// setting that uses them.
    /// </remarks>
    private static string Swatch(FlagColorDefinition color) =>
        $"rgb({color.Red},{color.Green},{color.Blue})";

    /// <summary>The palette on show, where there is only room for one.</summary>
    /// <remarks>
    /// The primary, to begin with, which is the order the file writes them in and the order the
    /// game's own editor offers them. Not remembered between openings, for the reason the pattern
    /// and emblem tabs are not.
    /// </remarks>
    private int _slot;

    /// <summary>The three palettes, named and with the colour each holds, for tabs and heads alike.</summary>
    private PickerTabs.Tab[] ColorTabs =>
    [
        .. Enumerable.Range(0, EditableColorSlots)
            .Select(slot => new PickerTabs.Tab(ColorLabel(slot), ColorName(slot), Shown(slot)))
    ];

    /// <summary>What a slot is set to, named the way the swatches name themselves.</summary>
    private string ColorName(int slot) =>
        ColorAt(slot) is { Length: > 0 } key ? Localizer.Prettify(key) : "Not set";

    /// <summary>The colour a slot is set to, as CSS, for the dot beside its name.</summary>
    private string? Shown(int slot) =>
        ColorAt(slot) is { } key &&
        Session.Data.Database.FlagColor(key) is { } color
            ? Swatch(color)
            : null;

    private string? ColorAt(int slot)
    {
        var colors = Design.Flag.Colors;
        return slot < colors.Count && colors[slot] != EmpireFlag.EmptyColor ? colors[slot] : null;
    }

    private void SetColor(int slot, string? value) =>
        Session.Edit(d => d.Flag.SetColor(slot, value));

    private void SetBackground(string? file)
    {
        if (file is null)
        {
            return;
        }

        Session.Edit(d =>
        {
            d.Flag.Background.Category = "backgrounds";
            d.Flag.Background.File = file;
        });
    }

    private void SetEmblem(string category, string file) =>
        Session.Edit(d =>
        {
            d.Flag.Icon.Category = category;
            d.Flag.Icon.File = file;
        });
}
