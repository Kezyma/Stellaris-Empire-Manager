@*
    Authority and civics. The government's name is not chosen: the game works it out from these
    and the empire's ethics, so it is shown rather than offered.
*@

<div class="sem-columns">
    <div>
        <div class="sem-panel">
            <h3>Authority</h3>

            <div class="sem-options">
                @foreach (var option in Session.Rules.GetAuthorityOptions(Context).Where(o => o.Visible))
                {
                    <OptionCard Name="@Session.Localizer.Text(option.Key)"
                                Description="@Session.Localizer.Text($"{option.Key}_tt", string.Empty)"
                                Icon="@IconFor(option.Key)"
                                Selected="@(option.Key == Design.Authority)"
                                Enabled="@option.Enabled"
                                Reasons="@Explain(option.Reasons)"
                                OnSelect="() => Session.Edit(d => d.Authority = option.Key)" />
                }
            </div>
        </div>

        <div class="sem-panel">
            <h3>Government</h3>

            @if (Government is { } government)
            {
                <p><strong>@Session.Localizer.Text(government.Key)</strong></p>

                @if (government.RulerTitleKey is { } title)
                {
                    <p class="sem-hint">Ruler is styled @Session.Localizer.Text(title).</p>
                }
            }
            else
            {
                <p class="sem-hint">No government fits this combination yet.</p>
            }

            <p class="sem-hint">
                The game names a government after the authority, ethics and civics an empire holds,
                so this changes as those do.
            </p>
        </div>
    </div>

    <div class="sem-panel">
        <h3>Civics</h3>

        <BudgetBar Label="Civics" Value="@Session.Rules.GetCivicsBudget(Context)" />

        <div class="sem-options">
            @foreach (var option in Civics)
            {
                <OptionCard Name="@Session.Localizer.Text(option.Key)"
                            Description="@Description(option.Key)"
                            Icon="@CivicIcon(option.Key)"
                            Selected="@Design.Civics.Contains(option.Key)"
                            Enabled="@option.Enabled"
                            Reasons="@Explain(option.Reasons)"
                            OnSelect="() => Toggle(option.Key)" />
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private DesignContext Context => Session.Context!;

    private GovernmentTypeDefinition? Government => Session.Rules.DeriveGovernment(Context);

    private IEnumerable<OptionState> Civics =>
        Session.Rules.GetCivicOptions(Context)
            .Where(o => o.Visible)
            .OrderBy(o => Session.Localizer.Text(o.Key), StringComparer.CurrentCulture);

    private string? IconFor(string key) =>
        Session.Data.Database.Authorities.FirstOrDefault(a => a.Key == key)?.Icon;

    private string? CivicIcon(string key) =>
        Session.Data.Database.Civics.FirstOrDefault(c => c.Key == key)?.Icon;

    private string Description(string key)
    {
        var civic = Session.Data.Database.Civics.FirstOrDefault(c => c.Key == key);
        return Session.Localizer.Text(civic?.EffectsKey ?? $"{key}_desc", string.Empty);
    }

    private IReadOnlyList<string> Explain(IReadOnlyList<string> reasons) => Session.Reasons.Describe(reasons);

    private void Toggle(string key)
    {
        Session.Edit(d =>
        {
            var civics = d.Civics.ToList();

            if (!civics.Remove(key))
            {
                // The allowance is fixed, so choosing a third replaces the oldest rather than
                // leaving the player to clear one first.
                if (civics.Count >= Session.Data.Database.Defines.CivicPoints)
                {
                    civics.RemoveAt(0);
                }

                civics.Add(key);
            }

            d.SetCivics(civics);
        });
    }
}
