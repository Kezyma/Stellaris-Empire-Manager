@*
    An empire's politics: what it believes, how it is run, and what it does with the room that
    leaves. The government's name is not chosen — the game works it out from all three — so it is
    shown in the preview rather than given a panel of its own here.
*@

<div class="sem-subsections">
    <section>
        <h4>@Session.Localizer.Label("ETHICS", "Ethics")</h4>

        <EthicsSection />
    </section>

    <section>
        <h4>@Session.Localizer.Label("GOVERNMENT_AUTHORITY_AND_TYPE", "Authority and Type")</h4>

        @*
            As short as the ethics above it. There are eight authorities and the nomad toggle, which
            is a row or two of icons — a panel four hundred deep to describe them left most of
            itself empty.
        *@
        <OptionGrid Options="@Authorities"
                    DetailHeight="178"
                    EmptyHint="Hover an authority to see how it governs."
                    OnSelect="key => Session.Edit(d => d.Authority = key)">
            <Aside>
                @*
                    Nomadic is not an authority, but the game puts it beside them and it belongs
                    there: it changes what an empire may govern with, ruling out a good many
                    civics on its own. Beside the grid rather than in it, as the game also has
                    it — a container of its own next to the authorities, so that it does not
                    read as one more of them — and an icon rather than a labelled row, which
                    read as a section.
                *@
                <button type="button"
                        class="sem-icon-option sem-nomad @(Design.IsNomadic == true ? "selected" : null)"
                        title="@NomadicLabel"
                        aria-pressed="@(Design.IsNomadic == true)"
                        @onclick="() => Session.Edit(d => d.IsNomadic = d.IsNomadic != true)">

                    @if (Session.Data.Database.Icons.GetValueOrDefault(NomadSprite) is { Length: > 0 } icon)
                    {
                        <img src="@Session.Data.AssetUrl(icon)" alt="@NomadicLabel">
                    }
                    else
                    {
                        <span class="initials">@NomadicLabel</span>
                    }
                </button>
            </Aside>
        </OptionGrid>
    </section>

    <section>
        <h4>@Session.Localizer.Heading("CIVICS_LABEL", "Civics")</h4>

        <BudgetBar Key="POINTS_LEFT_CIVICS" Fallback="Civic Picks Left: $POINTS|H$"
                   Label="CIVICS_LABEL" LabelFallback="Civics" Value="@Session.Rules.GetCivicsBudget(Context)" />

        <OptionGrid Options="@Civics"
                    EmptyHint="Hover a civic to see what it changes."
                    OnSelect="Toggle" />
    </section>
</div>

@code {
    /// <summary>The sprite the game's own nomad toggle wears.</summary>
    private const string NomadSprite = "GFX_toggle_nomad";

    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private string NomadicLabel => Session.Localizer.Text("IS_NOMADIC", "Is a Nomadic Empire");

    private DesignContext Context => Session.Context!;

    private IReadOnlyList<OptionGrid.GridOption> Authorities
    {
        get
        {
            var byKey = Session.Data.Database.Authorities.ToDictionary(a => a.Key, StringComparer.Ordinal);

            return GridOptions.Build(
                Session,
                Session.Rules.GetAuthorityOptions(Context),
                key => (byKey.GetValueOrDefault(key)?.Icon, byKey.GetValueOrDefault(key)?.Effects),
                key => key == Design.Authority);
        }
    }

    private IReadOnlyList<OptionGrid.GridOption> Civics
    {
        get
        {
            var byKey = Session.Data.Database.Civics.ToDictionary(c => c.Key, StringComparer.Ordinal);

            var states = Session.Rules.GetCivicOptions(Context)
                .OrderBy(o => Session.Localizer.Text(o.Key), StringComparer.CurrentCulture);

            return GridOptions.Build(
                Session,
                states,
                key => (byKey.GetValueOrDefault(key)?.Icon, byKey.GetValueOrDefault(key)?.Effects),
                Design.Civics.Contains);
        }
    }

    private void Toggle(string key)
    {
        Session.Edit(d =>
        {
            var civics = d.Civics.ToList();

            if (!civics.Remove(key))
            {
                // The allowance is fixed, so choosing a third replaces the oldest rather than
                // leaving the player to clear one first.
                if (civics.Count >= Session.Data.Database.Defines.CivicPoints)
                {
                    civics.RemoveAt(0);
                }

                civics.Add(key);
            }

            d.SetCivics(civics);
        });
    }
}
