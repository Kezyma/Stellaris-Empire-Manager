@*
    Which content packs to judge availability against, as a row of the game's own icons.

    A page of its own was the wrong shape for this. It is not a setting a player sets once and
    forgets: it decides half of what the designer will offer, so it belongs where the designer is,
    and clicking a pack should visibly change the lists a moment later.

    The desktop app knows the answer from the installation it read. The web app cannot, so it starts
    with everything on and lets the player turn off what they do not own.
*@

@*
    Folded away on a phone, where thirty icons wrap to four rows and take a fifth of the screen above
    every page. A checkbox and its label rather than component state or a <details>: it needs no
    script, it works before the app has loaded, and there is no portable way to force a <details>
    open again at the width where this should simply be a bar. Above the breakpoint the toggle is not
    drawn at all and the bar is exactly what it was.
*@
<input type="checkbox" id="dlc-bar" class="sem-dlc-toggle" />
<label for="dlc-bar" class="sem-dlc-summary">
    <span class="chevron" aria-hidden="true">▸</span>
    <span>@Summary</span>
</label>

<div class="sem-dlc-bar">
    @foreach (var pack in Packs)
    {
        var owned = Session.OwnedDlc.Contains(pack.Name);

        <button type="button"
                class="sem-dlc @(owned ? "on" : "off")"
                title="@Name(pack)"
                aria-pressed="@owned"
                @onclick="() => Session.ToggleDlc(pack.Name, !owned)">

            @if (pack.Icon is { Length: > 0 } icon)
            {
                <img src="@Session.Data.AssetUrl(icon)" alt="@Name(pack)" loading="lazy">
            }
            else
            {
                <span class="initials">@Initials(Name(pack))</span>
            }
        </button>
    }

    <span class="spacer"></span>

    <button type="button" class="sem-tab" @onclick="SelectAll">All</button>
    <button type="button" class="sem-tab" @onclick="SelectNone">None</button>

    @*
        The version this was read from, and how much of it went unread. It has to live somewhere, and
        somewhere it is seen occasionally beats a page nobody opens.
    *@
    <span class="sem-hint" title="@Provenance">@Session.Data.Database.GameVersion</span>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>
    /// The packs worth a switch.
    /// </summary>
    /// <remarks>
    /// Eleven of the thirty-six decide nothing an empire is built from — a soundtrack, a set of
    /// forum avatars, and three expansions whose content this designer never reaches. Turning one
    /// off changed nothing on the page, which is a worse thing for a switch to do than to be absent.
    /// </remarks>
    private IEnumerable<DlcDefinition> Packs =>
        Session.Data.Database.Dlc
            .Where(d => d.Decides)
            .OrderBy(d => Name(d), StringComparer.CurrentCulture);

    private string Name(DlcDefinition pack) => Session.Localizer.Text(pack.NameKey, pack.Name);

    /// <summary>
    /// What the folded bar says it is hiding.
    /// </summary>
    /// <remarks>
    /// A row of icons that simply vanishes is worse than a line of text, and the count is the part
    /// worth seeing without opening it: it says whether the designer is judging against everything
    /// or against a subset, which decides half of what it offers.
    /// </remarks>
    private string Summary
    {
        get
        {
            var packs = Packs.ToList();
            var owned = packs.Count(p => Session.OwnedDlc.Contains(p.Name));

            return owned == packs.Count
                ? $"Content packs · all {packs.Count}"
                : $"Content packs · {owned} of {packs.Count}";
        }
    }

    private string Provenance
    {
        get
        {
            var database = Session.Data.Database;
            var unread = database.UnrecognisedTriggers.Count;

            var read =
                $"Read from Stellaris {database.GameVersion} by extractor {database.ExtractorVersion}. " +
                $"{Session.Data.Localisation.Count:N0} pieces of text.";

            return unread == 0
                ? read
                : $"{read} {unread} condition(s) were not understood; options relying on them are " +
                  "offered rather than hidden.";
        }
    }

    /// <summary>A stand-in for a pack the installation has no picture for.</summary>
    private static string Initials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return words.Length switch
        {
            0 => "?",
            1 => words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant(),
            _ => $"{words[0][0]}{words[1][0]}".ToUpperInvariant(),
        };
    }

    private void SelectAll() => Session.SetOwnedDlc(Session.Data.Database.Dlc.Select(d => d.Name));

    private void SelectNone() => Session.SetOwnedDlc([]);
}
