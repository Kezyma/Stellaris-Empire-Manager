@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    Where the empire's leader stands, and what its cities look like from that window.

    The two belong together because the picture makes them one: the city is painted into the world
    seen through the room's window, so choosing a city with no room in view would be choosing blind.
    The game agrees — its own editor has them as two tabs of one panel, headed "City Graphics".

    The scene at the top is every appearance choice at once. The room and the city each come from a
    list of pictures below it, and the world from the homeworld the empire actually starts on, so
    each is chosen against the thing it changes.
*@

<div class="sem-scene">
    <RoomScene Room="@ChosenRoom" World="@Homeworld" City="@ChosenCity" Flag="@Design.Flag"
               Portrait="@RulerPortrait"
               Alt="@Session.Localizer.Name(Design.Name, Design.Key)" />
</div>

@*
    The room and the city: side by side where there is room for both, and one at a time behind a
    pair of tabs where there is not.

    Both lists scroll inside their own box rather than down the page, so the scene above stays on
    screen while they are being picked. Choosing either is choosing what the scene looks like, and
    they are long enough that the scene had scrolled away by the time you reached the one you
    wanted — you were choosing a picture you could not see.

    Which is also why one list is enough where two will not fit. The picture is the point, and the
    room and the city are both in it, so the tab you are not on has nothing to show you that the
    scene is not already showing.
*@
<div class="sem-pickers">
    <PickerTabs Label="Scene" Selected="_tab" SelectedChanged="Show" Tabs="Tabs" />

    <section class="sem-picker @(_tab == RoomList ? null : "away")">
        <PickerHead Tab="Tabs[RoomList]" />

        @*
            Two lists, deliberately apart. The game's own designer offers the first; the second are
            rooms it hands out during play, to a fallen empire or a galactic emperor or a world that
            never left its own atmosphere. A design may name any of them and the game draws it — one
            of the game's own empires sits in an ancient brick room this way — but choosing one is
            stepping outside what the designer offers, and should feel like it.
        *@
        <div class="sem-scroll-list" @ref="_rooms">
            @Rooms(Offered)

            @if (Unlisted.Count > 0)
            {
                <h5 class="sem-subhead">Rooms the game assigns rather than offers</h5>

                @Rooms(Unlisted)
            }
        </div>
    </section>

    <section class="sem-picker @(_tab == CityList ? null : "away")">
        <PickerHead Tab="Tabs[CityList]" />

        <div class="sem-scroll-list" @ref="_cities">
            @*
                A tile for no city at all, first. The dropdown this replaced carried an empty option
                and the reason it carried one still holds: a design may name nothing, and there has
                to be a way back to naming nothing. As a tile rather than as clicking the chosen one
                again, because a control that clears by being pressed twice is a control nobody finds.
            *@
            <div class="sem-thumbs cities">
                <button type="button"
                        class="sem-thumb-option @(ChosenCity is null ? "selected" : null)"
                        aria-pressed="@(ChosenCity is null ? "true" : "false")"
                        @onclick="() => Session.Edit(d => d.CityGraphicalCulture = null)">
                    <span class="sem-thumb none" aria-hidden="true"></span>
                    <span class="caption">@Session.Localizer.Label("NONE", "None")</span>
                </button>

                @foreach (var culture in CitySets)
                {
                    @City(culture)
                }
            </div>

            @*
                The other half of what the empty option was protecting. A design naming a set this
                empire cannot be offered — a turned-off content pack, or one the rules exclude — used
                to match nothing in the list, and a grid with no tile marked would have said the
                design held nothing at all. Shown under a heading of its own, as the rooms the game
                assigns are.
            *@
            @if (ChosenCity is { } held && CitySets.All(c => c.Key != held.Key))
            {
                <h5 class="sem-subhead">Not offered for this empire</h5>

                <div class="sem-thumbs cities">
                    @City(held)
                </div>
            }
        </div>
    </section>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private readonly RequirementEvaluator _evaluator = new();

    private const int RoomList = 0;
    private const int CityList = 1;

    /// <summary>Which of the two lists is on show.</summary>
    /// <remarks>
    /// The room first, which is the larger half of the scene and the half a design always names.
    /// Not remembered between openings, as the flag's tabs are not.
    /// </remarks>
    private int _tab = RoomList;

    /// <summary>
    /// The two lists, named and with what each holds, for the tabs and the headings alike.
    /// </summary>
    /// <remarks>
    /// One source for both, because both are drawn every render and only the stylesheet decides
    /// which is on the page. Two copies of these words would be two places for them to drift.
    /// </remarks>
    private PickerTabs.Tab[] Tabs =>
    [
        new(Session.Localizer.Label("EMPIRE_CREATION_ROOM_APPEARANCE", "Room"), RoomName(Design.Room)),
        new(Session.Localizer.Label("EMPIRE_CREATION_CITY_APPEARANCE", "City"), CityName(ChosenCity)),
    ];

    /// <summary>The scrolling boxes, so the chosen tile in each can be brought into view.</summary>
    private ElementReference _rooms;
    private ElementReference _cities;

    private IJSObjectReference? _module;

    /// <summary>
    /// Opens each list on what the design already has.
    /// </summary>
    /// <remarks>
    /// Once only. Scrolling on every render would drag a list back under anyone reading further
    /// down it, and after the first render the reason to move is a click, which is already in view.
    ///
    /// Both, without asking which arrangement the stylesheet settled on: where only one is on show
    /// the other is not drawn, so the second call measures zeroes and moves nothing, and switching
    /// to that tab does the work instead.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Reveal(_rooms).ConfigureAwait(true);
        await Reveal(_cities).ConfigureAwait(true);
    }

    /// <summary>
    /// Shows one of the two lists, and puts its chosen tile in view now that it has a height.
    /// </summary>
    private async Task Show(int tab)
    {
        _tab = tab;

        // After the browser has drawn it, or there is still nothing to measure.
        await Task.Yield();
        await Reveal(tab == RoomList ? _rooms : _cities).ConfigureAwait(true);
    }

    /// <summary>
    /// Scrolls a list to what is chosen in it.
    /// </summary>
    /// <remarks>
    /// A box that is not on show is not drawn, so it has no height to scroll and forgets where it
    /// was: coming back to it showed the first tile rather than the one the empire has.
    /// </remarks>
    private async Task Reveal(ElementReference list)
    {
        // Guarded because this runs after a render and the page may already have gone - see the same
        // note in FlagTab.
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sem.Ui/sem.js").ConfigureAwait(true);

            await _module.InvokeVoidAsync("revealSelected", list, ".sem-thumb-option.selected")
                .ConfigureAwait(true);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there was nothing left to scroll.
        }
    }

    /// <summary>
    /// Releases the script reference when the section closes.
    /// </summary>
    /// <remarks>
    /// This section is opened and closed repeatedly while an empire is being designed, and every
    /// other interop holder in the project releases its module. This one did not, so each open left
    /// a reference behind on both hosts.
    /// </remarks>
    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
    }

    /// <summary>The rooms the game's own designer lists.</summary>
    private IReadOnlyList<RoomDefinition> Offered =>
        [.. Session.Data.Database.Rooms.Where(r => r.IsOffered)];

    /// <summary>
    /// The rest: rooms the game gives out during play rather than at design time.
    /// </summary>
    /// <remarks>
    /// Their conditions in the room selector are things a designer cannot answer — a fallen empire,
    /// a galactic emperor, a pre-FTL world — and some of them, the pre-FTL rooms among them, name a
    /// country type a player can never be. That does not put them out of reach: the selector decides
    /// what to pick when a design names nothing, and a design that names a room gets that room.
    /// </remarks>
    private IReadOnlyList<RoomDefinition> Unlisted =>
        [.. Session.Data.Database.Rooms.Where(r => !r.IsOffered)];

    private RenderFragment Rooms(IReadOnlyList<RoomDefinition> rooms) =>
        @<div class="sem-thumbs">
            @foreach (var room in rooms)
            {
                <button type="button"
                        class="sem-thumb-option @(room.Key == Design.Room ? "selected" : null)"
                        aria-pressed="@(room.Key == Design.Room ? "true" : "false")"
                        @onclick="() => Session.Edit(d => d.Room = room.Key)">
                    @if (room.Image is not null)
                    {
                        <img class="sem-thumb" src="@Session.Data.AssetUrl(room.Image)" alt="@room.Key" loading="lazy" />
                    }
                    <span class="caption">@RoomName(room.Key)</span>
                </button>
            }
        </div>;

    /// <summary>
    /// One city set as a tile.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The scene above, small: the empire's own world with this city built on it, drawn by the same
    /// <see cref="WorldBackdrop"/> and so band for band the thing that will appear in the window.
    /// It was the game's flat city preview once, which is only the furthest of a city's bands — a
    /// distant skyline covering between half a per cent and four per cent of its frame. Every tile
    /// was the same smudge in a different shape.
    /// </para>
    /// <para>
    /// The bands come to about two hundred and eighty kilobytes for a set and seven megabytes across
    /// the twenty on offer. That is worth saying out loud and it is not much here: the room picker
    /// in this same section is eighteen megabytes across its sixty-six rooms, the tiles load lazily,
    /// and the world underneath is the same handful of pictures on every one of them.
    /// </para>
    /// </remarks>
    private RenderFragment City(GraphicalCultureDefinition culture) =>
        @<button type="button"
                 class="sem-thumb-option @(culture.Key == Design.CityGraphicalCulture ? "selected" : null)"
                 aria-pressed="@(culture.Key == Design.CityGraphicalCulture ? "true" : "false")"
                 @onclick="() => Session.Edit(d => d.CityGraphicalCulture = culture.Key)">
            <span class="sem-thumb">
                @foreach (var layer in WorldBackdrop.Layers(Homeworld, culture, Level))
                {
                    <img src="@Session.Data.AssetUrl(layer)" alt="" loading="lazy" />
                }
            </span>

            <span class="caption">@CityName(culture)</span>
        </button>;

    /// <summary>How built-up the world is drawn, which the scene and the tiles have to agree on.</summary>
    private int Level => Session.Data.Database.Defines.CityPopLevel;

    private static string RoomName(string? key) =>
        key is { Length: > 0 }
            ? Localizer.Prettify(key.Replace("_room", string.Empty, StringComparison.Ordinal))
            : "Not set";

    /// <summary>
    /// What a city set is called, as the shipset picker names the same sets.
    /// </summary>
    /// <remarks>
    /// The key's own words for all but two of them: the game has names for these, but nothing had
    /// asked for one before, so the extraction's pruning of the text file dropped them.
    /// </remarks>
    private string CityName(GraphicalCultureDefinition? culture) =>
        culture is null
            ? Session.Localizer.Label("NONE", "None")
            : Session.Localizer.Text(culture.NameKey, Localizer.Prettify(culture.Key));

    /// <summary>
    /// The sets that dress a city, which is not the same list as the ones that build ships.
    /// </summary>
    /// <remarks>
    /// Solarpunk and Wilderness model no ships at all and belong only here; several shipsets have no
    /// city artwork and belong only in the other list.
    /// </remarks>
    private IEnumerable<GraphicalCultureDefinition> CitySets =>
        Session.Data.Database.GraphicalCultures
            .Where(c => Session.Rules.Database.GraphicalCultures.Contains(c))
            .Where(c => _evaluator.IsSatisfied(c.Selectable, Session.Context!))
            .Where(c => c.HasCityArt)
            .OrderBy(c => c.Key, StringComparer.Ordinal);

    /// <summary>The pieces of the scene at the top: what has been chosen, drawn together.</summary>
    private RoomDefinition? ChosenRoom =>
        Session.Data.Database.Rooms.FirstOrDefault(r => r.Key == Design.Room);

    private GraphicalCultureDefinition? ChosenCity =>
        Session.Data.Database.GraphicalCultures
            .FirstOrDefault(c => c.Key == Design.CityGraphicalCulture);

    /// <summary>
    /// The world the scene looks out on: where the empire actually begins, which an origin can
    /// decide for itself whatever the homeworld picker was left saying.
    /// </summary>
    private PlanetClassDefinition? Homeworld =>
        Session.Data.Database.PlanetClasses
            .FirstOrDefault(p => p.Key == Session.Context!.EffectivePlanetClass);

    private string? RulerPortrait =>
        PortraitArtwork.For(Session.Data.Database, Design.Ruler.Portrait, Design.Ruler.Gender)
        ?? PortraitArtwork.For(Session.Data.Database, Design.Species.Portrait, Design.Species.Gender);
}
