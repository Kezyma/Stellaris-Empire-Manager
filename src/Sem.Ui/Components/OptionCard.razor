@*
    One selectable tile: a picture and a name.

    The advisor voices are the only thing that uses it, and the only thing that ever did in anger.
    It began as the option picker for everything and carried a cost, a description, the reasons it
    could not be chosen and the pack it needed - none of which any caller ever set, because
    OptionGrid and OptionChip took that job and do it better. What is left is what was actually
    wanted here: something to press that shows what it is.
*@

<button type="button"
        class="sem-option @(Selected ? "selected" : null)"
        @onclick="OnSelect">

    <GameIcon Path="@Icon" Alt="@Name" />

    <span class="body">
        <span class="name">@Name</span>
    </span>
</button>

@code {
    /// <summary>The option's display name.</summary>
    [Parameter, EditorRequired]
    public required string Name { get; set; }

    /// <summary>The option's icon in the extracted assets.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>Whether it is currently chosen.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Raised when the option is clicked.</summary>
    [Parameter]
    public EventCallback OnSelect { get; set; }
}
