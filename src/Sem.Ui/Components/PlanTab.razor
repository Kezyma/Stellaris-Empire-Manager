@using Sem.Designs

@*
    How a player means to play this empire, rather than what the empire is.

    Everything else in both editors describes a design the game will read. This does not: the game
    has no notion of a plan and no field to keep one in. It is written as prose into one of the two
    biographies - which the game does keep, and does show the player - so it survives a launch and
    earns the space it takes rather than sitting in the file as text nobody can read.

    Off unless it is asked for. A biography is somewhere a player may have written something of their
    own, and a feature that helped itself to one would be taking something.
*@

<div class="sem-row wide">
    <div class="sem-field flush">
        <label>
            <input type="checkbox" checked="@Planning" disabled="@(!Planning && !AnyFree)"
                   @onchange="TogglePlanning" />
            Enable Plan
        </label>
    </div>

    @if (Planning)
    {
        <div class="sem-field inline">
            <label for="plan-home">Write To</label>

            @*
                Only the ones a plan may have. A biography with writing in it is not offered, so the
                dropdown cannot be used to do what the checkbox refuses to.
            *@
            <select id="plan-home" value="@Home.ToString()" @onchange="MoveHome">
                @if (Home is PlanHome.Species || CanCarry(PlanHome.Species))
                {
                    <option value="@nameof(PlanHome.Species)">Species Bio</option>
                }

                @if (Home is PlanHome.Ruler || CanCarry(PlanHome.Ruler))
                {
                    <option value="@nameof(PlanHome.Ruler)">Ruler Bio</option>
                }
            </select>
        </div>
    }
</div>

@if (!Planning && !AnyFree)
{
    @*
        Both biographies have writing in them, and a plan will not take one. There is no way to tell
        a biography somebody meant from one they would not miss, so the app does not guess - it says
        what is in the way and leaves the decision where it belongs.
    *@
    <p class="sem-hint">
        Both biographies have something written in them. Clear the species' or the ruler's to plan
        this empire.
    </p>
}

@if (Planning)
{
    @*
        One at a time. Forty-nine perks, thirty-two trees and three hundred civics on one panel is
        three long lists competing for the same eye, and they are decided separately.
    *@
    <PickerTabs Tabs="@Parts" Label="Which part of the plan" Selected="@_part"
                SelectedChanged="p => _part = p" />

    @if (_part == 0)
    {
        <PlanPicker @key="@("perks")" Heading="Ascension Perks" BudgetKey="ASCENSION_PERKS"
                    Budget="@PerkBudget"
                    Available="@PerkOptions(chosen: false)" Chosen="@PerkOptions(chosen: true)"
                    OnToggle="TogglePerk" OnReorder="MovePerk" />
    }
    else if (_part == 1)
    {
        <PlanPicker @key="@("trees")" Heading="Traditions" BudgetKey="TRADITIONS"
                    Budget="@Session.Rules.GetTraditionBudget(Plan.Trees.Count)"
                    Available="@TreeOptions(chosen: false)" Chosen="@TreeOptions(chosen: true)"
                    OnToggle="ToggleTree" OnReorder="MoveTree" />
    }
    else
    {
        @*
            No order and no grips. An empire holds its civics all at once, so numbering them would
            say something about a government that is not true of one.
        *@
        <PlanPicker @key="@("civics")" Heading="Civics" BudgetKey="GOVERNMENT_CIVICS"
                    Budget="@Session.Rules.GetPlanCivicBudget(Locked.Count + Planned.Count)"
                    Available="@CivicOptions(chosen: false)" Chosen="@CivicOptions(chosen: true)"
                    Fixed="@LockedOptions" OnToggle="ToggleCivic" />
    }

    @if (Written is { Length: > 0 } written)
    {
        @*
            What the game will show, shown here. The point of writing a plan in words is that it is
            readable where it ends up, and the only way to know that is to see it.

            With how much room is left, because there is not much. A biography holds about four
            hundred and forty characters and the game cuts what will not fit without saying so - in
            a long language a full plan is within a few dozen of that, and something has to go. The
            meter is so it is the player who decides what, before the writing does it for them.
        *@
        <div class="sem-field flush">
            <label>As it will read in game</label>
            <div class="sem-plan-preview">@written</div>

            <div class="sem-budgets">
                <BudgetBar Key="SEM_PLAN_LENGTH" Fallback="Biography" Label="SEM_PLAN_LENGTH"
                           LabelFallback="Biography" Value="@Length" />
            </div>
        </div>
    }
}

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>Which part of the plan is showing, since all three are long lists.</summary>
    private int _part;

    /// <summary>
    /// The three parts, each saying how much of its allowance the plan has spent.
    /// </summary>
    /// <remarks>
    /// The count rides on the tab so the parts that are not showing still say what is in them - the
    /// same reason the flag picker's tabs carry the emblem's name.
    /// </remarks>
    private IReadOnlyList<PickerTabs.Tab> Parts =>
    [
        new("Ascension Perks", $"{Plan.Perks.Count}/{PerkBudget.Available}"),
        new("Traditions", $"{Plan.Trees.Count}/{Session.Data.Database.Defines.TraditionSlots}"),
        new("Civics", $"{Locked.Count + Planned.Count}/{Session.Data.Database.Defines.PlannedCivicPoints}"),
    ];

    private EmpireDesign Design => Session.Current!;

    private PlanVocabulary Vocabulary => Session.PlanVocabulary;

    /// <summary>Which biography is carrying the plan, or is about to.</summary>
    private PlanHome Home => Stored ?? Session.PlanIntent ?? PlanHome.Species;

    /// <summary>Which biography actually holds a plan, which is nothing until one is written.</summary>
    private PlanHome? Stored => Session.Plans.HomeOf(Design, Vocabulary);

    /// <summary>
    /// Whether this empire is being planned.
    /// </summary>
    /// <remarks>
    /// Either because a biography already holds a plan, or because the player has said so and has
    /// not decided anything yet. The second is what stops the checkbox from taking a biography the
    /// moment it is ticked.
    /// </remarks>
    private bool Planning => Stored is not null || Session.PlanIntent is not null;

    /// <summary>
    /// The plan being edited, which is the stored one or the one a new plan starts as.
    /// </summary>
    /// <remarks>
    /// A new plan starts holding the civics the empire already has and could give up, so the civic
    /// picker opens saying what is true now and is edited from there. An empty civics line would
    /// otherwise read as "reform into none of these", which is not what an untouched field looks
    /// like it means. None of that is written down until something is actually decided.
    /// </remarks>
    private EmpirePlan Plan => Stored is not null
        ? Session.Plans.PlanOf(Design, Vocabulary)
        : new EmpirePlan([], [], [.. Keeping]);

    /// <summary>The civics the empire has now and could choose to give up.</summary>
    private IEnumerable<string> Keeping =>
        Session.Context!.Civics.Where(c => !Locked.Any(l => l.Key == c));

    /// <summary>
    /// The civics the plan names that are not already forced on the empire.
    /// </summary>
    /// <remarks>
    /// A civic can be planned and then acquired, and a few dozen may be added by a reform but never
    /// removed - so the same civic can end up named by the plan and locked at once. Counted twice it
    /// filled a slot that was not spent, and drawn twice it appeared in the fixed rows and the
    /// chosen ones together, greyed in one and pressable in the other.
    /// </remarks>
    private IReadOnlyList<string> Planned =>
        [.. Plan.Civics.Where(c => !Locked.Any(l => l.Key == c))];

    private string Written => Session.Plans.Text.Write(Plan);

    /// <summary>How many perks this plan holds, against how many a game grants.</summary>
    private Budget PerkBudget => Session.Rules.GetAscensionPerkBudget(Plan.Perks.Count);

    /// <summary>
    /// How much of a biography the plan is asking for.
    /// </summary>
    /// <remarks>
    /// Measured before it is shortened, not after. Read off the written text it could never exceed
    /// the budget, because the writing is what enforces it - so the one number that exists to warn
    /// that something is about to be dropped was incapable of saying so.
    /// </remarks>
    private Budget Length => new(Session.Plans.Text.Measure(Plan), PlanText.Budget);

    /// <summary>The civics this empire is stuck with, which spend slots the plan cannot use.</summary>
    private IReadOnlyList<OptionState> Locked => Session.Rules.GetLockedCivics(Session.Context!);

    // ---------------------------------------------------------------- what each picker is given

    private IReadOnlyList<PlanOption> PerkOptions(bool chosen) => Shape(
        Session.Rules.GetAscensionPerkOptions(Session.Context!, Plan.Perks, Plan.Trees),
        Plan.Perks,
        chosen,
        Describe.Perk(Session));

    private IReadOnlyList<PlanOption> TreeOptions(bool chosen) => Shape(
        Session.Rules.GetTraditionTreeOptions(Session.Context!, Plan.Trees, Plan.Perks),
        Plan.Trees,
        chosen,
        Describe.Tree(Session),
        Inside);

    /// <remarks>
    /// The locked ones are kept out of what is on offer as well as being drawn above it. They are
    /// civics the empire holds, so the rules do offer them - and listed in both places the same
    /// civic appeared twice, once as a choice and once as a thing that is not one, with the
    /// description reading off whichever came first.
    /// </remarks>
    private IReadOnlyList<PlanOption> CivicOptions(bool chosen) => Shape(
        Session.Rules.GetPlanCivicOptions(Session.Context!, Planned),
        chosen ? Planned : [.. Planned, .. Locked.Select(o => o.Key)],
        chosen,
        Describe.Civic(Session));

    /// <summary>
    /// The civics shown above the choice because they cannot be given up.
    /// </summary>
    /// <remarks>
    /// Shaped from what the rules said about them rather than from the picker's own list, so each
    /// keeps the game's sentence for why it cannot be touched - "This Civic cannot be manually
    /// added or removed after the game has started" - which is the only useful thing to say about a
    /// row that will not respond.
    /// </remarks>
    private IReadOnlyList<PlanOption> LockedOptions =>
    [
        .. Shape(Locked, [.. Locked.Select(o => o.Key)], chosen: true, Describe.Civic(Session))
            .Select(o => o with { Locked = true })
    ];

    /// <summary>
    /// The traditions a tree holds, in the order the game grants them.
    /// </summary>
    /// <remarks>
    /// The one that opens it first, then the five picks in the order the file lists them, then the
    /// one that finishes it. That is the order they are taken in, and reading them in any other
    /// order would say something about the tree that is not true of it.
    /// </remarks>
    private IReadOnlyList<PlanOption> Inside(string treeKey)
    {
        if (Session.Data.Database.TraditionTrees.FirstOrDefault(t => t.Key == treeKey) is not { } tree)
        {
            return [];
        }

        IEnumerable<string> order =
            [.. new[] { tree.AdoptionBonus }.OfType<string>(),
             .. tree.Traditions,
             .. new[] { tree.FinishBonus }.OfType<string>()];

        return
        [
            .. order
                .Select(key => Session.Data.Database.Traditions.FirstOrDefault(t => t.Key == key))
                .OfType<TraditionDefinition>()
                .Select(t => new PlanOption(
                    t.Key,
                    Session.Localizer.Text(t.NameKey),
                    Session.Localizer.Html(t.DescriptionKey, string.Empty),
                    t.Icon,
                    t.Effects,
                    Enabled: true,
                    Reasons: []))
        ];
    }

    /// <summary>
    /// Turns what the rules said into what a picker draws, for any part of the plan.
    /// </summary>
    /// <remarks>
    /// The chosen list is built from the plan rather than from the options, so something the empire
    /// can no longer take - a pack turned off since, say - is still shown as planned rather than
    /// disappearing without a word. Letting it go is how it leaves.
    /// </remarks>
    private IReadOnlyList<PlanOption> Shape(
        IReadOnlyList<OptionState> states,
        IReadOnlyList<string> planned,
        bool chosen,
        Func<string, (string Name, string? Desc, string? Icon, EffectSet? Effects)> describe,
        Func<string, IReadOnlyList<PlanOption>>? contents = null)
    {
        IReadOnlyList<string> keys = chosen
            ? planned
            : [.. states.Where(s => s.Visible && !planned.Contains(s.Key)).Select(s => s.Key)];

        var options = keys.Select(key =>
        {
            var state = states.FirstOrDefault(s => s.Key == key) ?? OptionState.Available(key, 0);
            var (name, description, icon, effects) = describe(key);

            var reasons = Session.Reasons
                .Describe([.. state.Reasons.Where(r => !RuleReasons.IsBudget(r))])
                .ToList();

            if (state.RequiredDlc is { Length: > 0 } dlc)
            {
                reasons.Add($"Requires {dlc}.");
            }

            // Being full is not the same objection as being wrong: one is undone by letting
            // something go and the other is not, so only the second sinks to the bottom.
            var full = !state.Enabled && state.Reasons.Count > 0 && state.Reasons.All(RuleReasons.IsBudget);

            return new PlanOption(
                key,
                Session.Localizer.Text(name),
                Session.Localizer.Html(description, string.Empty),
                icon,
                effects,
                state.Enabled,
                reasons,
                Unavailable: !state.Enabled && !full,
                Contents: contents?.Invoke(key));
        });

        return chosen
            ? [.. options]
            : [.. options.OrderBy(o => o.Unavailable).ThenBy(o => o.Name, StringComparer.CurrentCulture)];
    }

    /// <summary>Where each part of a plan gets its words and its picture from.</summary>
    private static class Describe
    {
        public static Func<string, (string, string?, string?, EffectSet?)> Perk(DesignSession session) =>
            key => session.Data.Database.AscensionPerks.FirstOrDefault(p => p.Key == key) is { } perk
                ? (perk.NameKey, perk.DescriptionKey, perk.Icon, perk.Effects)
                : (key, null, null, null);

        public static Func<string, (string, string?, string?, EffectSet?)> Tree(DesignSession session) =>
            key => session.Data.Database.TraditionTrees.FirstOrDefault(t => t.Key == key) is { } tree
                ? (tree.NameKey, tree.DescriptionKey, tree.Icon, null)
                : (key, null, null, null);

        public static Func<string, (string, string?, string?, EffectSet?)> Civic(DesignSession session) =>
            key => session.Data.Database.Civics.FirstOrDefault(c => c.Key == key) is { } civic
                ? (civic.NameKey, $"{civic.Key}_desc", civic.Icon, civic.Effects)
                : (key, null, null, null);
    }

    // ---------------------------------------------------------------- and what pressing one does

    private void TogglePerk((string Key, bool Chosen) pressed) =>
        Save(Plan with
        {
            Perks = pressed.Chosen
                ? [.. Plan.Perks.Where(p => p != pressed.Key)]
                : [.. Plan.Perks, pressed.Key],
        });

    private void ToggleTree((string Key, bool Chosen) pressed) =>
        Save(Plan with
        {
            Trees = pressed.Chosen
                ? [.. Plan.Trees.Where(t => t != pressed.Key)]
                : [.. Plan.Trees, pressed.Key],
        });

    private void ToggleCivic((string Key, bool Chosen) pressed) =>
        Save(Plan with
        {
            Civics = pressed.Chosen
                ? [.. Plan.Civics.Where(c => c != pressed.Key)]
                : [.. Plan.Civics, pressed.Key],
        });

    /// <summary>
    /// Moves a perk, unless the game would not grant it where it is being put.
    /// </summary>
    /// <remarks>
    /// Twenty-five perks are gated on how many come before them, so where one sits is as much a
    /// rule as whether it is in the plan at all. A move that would break one simply does not happen,
    /// which is how the pickers already treat a choice the game would refuse - a blocked row does
    /// nothing rather than being taken and then complained about.
    /// </remarks>
    private void MovePerk((int From, int To) move)
    {
        var perks = Moved(Plan.Perks, move);

        // Refused only while the plan is legal to begin with. Releasing a perk shifts everything
        // after it one place earlier, which can leave a later one below the count it needs - and
        // then every arrangement of what is left was refused too, so the grips went dead with
        // nothing said and the only way out was emptying the plan. A list already wrong is one the
        // player is trying to put right.
        if (Session.Rules.IsLegalPerkOrder(Session.Context!, perks, Plan.Trees) ||
            !Session.Rules.IsLegalPerkOrder(Session.Context!, Plan.Perks, Plan.Trees))
        {
            Save(Plan with { Perks = perks });
        }
    }

    /// <summary>
    /// Moves a tree, which nothing can refuse.
    /// </summary>
    /// <remarks>
    /// Unlike the perks: no tree in the game asks how many were opened before it, so any order of
    /// them is one the game would allow. It is still worth arranging, because the order is the one
    /// the player means to take them in.
    /// </remarks>
    private void MoveTree((int From, int To) move) => Save(Plan with { Trees = Moved(Plan.Trees, move) });

    private static List<string> Moved(IReadOnlyList<string> keys, (int From, int To) move)
    {
        var moved = keys.ToList();
        var one = moved[move.From];

        moved.RemoveAt(move.From);
        moved.Insert(Math.Clamp(move.To, 0, moved.Count), one);

        return moved;
    }

    /// <summary>
    /// Turns planning on, or off and gives the biography back.
    /// </summary>
    /// <remarks>
    /// Turning it on writes nothing. It only says which biography a plan would go into, so the
    /// pickers have somewhere to aim - and so that changing one's mind about which to use has not
    /// already taken the other. The first thing actually decided is what writes.
    /// </remarks>
    private void TogglePlanning(ChangeEventArgs e)
    {
        if (e.Value is bool on && on)
        {
            // Nothing at all when neither biography is free, which is what the disabled box says.
            Session.PlanIntent = FirstFree;

            return;
        }

        Session.PlanIntent = null;

        Session.Edit(d =>
        {
            Session.Plans.Clear(d, PlanHome.Species, Vocabulary);
            Session.Plans.Clear(d, PlanHome.Ruler, Vocabulary);
        });
    }

    /// <summary>Whether a plan may use that biography, which it may not if it holds writing.</summary>
    private bool CanCarry(PlanHome home) => Session.Plans.CanCarry(Design, home, Vocabulary);

    /// <summary>Whether either biography is free, which is what makes planning possible at all.</summary>
    private bool AnyFree => CanCarry(PlanHome.Species) || CanCarry(PlanHome.Ruler);

    /// <summary>
    /// The biography a new plan goes into, which is the species' where there is a choice.
    /// </summary>
    /// <remarks>
    /// The species' first because it is the longer of the two in the game's own presets and reads as
    /// the empire's story rather than one person's, which is nearer to what a plan is.
    /// </remarks>
    private PlanHome? FirstFree =>
        CanCarry(PlanHome.Species) ? PlanHome.Species
        : CanCarry(PlanHome.Ruler) ? PlanHome.Ruler
        : null;

    /// <summary>
    /// Moves the plan to the other biography, taking it out of the one it was in.
    /// </summary>
    /// <remarks>
    /// Or, where nothing has been decided yet, simply changes where it would go. Writing here would
    /// undo the point of writing nothing when the checkbox was ticked.
    /// </remarks>
    private void MoveHome(ChangeEventArgs e)
    {
        if (!Enum.TryParse<PlanHome>(e.Value?.ToString(), out var home))
        {
            return;
        }

        Session.PlanIntent = home;

        if (Stored is null)
        {
            return;
        }

        var plan = Plan;

        Session.Edit(d => Session.Plans.Write(d, plan, home, Vocabulary));
    }

    /// <summary>
    /// Writes a plan a picker has changed into the biography carrying it.
    /// </summary>
    /// <remarks>
    /// Always writes, even a plan that now names nothing - which is a marker and one line, and is
    /// the honest record of a player who has decided to reform into no civics at all. It used to
    /// give the biography back instead, and that made the last civic un-droppable: the plan went,
    /// the fallback below rebuilt it from the civics the empire already had, and both the civic
    /// just released and the one released before it came back. Giving the field up is the
    /// checkbox's business, and it is still there.
    /// </remarks>
    private void Save(EmpirePlan plan)
    {
        var home = Home;

        Session.PlanIntent = home;

        Session.Edit(d => Session.Plans.Write(d, plan, home, Vocabulary));
    }
}
