@implements IAsyncDisposable
@inject SessionHost Host
@inject IJSRuntime Js
@inject NavigationManager Navigation

@*
    A shelf of the game, to read rather than to pick from.

    Civics and origins are the same record in the data and two different things to a player - an
    origin is the whole of how an empire starts and carries a scene of the world it wakes up on, a
    civic is one of two picks - so they get an address each and this component behind both. What
    differs between the two pages is a title, a list and a word; everything else here would have
    been written twice.

    Everything a card says is already in gamedb.json. Nothing was extracted for this page: the
    reachability, the pack and the description are all worked out from conditions the file already
    carries, because a property added to the definition would bump the schema and send every desktop
    player back through thirty-five thousand files.
*@

<h1>@Title</h1>

@*
    Alphabetical, and staying that way as sections are added. Any other order is one somebody has to
    learn, and a wiki that grows to a dozen shelves would be reordering itself under the reader every
    time one arrived.
*@
<nav class="sem-wiki-nav" aria-label="Wiki sections">
    <NavLink href="wiki/authorities" class="sem-tab">Authorities</NavLink>
    <NavLink href="wiki/civics" class="sem-tab">Civics</NavLink>
    <NavLink href="wiki/ethics" class="sem-tab">Ethics</NavLink>
    <NavLink href="wiki/origins" class="sem-tab">Origins</NavLink>
    <NavLink href="wiki/species" class="sem-tab">Species</NavLink>
</nav>

@if (_session is null || _shelf is null || _filter is null)
{
    <div class="sem-loading">
        @if (Host.LoadError is { } error)
        {
            <h2>The game data is not available</h2>
            <p class="sem-hint">@error</p>
            <p class="sem-hint">
                A local build needs the data extracted first:
                <code>dotnet run --project src/Sem.Cli -- extract --web</code>
            </p>
        }
        else
        {
            <p>Loading game data…</p>
        }
    </div>
}
else
{
    @*
        The page opens its own cascade. The layout's wraps the content pack panel and not the body,
        so a page that did not do this would draw every icon, chip and effects list against a
        missing session and say nothing about why.
    *@
    <CascadingValue Value="_session">
     @*
        What makes a chip a link, and only here.

        A chip knows its key and not which shelf that key is on, so the map is handed down rather
        than worked out at each of the several hundred of them. Cascaded rather than injected
        because it needs the extracted game, which arrives some time after the page does - and
        because its absence is the signal: the same chip in the empire editor finds nothing here and
        stays what it was, which is what should happen. Pressing a civic while designing an empire
        should not walk out of the designer.
     *@
     <CascadingValue Value="_links">
      @*
        One box around both views, because the popovers are bound to it rather than to each chip.
        A civics page draws several hundred of them and binding each one costs a round trip into
        JavaScript before anybody has hovered anything; bindPopoversWhenPointed puts one listener
        here instead and binds a chip the first moment a pointer reaches it.
      *@
      <div @ref="_body">
        <div class="sem-list-head">
            @*
                The same two words the empire list uses, because it is the same choice: a card
                answers "what is that one" and a list answers questions about the set - which of
                these want a hive mind, which cost a pack I do not own.
            *@
            <div class="sem-view-toggle" role="group" aria-label="@($"How to show the {Noun}")">
                <button type="button" aria-pressed="@(_listView ? "false" : "true")"
                        @onclick="() => ShowList(false)">Cards</button>

                <button type="button" aria-pressed="@(_listView ? "true" : "false")"
                        @onclick="() => ShowList(true)">List</button>
            </div>

            <p class="sem-hint">
                @(Narrowed.Count == Rows.Count
                    ? $"{Rows.Count} {Noun}"
                    : $"{Narrowed.Count} of {Rows.Count} {Noun}")
            </p>
        </div>

        @*
            The two broadest controls above the fold, where a reader who has a word in mind can
            reach them without opening anything.

            No content pack control here. The pack bar at the top of every page already decides which
            packs to judge by, and a second one saying the same thing differently was two answers to
            one question - so the chips follow that bar, and narrowing by ownership is a heading in
            the filter card with the rest.
        *@
        <div class="sem-row sem-wiki-search">
            <SearchBox TRow="WikiRow" Filter="@_filter" Id="wiki-search"
                       Label="@($"Search {Noun}")" OnChanged="Narrow" />

            <AskedToggle TRow="WikiRow" Filter="@_filter" Key="reach"
                         All="@(new ToggleWording("All", $"Showing every {One} the game defines. Press to show only the ones a player can take."))"
                         Yes="@(new ToggleWording("Playable", $"Showing the {Noun} a player can take. Press to show the ones nobody can."))"
                         No="@(new ToggleWording("Unplayable", $"Showing the {Noun} no player can take. Press to show all of them."))"
                         OnChanged="Narrow" />

        </div>

        <FilterCard TRow="WikiRow" Rows="@Rows" Filter="@_filter" Facets="@_shelf!.Facets"
                    Title="@($"{Title} Filter")" Hidden="@WikiFacet.AskedElsewhere"
                    OnChanged="Narrow" />

        @if (Narrowed.Count == 0)
        {
            <p class="sem-hint">Nothing matches.</p>
        }
        else if (_listView)
        {
            <WikiTable Rows="@Narrowed" All="@Rows" Noun="@Noun" Kind="@Kind"
                       Chosen="@_chosen" OnChoose="Choose" />
        }
        else
        {
            <div class="sem-wiki-cards">
                @foreach (var row in Narrowed)
                {
                    <WikiCard Row="@row" Chosen="@(row.Key == _chosen)" Link="@WikiLinks.Entry(Kind, row.Key)"
                              OnChoose="() => Choose(row)" />
                }
            </div>
        }
      </div>
     </CascadingValue>
    </CascadingValue>
}

@code {
    /// <summary>Which shelf of the game this page shows.</summary>
    [Parameter, EditorRequired]
    public required WikiKind Kind { get; set; }

    /// <summary>
    /// The entry the address named, where it named one.
    /// </summary>
    /// <remarks>
    /// From the route, so a link somebody was sent opens on the thing it was about. Held separately
    /// from <c>_chosen</c> because the two part company the moment the reader presses something
    /// else: the address follows them, but arriving is a one-off and re-scrolling on every render
    /// would fight anybody trying to read down the page.
    /// </remarks>
    [Parameter]
    public string? Focus { get; set; }

    /// <summary>Which entry is picked out, whether by the address or by a press.</summary>
    private string? _chosen;

    /// <summary>The key still waiting to be scrolled to, cleared once it has been.</summary>
    private string? _pending;

    /// <summary>What the page is called, in the heading and in the filter card.</summary>
    private string Title => _shelf?.Title ?? string.Empty;

    /// <summary>The plural, for the counts and the spoken labels.</summary>
    private string Noun => _shelf?.Noun ?? string.Empty;

    /// <summary>And the singular, for the sentences that need one.</summary>
    private string One => _shelf?.One ?? string.Empty;

    private DesignSession? _session;

    private WikiShelves? _shelves;

    /// <summary>Where each key lives, for the chips to link through.</summary>
    private WikiLinks? _links;

    private WikiShelf? _shelf;

    /// <summary>
    /// What is being asked, which every control on the page writes to in place.
    /// </summary>
    /// <remarks>
    /// One filter and not a copy each, for the reason the search box gives about itself: the cards,
    /// the count and the card of headings all read it, and handing each of them their own is how
    /// they stop agreeing about what is being shown.
    /// </remarks>
    private Sifter<WikiRow>? _filter;

    private bool _listView;

    /// <summary>What the chosen view is remembered under, shared by both wiki pages.</summary>
    /// <remarks>
    /// Shared deliberately. Civics and origins are the same list drawn the same way, and a reader
    /// who switched one to a list and found the other still in cards would be looking at a setting
    /// that remembered half of what they did.
    /// </remarks>
    private const string ViewSetting = "wiki-view";

    private const string ListView = "list";

    /// <summary>Everything on this page's shelf, before anything is asked of it.</summary>
    private IReadOnlyList<WikiRow> Rows => _shelf?.Rows ?? [];

    /// <summary>
    /// What is left after the filter, worked out once per question asked.
    /// </summary>
    /// <remarks>
    /// Held rather than written into a parameter, which is the mistake the empire list already
    /// made and fixed: an expression in a parameter is evaluated on every render, so pressing a
    /// toggle put all three hundred and fifty-eight rows through every heading twice.
    /// </remarks>
    private IReadOnlyList<WikiRow> Narrowed =>
        _narrowed ??= _filter is { Any: true } ? [.. Rows.Where(_filter.Matches)] : Rows;

    private IReadOnlyList<WikiRow>? _narrowed;

    protected override async Task OnInitializedAsync()
    {
        _session = await Host.GetAsync().ConfigureAwait(true);

        if (_session is null)
        {
            return;
        }

        _session.Changed += Forget;
        _links = new WikiLinks(_session.Data.Database);
        _shelves = new WikiShelves(_session);
        Open();
        _listView = _session.Preferences.Get(ViewSetting) == ListView;
    }

    /// <summary>
    /// Reads the shelf again when the player's content packs change.
    /// </summary>
    /// <remarks>
    /// Which pack a civic needs is a fact about the game, but whether the reader owns it is not -
    /// and that is one of the two questions the toggles above ask. Left alone, switching a pack off
    /// leaves every row still saying you have it.
    /// </remarks>
    private void Forget()
    {
        _shelves = _session is null ? null : new WikiShelves(_session);
        Open();
        StateHasChanged();
    }

    /// <summary>
    /// Takes the shelf this page is for, and a filter that answers for it.
    /// </summary>
    /// <remarks>
    /// A filter each, because the headings differ between shelves: an ethic has a cost heading and a
    /// civic has none, and one filter carried between them would hold ticks under a heading the page
    /// in front of the reader does not draw.
    /// </remarks>
    private void Open()
    {
        _shelf = _shelves?.Of(Kind);
        _narrowed = null;

        if (_shelf is { } shelf)
        {
            _filter = new Sifter<WikiRow>(shelf.Facets, row => row.Text);
        }
    }

    /// <summary>
    /// Opens the other shelf when the reader moves between sections.
    /// </summary>
    /// <remarks>
    /// The four pages are one component behind four addresses, so moving between them changes a
    /// parameter rather than building anything - and without this the reader arrived at Ethics
    /// looking at the civics.
    /// </remarks>
    protected override void OnParametersSet()
    {
        if (_shelves is not null && _shelf?.Title != _shelves.Of(Kind).Title)
        {
            Open();
        }

        // The address decides which entry is picked out, so the page is the same thing to everybody
        // who opens it. A press writes it there rather than here; this reads it back - including
        // when the press was on a chip naming something on the page already in front of the reader.
        if (Focus == _chosen)
        {
            return;
        }

        _chosen = Focus;
        _pending = Focus;

        // Somebody sent here to read about one entry should be shown it, whatever was being asked
        // of the shelf beforehand. Without this a chip pressed with a word still in the search box
        // scrolls to a row that was filtered out, which is to say it does nothing at all.
        if (Focus is { Length: > 0 } wanted && _filter is { Any: true } &&
            !Narrowed.Any(row => row.Key == wanted))
        {
            _filter.Clear();
            Narrow();
        }
    }

    /// <summary>
    /// Picks an entry out, and puts it in the address so the page can be shared as it stands.
    /// </summary>
    /// <remarks>
    /// Replacing rather than pushing. Reading down a list and pressing four things is one visit, not
    /// four, and a Back button that walks a reader back through their own browsing of one page is a
    /// Back button that does not go back.
    /// </remarks>
    private void Choose(WikiRow row)
    {
        _chosen = _chosen == row.Key ? null : row.Key;

        Navigation.NavigateTo(
            _chosen is { Length: > 0 } key ? WikiLinks.Entry(Kind, key) : WikiLinks.Section(Kind),
            replace: true);
    }

    /// <summary>The box the popovers are bound through.</summary>
    private ElementReference _body;

    /// <summary>
    /// Held as the task rather than its result, for the reason the empire table gives: written as
    /// <c>_module ??= await Import()</c> two renders can both find it null and both import.
    /// </summary>
    private Task<IJSObjectReference>? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_session is null)
        {
            return;
        }

        try
        {
            var module = await (_module ??= Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sem.Ui/sem.js").AsTask()).ConfigureAwait(true);

            // Every render, and cheap: the binder marks the box it was given and returns at once if
            // it is asked again. Switching between cards and list builds a new box, which needs it.
            await module.InvokeVoidAsync("bindPopoversWhenPointed", _body).ConfigureAwait(true);

            // Once, when an address named something. Scrolling on every render would take the page
            // away from anybody reading down it, and the entry is already picked out either way.
            if (_pending is { Length: > 0 } key)
            {
                _pending = null;

                await module.InvokeVoidAsync(
                    "scrollToEntry", _body, $"[data-entry='{key}']").ConfigureAwait(true);
            }
        }
        catch (JSDisconnectedException)
        {
            // The page went away mid-render. Nothing to bind and nobody to tell.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_session is not null)
        {
            _session.Changed -= Forget;
        }

        if (_module is null)
        {
            return;
        }

        try
        {
            await (await _module.ConfigureAwait(false)).DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
        catch (JSException)
        {
            // The import never succeeded, so it left nothing to release.
        }
    }

    private void Narrow() => _narrowed = null;

    private void ShowList(bool list)
    {
        _listView = list;
        _session?.Preferences.Set(ViewSetting, list ? ListView : "cards");
    }
}
