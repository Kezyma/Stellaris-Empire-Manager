@*
    The homeworld and the system it sits in.
*@

<div class="sem-columns">
    <div class="sem-panel">
        <h3>Homeworld</h3>

        @if (Options.Count == 1)
        {
            <p class="sem-hint">The chosen origin decides where this empire begins.</p>
        }

        @* The pictures are the planets themselves, so they need room to be recognised. *@
        <OptionGrid Options="@WorldOptions"
                    IconSize="56"
                    EmptyHint="Hover a world to see what kind of home it makes."
                    OnSelect="key => Session.Edit(d => d.PlanetClass = key)" />

        <div class="sem-field" style="margin-top:12px">
            <label for="planet-name">Planet name</label>
            <div class="sem-row" style="flex-wrap:nowrap">
                <input id="planet-name" type="text" value="@Design.PlanetName.Key"
                       @onchange="e => Session.Edit(d => d.PlanetName.SetLiteral(e.Value?.ToString() ?? string.Empty))" />
                <button type="button" title="A world from the empire's name list"
                        @onclick="RandomisePlanetName">Randomise</button>
            </div>
        </div>
    </div>

    <div class="sem-panel">
        <h3>Starting system</h3>

        <div class="sem-field">
            <label for="system-name">System name</label>
            <input id="system-name" type="text" value="@Design.SystemName.Key"
                   @onchange="e => Session.Edit(d => d.SystemName.SetLiteral(e.Value?.ToString() ?? string.Empty))" />
        </div>

        <div class="sem-field">
            <label for="initializer">Scripted system</label>
            <select id="initializer" @onchange="e => Session.Edit(d => d.Initializer = e.Value?.ToString() ?? string.Empty)">
                <option value="" selected="@string.IsNullOrEmpty(Design.Initializer)">
                    Generated by the game
                </option>

                @foreach (var system in Systems)
                {
                    <option value="@system" selected="@(system == Design.Initializer)">
                        @Session.Localizer.Text(system, Localizer.Prettify(system))
                    </option>
                }
            </select>
        </div>

        <p class="sem-hint">
            Most empires leave this to the game, which builds a system to suit. An origin that needs
            a particular one narrows the choice.
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private IReadOnlyList<OptionGrid.GridOption> WorldOptions
    {
        get
        {
            var byKey = Session.Data.Database.PlanetClasses.ToDictionary(p => p.Key, StringComparer.Ordinal);

            return GridOptions.Build(
                Session,
                Options.Select(OptionState.Available),
                key => (byKey.GetValueOrDefault(key)?.Icon, null),
                key => key == Design.PlanetClass);
        }
    }

    /// <summary>A world named the way the empire's own people would name one.</summary>
    private void RandomisePlanetName()
    {
        if (Session.Names.Planet(Design.Species.NameList) is { Length: > 0 } name)
        {
            Session.Edit(d => d.PlanetName.SetLiteral(name));
        }
    }

    private IReadOnlyList<string> Options => Session.Rules.GetHomeworldOptions(Session.Context!);

    private IReadOnlyList<string> Systems => Session.Rules.GetStartingSystemOptions(Session.Context!);

    private string? IconFor(string key) =>
        Session.Data.Database.PlanetClasses.FirstOrDefault(p => p.Key == key)?.Icon;
}
