@*
    The homeworld and the system it sits in.

    A world says nothing about itself in the game's files — no description, no effects — so what is
    shown for one is the habitability preference living there would give the species, which is the
    whole of what the choice means.
*@

<div class="sem-panel">
    <h3>@Session.Localizer.Label("HOMEWORLD_CLASS_LABEL", "Homeworld Class")</h3>

    @if (Options.Count == 1)
    {
        <p class="sem-hint">The chosen origin decides where this empire begins.</p>
    }

    @* The pictures are the planets themselves, so they need room to be recognised. *@
    <OptionGrid Options="@WorldOptions"
                IconSize="56"
                EmptyHint="Hover a world to see what kind of home it makes."
                OnSelect="key => Session.Edit(d => d.PlanetClass = key)" />
</div>

<div class="sem-panel">
    <h3>@Session.Localizer.Text("SELECT_SYSTEM_INITIALIZER_LABEL", "Starting solar system")</h3>

    @*
        The three belong together — a world, the star it circles and the shape of the system around
        them — and each is a line of the same sentence.
    *@
    <div class="sem-name-row">
        <div class="sem-field">
            <label for="planet-name">@Session.Localizer.Label("HOMEWORLD_NAME", "Homeworld Name")</label>
            <div class="sem-row" style="flex-wrap:nowrap">
                <ComboBox Id="planet-name" Value="@Session.Localizer.Name(Design.PlanetName)"
                          Options="@PlanetNames" OnChange="ChoosePlanetName" />
                <RandomiseButton Title="A world from the empire's name list" OnClick="RandomisePlanetName" />
            </div>
        </div>

        <div class="sem-field">
            <label for="system-name">@Session.Localizer.Text("SYSTEM_NAME", "Star name")</label>
            <div class="sem-row" style="flex-wrap:nowrap">
                <ComboBox Id="system-name" Value="@Session.Localizer.Name(Design.SystemName)"
                          Options="@SystemNames" OnChange="ChooseSystemName" />
                <RandomiseButton Title="A star from the species the game suggests" OnClick="RandomiseSystemName" />
            </div>
        </div>

        <div class="sem-field">
            <label for="initializer">@Session.Localizer.Label("SELECT_SYSTEM_INITIALIZER_LABEL", "Starting Solar System")</label>
            <select id="initializer" @onchange="e => Session.Edit(d => d.Initializer = e.Value?.ToString() ?? string.Empty)">
                @*
                    Not "generated by the game" — the game calls this Random, and offers it as one of
                    the systems rather than as the absence of one.
                *@
                <option value="" selected="@string.IsNullOrEmpty(Design.Initializer)">
                    @Session.Localizer.Text("RANDOM_FRONTEND_NAME", "Random")
                </option>

                @foreach (var system in Systems)
                {
                    <option value="@system" selected="@(system == Design.Initializer)">@SystemName(system)</option>
                }
            </select>
        </div>
    </div>

    @if (Description(Design.Initializer) is { Length: > 0 } description)
    {
        <p class="sem-hint">@((MarkupString)description)</p>
    }
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    /// <summary>
    /// The worlds an empire may begin on, each described by what living there would do to it.
    /// </summary>
    private IReadOnlyList<OptionGrid.GridOption> WorldOptions
    {
        get
        {
            var planets = Session.Data.Database.PlanetClasses.ToDictionary(p => p.Key, StringComparer.Ordinal);
            var traits = Session.Data.Database.Traits.ToDictionary(t => t.Key, StringComparer.Ordinal);

            return
            [
                .. Options.Select(key =>
                {
                    var preference = Session.Rules.HabitabilityTraitFor(key);
                    var trait = preference is null ? null : traits.GetValueOrDefault(preference);

                    return new OptionGrid.GridOption(key, Session.Localizer.Text(key))
                    {
                        Icon = planets.GetValueOrDefault(key)?.Icon,
                        Effects = trait?.Effects,
                        Description = preference is null
                            ? string.Empty
                            : Session.Localizer.Html($"{preference}_desc", string.Empty),
                        Selected = key == Design.PlanetClass,
                    };
                })
            ];
        }
    }

    private IReadOnlyList<string> Options => Session.Rules.GetHomeworldOptions(Session.Context!);

    private IReadOnlyList<string> Systems => Session.Rules.GetStartingSystemOptions(Session.Context!);

    private InitializerDefinition? System(string key) =>
        Session.Data.Database.Initializers
            .FirstOrDefault(i => string.Equals(i.Key, key, StringComparison.Ordinal));

    private string SystemName(string key) =>
        Session.Localizer.Text(System(key)?.NameKey, Localizer.Prettify(key));

    private string Description(string? key) =>
        string.IsNullOrEmpty(key)
            ? Session.Localizer.Html("random_system_initializer_DESC", string.Empty)
            : Session.Localizer.Html(System(key)?.DescriptionKey, string.Empty);

    /// <summary>
    /// Worlds the empire's own people would name one after, and those the game suggests.
    /// </summary>
    private IReadOnlyList<string> PlanetNames =>
        [.. Session.Data.Database.NameLists
            .Where(n => string.Equals(n.Key, Design.Species.NameList, StringComparison.Ordinal))
            .SelectMany(n => n.PlanetNames)
            .Concat(Suggestions.Select(s => s.HomePlanet).OfType<string>())
            .Distinct(StringComparer.Ordinal)
            .OrderBy(n => n, StringComparer.CurrentCulture)];

    /// <summary>
    /// Stars, which only the ready-made species suggest: name lists hold worlds but no stars.
    /// </summary>
    private IReadOnlyList<string> SystemNames =>
        [.. Suggestions.Select(s => s.HomeSystem).OfType<string>()
            .Distinct(StringComparer.Ordinal)
            .OrderBy(n => n, StringComparer.CurrentCulture)];

    private IReadOnlyList<SpeciesNameSuggestion> Suggestions
    {
        get
        {
            var all = Session.Data.Database.SpeciesNames;

            var forClass = all
                .Where(s => string.Equals(s.SpeciesClass, Design.Species.Class, StringComparison.Ordinal))
                .ToList();

            return forClass.Count > 0 ? forClass : [.. all];
        }
    }

    private void ChoosePlanetName(string? value) =>
        Choose(value, s => s.HomePlanet, s => s.HomePlanetKey, d => d.PlanetName);

    private void ChooseSystemName(string? value) =>
        Choose(value, s => s.HomeSystem, s => s.HomeSystemKey, d => d.SystemName);

    /// <summary>
    /// Records a name, as a key where the game has one for it and as typed text otherwise.
    /// </summary>
    private void Choose(
        string? value,
        Func<SpeciesNameSuggestion, string?> text,
        Func<SpeciesNameSuggestion, string?> key,
        Func<EmpireDesign, LocRef> field)
    {
        var typed = value ?? string.Empty;

        var match = Suggestions.FirstOrDefault(s =>
            string.Equals(text(s), typed, StringComparison.Ordinal));

        Session.Edit(d => NameWriter.Write(field(d), match is null ? null : key(match), typed));
    }

    /// <summary>A world named the way the empire's own people would name one.</summary>
    private void RandomisePlanetName()
    {
        if (Session.Names.Planet(Design.Species.NameList) is { Length: > 0 } name)
        {
            Session.Edit(d => d.PlanetName.SetLiteral(name));
        }
    }

    /// <summary>A star from one of the ready-made species this class could have been.</summary>
    private void RandomiseSystemName()
    {
        if (Session.Names.Species(Design.Species.Class) is { HomeSystem: { Length: > 0 } system } suggestion)
        {
            Session.Edit(d => NameWriter.Write(d.SystemName, suggestion.HomeSystemKey, system));
        }
    }
}
