@*
    Where the empire's story begins. An origin can force traits, replace the homeworld, restrict
    the starting system and call for a second species, so what it changes is spelled out.
*@

<div class="sem-panel">
    <h3>Origin</h3>

    @if (Selected is { } origin)
    {
        <div class="sem-hint">
            @if (origin.ForcedTraits.Count > 0)
            {
                <p>Grants @string.Join(", ", origin.ForcedTraits.Select(t => Session.Localizer.Text(t))).</p>
            }

            @if (origin.HabitabilityPreference is { } climate || origin.StartingColony is { } colony)
            {
                <p>Starts the empire on @Session.Localizer.Text(origin.HabitabilityPreference ?? origin.StartingColony!).</p>
            }

            @if (origin.RequiresSecondarySpecies)
            {
                <p>Needs a second species, which the game gives @string.Join(", ", origin.SecondarySpeciesTraits.Select(t => Session.Localizer.Text(t))).</p>
            }
        </div>
    }

    <OptionGrid Options="@Origins"
                EmptyHint="Hover an origin to see where it starts the empire."
                OnSelect="Choose" />
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private DesignContext Context => Session.Context!;

    private CivicDefinition? Selected =>
        Session.Data.Database.Civics.FirstOrDefault(c => c.IsOrigin && c.Key == Design.Origin);

    private IReadOnlyList<OptionGrid.GridOption> Origins
    {
        get
        {
            var byKey = Session.Data.Database.Civics.ToDictionary(c => c.Key, StringComparer.Ordinal);

            var states = Session.Rules.GetOriginOptions(Context)
                .OrderBy(o => Session.Localizer.Text(o.Key), StringComparer.CurrentCulture);

            return GridOptions.Build(
                Session,
                states,
                key => (byKey.GetValueOrDefault(key)?.Icon, byKey.GetValueOrDefault(key)?.Effects),
                key => key == Design.Origin);
        }
    }

    private void Choose(string key)
    {
        Session.Edit(d =>
        {
            d.Origin = key;

            var origin = Session.Data.Database.Civics.FirstOrDefault(c => c.Key == key);

            // An origin that supplies its own homeworld overrides whatever was chosen, so the
            // design is brought into line rather than left recording something the game ignores.
            if ((origin?.HabitabilityPreference ?? origin?.StartingColony) is { Length: > 0 } world)
            {
                d.PlanetClass = world;
            }

            if (origin?.RequiresSecondarySpecies == true && d.SecondarySpecies is null)
            {
                var secondary = d.AddSecondarySpecies();
                secondary.Class = d.Species.Class;
                secondary.Portrait = d.Species.Portrait;
                secondary.NameList = d.Species.NameList;
                secondary.Gender = "not_set";
                secondary.SetTraits(origin.SecondarySpeciesTraits);
            }
            else if (origin?.RequiresSecondarySpecies != true)
            {
                d.RemoveSecondarySpecies();
            }
        });
    }
}
