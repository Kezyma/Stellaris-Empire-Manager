@*
    One of an empire's choices, named, with what it does behind it.

    The preview lists an empire's ethics, civics, traits, authority and origin as icons and names,
    while the designer shows the same option's description and effects in a panel beside the list it
    was chosen from. Same data, and no reason it should only be readable in the place where it is
    picked — reading an empire is exactly when someone wants to know what "Fanatic Militarist" is
    actually doing for it.

    The panel is a popover, so the browser puts it in the top layer and none of the scrolling,
    sticky boxes it sits inside can cut it off. Where it lands is worked out in sem.js, which also
    does the hovering: a chip is not worth a round trip into managed code on every mouse move.
*@

@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

<span class="sem-chip">
    @*
        popovertarget only when nothing else wants the press. It is the attribute that makes the
        browser toggle the panel on click, so a chip that opens an editor must not carry it, or one
        press would do both. Hover and focus still describe the chip either way - bindPopover has
        always shown it on those, and the click handler only pinned it open for a finger.
    *@
    <button type="button" @ref="_anchor" aria-describedby="@_id"
            popovertarget="@(Opens ? null : _id)" @onclick="OnSelect"
            @onmouseover="Reveal" @onfocus="Reveal">
        @if (Icon is { Length: > 0 } icon)
        {
            <img src="@Session.Data.AssetUrl(icon)" alt="" loading="lazy">
        }

        <span>@Name</span>
    </button>

    @*
        popover="auto" so the browser dismisses it on an outside click and closes whichever was open
        when the next one opens. Only one of these is ever wanted at a time.
    *@
    <div id="@_id" popover="auto" role="tooltip" class="sem-chip-detail" @ref="_panel">
        @*
            Empty until it is asked for, where the caller says there will be a great many of these.

            A panel is a heading, a paragraph of the game's own prose and a list of effects - twenty
            or thirty elements that nobody has looked at. One beside an empire is nothing. The empire
            table draws a hundred and fifty-eight, rebuilt on every sort and every page, and building
            the panels was most of half a second the reader waited through each time.
        *@
        @if (_revealed)
        {
            <h4>@Name</h4>

            @if (Lore is { Length: > 0 } lore)
            {
                <div class="sem-detail-lore">@((MarkupString)lore)</div>
            }

            @*
                "No effects" only where the panel would otherwise be empty. A homeworld has prose and
                no numbers of its own, and a line saying so under a paragraph that has already
                answered the question is a line that makes the panel look broken.
            *@
            <EffectsList Effects="@Effects" ShowNothing="@(Lore.Length == 0)" />
        }
    </div>
</span>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The option's key, which is also where its description is found.</summary>
    [Parameter, EditorRequired]
    public required string Key { get; set; }

    /// <summary>What it is called.</summary>
    [Parameter, EditorRequired]
    public required string Name { get; set; }

    /// <summary>Its picture, where it has one.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// Where its prose lives, when that is not its own key with <c>_desc</c> after it.
    /// </summary>
    /// <remarks>
    /// Almost everything is described under its own key. A homeworld is not: a planet class says
    /// nothing about itself and borrows the description of the habitability trait it grants, and an
    /// arkship keeps its own under a different suffix again.
    /// </remarks>
    [Parameter]
    public string? DescriptionKey { get; set; }

    /// <summary>What it does, shown in the panel behind it.</summary>
    [Parameter]
    public Sem.GameData.EffectSet? Effects { get; set; }

    /// <summary>
    /// What pressing the chip should do, where pressing it should do something.
    /// </summary>
    /// <remarks>
    /// The lite card wants a chip to open the editor that chose it, so that pressing a civic and
    /// pressing the word "Civics" above it do the same thing. Left unset - which is every use in
    /// the sections and on the front page - the chip is a description and nothing else.
    /// </remarks>
    [Parameter]
    public EventCallback OnSelect { get; set; }

    /// <summary>
    /// Whether something else will tie the panel to the button, the first time it is pointed at.
    /// </summary>
    /// <remarks>
    /// For a page with a great many of these on it at once. Tying them up costs a call into the
    /// browser each, which one chip beside an empire never notices and a table of them does: the
    /// empire table has a hundred and fifty-six, rebuilt on every sort, and binds them from one
    /// listener of its own instead.
    /// </remarks>
    [Parameter]
    public bool Deferred { get; set; }

    /// <summary>Whether pressing this chip opens something.</summary>
    private bool Opens => OnSelect.HasDelegate;

    /// <summary>What the game says about it, from wherever it says it.</summary>
    private string Lore =>
        Session.Localizer.Html(DescriptionKey ?? $"{Key}_desc", string.Empty) ?? string.Empty;

    private ElementReference _anchor;
    private ElementReference _panel;

    /// <summary>
    /// Whether the panel has been filled in, which it is the first time the chip is reached.
    /// </summary>
    /// <remarks>
    /// Always, rather than only when deferred: a chip that is not deferred is built with its panel
    /// already open for business, so this starts true for it and nothing here ever runs.
    /// </remarks>
    private bool _revealed;

    protected override void OnInitialized() => _revealed = !Deferred;

    /// <summary>Fills the panel in, the first time a pointer or the keyboard arrives.</summary>
    private void Reveal() => _revealed = true;

    /// <summary>
    /// Ties the panel to its button, uniquely on the page.
    /// </summary>
    /// <remarks>
    /// A popover is addressed by id, and an empire's own traits appear beside a second species'
    /// which may hold the same one — so the key alone is not unique enough to name it by.
    /// </remarks>
    private readonly string _id = $"chip-{Guid.NewGuid():N}";

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Deferred)
        {
            return;
        }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Sem.Ui/sem.js");
        await _module.InvokeVoidAsync("bindPopover", _anchor, _panel, !Opens);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
    }
}
