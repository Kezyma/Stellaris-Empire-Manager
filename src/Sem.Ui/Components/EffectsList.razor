@*
    What one option does, laid out the way the game lays it out.

    The order matters and is the game's: what it gives you, then what it lets you do, then what it
    costs you. An option that writes its own description has that shown instead of the bare numbers,
    because the game suppresses the list in that case and showing both would state the same bonus
    twice.
*@


@if (Effects is null || Effects.IsEmpty)
{
    @if (ShowNothing)
    {
        <p class="sem-effects-none">No effects.</p>
    }
}
else
{
    <div class="sem-effects">
        @if (Said(Effects.DescriptionKey) is { } description)
        {
            <div class="sem-effects-text">@((MarkupString)description)</div>
        }

        @if (Said(Effects.TooltipKey) is { } tooltip)
        {
            <div class="sem-effects-text">@((MarkupString)tooltip)</div>
        }

        @if (Modifiers.Count > 0)
        {
            <ul class="sem-modifiers">
                @foreach (var modifier in Modifiers)
                {
                    <li>
                        <span class="label">@((MarkupString)Session.Modifiers.LabelHtml(modifier.Key))</span>
                        <span class="value @ToneClass(modifier.Tone)">@modifier.Value</span>
                    </li>
                }
            </ul>
        }

        @foreach (var tag in Effects.TagKeys)
        {
            @if (Said(tag) is { } words)
            {
                <div class="sem-effects-text">@((MarkupString)words)</div>
            }
        }

        @foreach (var conditional in Effects.Conditional)
        {
            var when = Session.Conditions.Describe(conditional.When);

            <div class="sem-effects-when">
                <div class="when">@(when is null ? "In some empires" : $"When {when}")</div>

                @*
                    The numbers, unless the game wrote a sentence to stand in for them. A swap that
                    says custom_tooltip is saying "describe it this way instead", and fifty-two of
                    them bring no numbers at all - for those empires the option does something else
                    entirely, and printing the ones it replaced said the opposite of the truth.
                *@
                @if (!conditional.TooltipReplacesModifiers)
                {
                    <ul class="sem-modifiers">
                        @foreach (var modifier in Session.Modifiers.Format(conditional.Modifiers))
                        {
                            <li>
                                <span class="label">@((MarkupString)Session.Modifiers.LabelHtml(modifier.Key))</span>
                                <span class="value @ToneClass(modifier.Tone)">@modifier.Value</span>
                            </li>
                        }
                    </ul>
                }

                @if (conditional.TooltipKey is { Length: > 0 } said)
                {
                    @if (Said(said) is { } words)
                    {
                        <div class="sem-effects-text">@((MarkupString)words)</div>
                    }
                }

                @foreach (var tag in conditional.TagKeys)
                {
                    @if (Said(tag) is { } words)
                    {
                        <div class="sem-effects-text">@((MarkupString)words)</div>
                    }
                }
            </div>
        }

        @if (Effects.PenaltyKey is { Length: > 0 } penalty)
        {
            <div class="sem-effects-penalty">
                <div class="heading">Penalties</div>
                @if (Said(penalty) is { } words)
                {
                    <div class="sem-effects-text">@((MarkupString)words)</div>
                }
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// The text these effects are written in, where a page carries its own.
    /// </summary>
    /// <remarks>
    /// Absent everywhere but a wiki page built from one of the wiki's own files. A leader trait says
    /// most of what it does through a tooltip rather than through numbers, and that sentence is in
    /// the file rather than in the app's own localisation - so read from the session it came back as
    /// the key prettified: "Leader Trait Adventurous Spirit Effect".
    /// </remarks>
    [CascadingParameter(Name = "WikiText")]
    public Localizer? Reader { get; set; }

    /// <summary>Whichever reader answers here.</summary>
    private Localizer Wording => Reader ?? Session.Localizer;

    /// <summary>
    /// What a key says, or nothing where it says something only a running game could finish.
    /// </summary>
    /// <remarks>
    /// The game answers some of these with a bracketed command rather than a sentence -
    /// <c>[GetAdventurousSpiritEffect]</c> - because what it says depends on the leader holding the
    /// trait. Drawn as it stands it is not a description of anything, and read from a file that does
    /// not carry it at all it comes back as the key prettified, which is worse. Either way the
    /// modifiers beside it are the real answer, so the line is left out.
    /// </remarks>
    /// <param name="key">What to say.</param>
    /// <returns>The words, or null.</returns>
    private string? Said(string? key)
    {
        if (key is not { Length: > 0 })
        {
            return null;
        }

        var words = Wording.Html(key, string.Empty);

        return words is { Length: > 0 } && !words.TrimStart().StartsWith('[') ? words : null;
    }

    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>What to describe.</summary>
    [Parameter]
    public EffectSet? Effects { get; set; }

    /// <summary>Whether to say so when there is nothing, rather than showing an empty space.</summary>
    [Parameter]
    public bool ShowNothing { get; set; }

    /// <summary>
    /// Whether to show the numbers an option hides as well as the ones it prints.
    /// </summary>
    /// <remarks>
    /// An option may say "do not list my modifiers" - because its own sentence already states them,
    /// or because the game would rather not - and a popover honours that. A breakdown of a total
    /// cannot: the arithmetic counts those numbers whatever the option would prefer, so a panel
    /// that hid them would not add up to the total printed beside it.
    /// </remarks>
    [Parameter]
    public bool AllModifiers { get; set; }

    private IReadOnlyList<FormattedModifier> Modifiers => Effects is null
        ? []
        : Session.Modifiers.Format(AllModifiers ? Effects.Modifiers : Effects.VisibleModifiers);

    private static string ToneClass(ModifierTone tone) => tone switch
    {
        ModifierTone.Good => "good",
        ModifierTone.Bad => "bad",
        _ => string.Empty,
    };
}
