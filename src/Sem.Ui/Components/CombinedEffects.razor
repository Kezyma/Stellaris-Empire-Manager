@*
    Everything the empire's choices add up to.

    Modifiers are summed rather than listed per source, because an empire whose ethic and whose civic
    both raise ship fire rate has one fire rate. Where more than one choice contributes, the panel
    says which — that is usually the interesting part.
*@

@using Sem.Rules

<div class="sem-combined">
    <div class="heading">
        <h4>@Session.Localizer.Label("SUMMARY_EMPIRE_MODIFIERS", "Empire Modifiers")</h4>

        @*
            Three questions about one set of numbers: which choice did this, what does it all come
            to, and what have I changed since I saved. Two buttons each naming a view rather than
            one that flips, as the pickers' own toggle has it - a single button has to decide
            whether its label names what you are looking at or what pressing it would do.

            Changes only where there is something to compare with: an empire nobody is editing, or
            one created and never saved, was never anything other than what it is.
        *@
        <div class="sem-view-toggle" role="group" aria-label="Modifiers">
            <button type="button" aria-pressed="@(_view == View.Individual ? "true" : "false")"
                    title="What each choice contributes"
                    @onclick="() => _view = View.Individual">Individual</button>

            <button type="button" aria-pressed="@(_view == View.Combined ? "true" : "false")"
                    title="What the empire comes to"
                    @onclick="() => _view = View.Combined">Combined</button>

            @if (Baseline is not null)
            {
                <button type="button" aria-pressed="@(_view == View.Changes ? "true" : "false")"
                        title="What your edits changed"
                        @onclick="() => _view = View.Changes">Changes</button>
            }
        </div>
    </div>

    @if (Showing == View.Individual)
    {
        <div class="sem-contributions">
            <OptionModifiers Contributions="@Contributions" />
        </div>
    }
    else if (Showing == View.Changes)
    {
        @if (Changes.Count == 0)
        {
            <p class="sem-hint">Nothing has changed since you saved.</p>
        }
        else
        {
            @*
                Both numbers, not only the difference. "-10%" says how far something moved and not
                what it moved from, and the whole point of the view is comparing the two.
            *@
            <ul class="sem-modifiers changes">
                @foreach (var change in Changes)
                {
                    var was = Session.Modifiers.Format(change.Key, change.Before);
                    var now = Session.Modifiers.Format(change.Key, change.After);
                    var delta = Session.Modifiers.Format(change.Key, change.After - change.Before);

                    <li>
                        <span class="label">@((MarkupString)Session.Modifiers.LabelHtml(change.Key))</span>

                        @* A plain hyphen for "it was not there", since em-dashes are not used in this interface. *@
                        <span class="was">@(change.Before == 0 ? "-" : was.Value)</span>
                        <span class="arrow" aria-hidden="true">→</span>
                        <span class="value @ToneClass(now.Tone)">@(change.After == 0 ? "-" : now.Value)</span>
                        <span class="delta @ToneClass(delta.Tone)">@delta.Value</span>
                    </li>
                }
            </ul>
        }
    }
    else if (Combined.Count == 0)
    {
        <p class="sem-hint">Nothing yet.</p>
    }
    else
    {
        @*
            The count comes before the total, so that every value ends in the same column whether or
            not a row has one. Behind it, the badge sat between the number and the panel's edge and
            pushed each total left by however wide it was.
        *@
        <ul class="sem-modifiers">
            @foreach (var modifier in Ordered)
            {
                var formatted = Session.Modifiers.Format(modifier.Key, modifier.Total);

                <li title="@SourceSummary(modifier)">
                    <span class="label">@((MarkupString)Session.Modifiers.LabelHtml(modifier.Key))</span>

                    @if (modifier.Sources.Count > 1)
                    {
                        <span class="sources">@modifier.Sources.Count</span>
                    }

                    <span class="value @ToneClass(formatted.Tone)">@formatted.Value</span>
                </li>
            }
        </ul>
    }

    @*
        And under the arithmetic, the things that are not arithmetic. A sentence cannot be added to
        another sentence, so these are listed rather than summed, each naming what it came from -
        the way a total names its sources in its tooltip. Deduplicated by the text itself, since
        several civics share one: BLOCKS_COUNCILOR_STATE belongs to both Inwards Perfection and
        Fanatic Purifiers.
    *@
    @if (Showing == View.Combined && Worded.Count > 0)
    {
        <div class="sem-combined-worded">
            @foreach (var (line, sources) in Worded)
            {
                <div class="worded" @key="line">
                    <div class="sem-effects-text">@((MarkupString)line)</div>
                    <div class="from">@string.Join(", ", sources)</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>
    /// The empire to add up, where it is not the one being edited.
    /// </summary>
    /// <remarks>
    /// The select screen shows empires nobody has opened — the player's other designs, and the
    /// game's own — and each of those has a context of its own. Without this the panel could only
    /// ever describe whatever happened to be open, which on that screen is the wrong empire or none.
    /// </remarks>
    [Parameter]
    public DesignContext? Context { get; set; }

    /// <summary>
    /// The same empire as it was when it was last saved, where there is such a thing.
    /// </summary>
    /// <remarks>
    /// Supplied by the designer and by nothing else, the way <c>ShowProblems</c> is: the select
    /// screen shows empires nobody is editing, and an empire that has never been saved has no
    /// earlier self to be compared against.
    /// </remarks>
    [Parameter]
    public DesignContext? Baseline { get; set; }

    /// <summary>Which of the three questions the panel is answering.</summary>
    private enum View
    {
        /// <summary>What each choice contributes.</summary>
        Individual,

        /// <summary>What the empire comes to.</summary>
        Combined,

        /// <summary>What the edits since the last save moved.</summary>
        Changes,
    }

    private View _view = View.Combined;

    /// <summary>
    /// The view actually drawn, which is not always the one asked for.
    /// </summary>
    /// <remarks>
    /// Changes needs something to compare against. Saving an empire, or opening one on the select
    /// screen, can take the baseline away underneath a panel already showing it - so the fallback
    /// is here rather than in the handler, where it would depend on the order things happened in.
    /// </remarks>
    private View Showing => _view == View.Changes && Baseline is null ? View.Combined : _view;

    /// <summary>One modifier that is not what it was.</summary>
    /// <param name="Key">The modifier.</param>
    /// <param name="Before">What it came to when the empire was last saved; zero if it was absent.</param>
    /// <param name="After">What it comes to now; zero if it has gone.</param>
    private sealed record Change(string Key, double Before, double After);

    /// <summary>
    /// Every modifier the edits since the last save have moved.
    /// </summary>
    /// <remarks>
    /// A modifier missing from one side counts as zero on that side rather than being skipped, so a
    /// bonus that has appeared or vanished entirely is a change like any other and reads as one.
    /// </remarks>
    private IReadOnlyList<Change> Changes
    {
        get
        {
            if (Baseline is not { } baseline)
            {
                return [];
            }

            var before = DesignEffects.Combine(baseline).ToDictionary(m => m.Key, m => m.Total, StringComparer.Ordinal);
            var after = Combined.ToDictionary(m => m.Key, m => m.Total, StringComparer.Ordinal);

            return
            [
                .. before.Keys.Union(after.Keys, StringComparer.Ordinal)
                    .Select(key => new Change(
                        key,
                        before.GetValueOrDefault(key),
                        after.GetValueOrDefault(key)))
                    .Where(c => c.Before != c.After)
                    .OrderBy(c => Session.Modifiers.Label(c.Key), StringComparer.CurrentCulture)
            ];
        }
    }

    private IReadOnlyList<CombinedModifier> Combined =>
        (Context ?? Session.Context) is { } context ? DesignEffects.Combine(context) : [];

    /// <summary>Each chosen option that changes something, with everything it changes.</summary>
    private IReadOnlyList<OptionContribution> Contributions =>
        (Context ?? Session.Context) is { } context
            ? [.. DesignEffects.Selected(context)
                .Where(o => !o.Effects.IsEmpty)
                .Select(o => new OptionContribution(Named(context, o.Key), o.Effects))]
            : [];

    /// <summary>
    /// The parts of what an empire's choices do that are words rather than numbers.
    /// </summary>
    /// <remarks>
    /// An option states these three ways - a description of its effect, a hand-written tooltip, and
    /// tag lines naming capabilities rather than amounts - and 130 of the game's options say
    /// everything they do this way and carry no modifier at all. Keyed by the rendered line so one
    /// sentence appears once however many choices carry it, and so the sources gather under it.
    /// </remarks>
    private IReadOnlyList<(string Line, IReadOnlyList<string> Sources)> Worded
    {
        get
        {
            var lines = new Dictionary<string, List<string>>(StringComparer.Ordinal);

            foreach (var contribution in Contributions)
            {
                foreach (var key in Wording(contribution.Effects))
                {
                    if (Session.Localizer.Html(key, string.Empty) is not { Length: > 0 } line)
                    {
                        continue;
                    }

                    if (!lines.TryGetValue(line, out var sources))
                    {
                        lines[line] = sources = [];
                    }

                    if (!sources.Contains(contribution.Option.Name, StringComparer.CurrentCulture))
                    {
                        sources.Add(contribution.Option.Name);
                    }
                }
            }

            return [.. lines.Select(p => (p.Key, (IReadOnlyList<string>)p.Value))];
        }
    }

    private static IEnumerable<string> Wording(EffectSet effects) =>
        new[] { effects.DescriptionKey, effects.TooltipKey, effects.PenaltyKey }
            .OfType<string>()
            .Concat(effects.TagKeys);

    /// <summary>
    /// One option by key, whatever kind of option it is.
    /// </summary>
    /// <remarks>
    /// The contributions arrive as keys alone, and the four kinds that carry effects are spread
    /// across three collections. The lite card asks the same question of EmpireView; this panel is
    /// also drawn for empires nobody has opened, which have no view.
    /// </remarks>
    private EmpireChoice Named(DesignContext context, string key)
    {
        var database = context.Database;

        if (database.Ethics.FirstOrDefault(e => e.Key == key) is { } ethic)
        {
            return new EmpireChoice(key, Session.Localizer.Text(key), ethic.Icon, ethic.Effects);
        }

        if (database.Authorities.FirstOrDefault(a => a.Key == key) is { } authority)
        {
            return new EmpireChoice(key, Session.Localizer.Text(key), authority.Icon, authority.Effects);
        }

        if (database.Civics.FirstOrDefault(c => c.Key == key) is { } civic)
        {
            return new EmpireChoice(key, Session.Localizer.Text(key), civic.Icon, civic.Effects);
        }

        var trait = database.Traits.FirstOrDefault(t => t.Key == key);

        return new EmpireChoice(key, Session.Localizer.Text(key), trait?.Icon, trait?.Effects);
    }

    /// <summary>
    /// The totals in the order they will be read in.
    /// </summary>
    /// <remarks>
    /// <para>
    /// By the name shown, not by the key behind it. The rules sort by key because the rules have no
    /// localiser, and the key is not what anybody sees: <c>country_claim_influence_cost_mult</c>
    /// sorts under C and reads "Claim Influence Cost", <c>army_damage_mult</c> sorts under A and
    /// reads "Army Damage". The result looked shuffled because it was sorted by a word that is not
    /// on the screen.
    /// </para>
    /// <para>
    /// Alphabetical and nothing more. A grouping was looked for first and there is none to read: the
    /// game has no modifier categories, and of the 564 modifiers an empire's choices can reach, 269
    /// begin with no scope word at all — so headings would have put half of them under "other".
    /// Sorting by name gathers the families anyway, since the game's own labels lead with the thing
    /// they are about: every "Job Efficiency for…" lands together, and so does every "Pop …".
    /// </para>
    /// </remarks>
    private IReadOnlyList<CombinedModifier> Ordered =>
        [.. Combined.OrderBy(m => Session.Modifiers.Label(m.Key), StringComparer.CurrentCulture)];

    /// <summary>Names the choices behind a total, for the reader who wonders where it came from.</summary>
    private string SourceSummary(CombinedModifier modifier) =>
        string.Join(
            ", ",
            modifier.Sources.Select(s =>
                $"{Session.Localizer.Text(s.SourceKey)} {Session.Modifiers.Format(modifier.Key, s.Value).Value}"));

    private static string ToneClass(ModifierTone tone) => tone switch
    {
        ModifierTone.Good => "good",
        ModifierTone.Bad => "bad",
        _ => string.Empty,
    };
}
