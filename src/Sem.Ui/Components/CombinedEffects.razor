@*
    Everything the empire's choices add up to.

    Modifiers are summed rather than listed per source, because an empire whose ethic and whose civic
    both raise ship fire rate has one fire rate. Where more than one choice contributes, the panel
    says which — that is usually the interesting part.
*@

@using Sem.Rules

<div class="sem-combined">
    <h4>@Session.Localizer.Label("SUMMARY_EMPIRE_MODIFIERS", "Empire Modifiers")</h4>

    @if (Combined.Count == 0)
    {
        <p class="sem-hint">Nothing yet.</p>
    }
    else
    {
        @*
            The count comes before the total, so that every value ends in the same column whether or
            not a row has one. Behind it, the badge sat between the number and the panel's edge and
            pushed each total left by however wide it was.
        *@
        <ul class="sem-modifiers">
            @foreach (var modifier in Ordered)
            {
                var formatted = Session.Modifiers.Format(modifier.Key, modifier.Total);

                <li title="@SourceSummary(modifier)">
                    <span class="label">@((MarkupString)Session.Modifiers.LabelHtml(modifier.Key))</span>

                    @if (modifier.Sources.Count > 1)
                    {
                        <span class="sources">@modifier.Sources.Count</span>
                    }

                    <span class="value @ToneClass(formatted.Tone)">@formatted.Value</span>
                </li>
            }
        </ul>

        @*
            Only where something actually was left out. This had been printed under every empire,
            including the many whose choices carry no conditional modifier at all — a footnote about
            an omission that had not happened.
        *@
        @if (AnyConditional)
        {
            <p class="sem-hint">
                Conditional bonuses are left out, since they depend on a game already in progress.
            </p>
        }
    }
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>
    /// The empire to add up, where it is not the one being edited.
    /// </summary>
    /// <remarks>
    /// The select screen shows empires nobody has opened — the player's other designs, and the
    /// game's own — and each of those has a context of its own. Without this the panel could only
    /// ever describe whatever happened to be open, which on that screen is the wrong empire or none.
    /// </remarks>
    [Parameter]
    public DesignContext? Context { get; set; }

    private IReadOnlyList<CombinedModifier> Combined =>
        (Context ?? Session.Context) is { } context ? DesignEffects.Combine(context) : [];

    /// <summary>
    /// The totals in the order they will be read in.
    /// </summary>
    /// <remarks>
    /// <para>
    /// By the name shown, not by the key behind it. The rules sort by key because the rules have no
    /// localiser, and the key is not what anybody sees: <c>country_claim_influence_cost_mult</c>
    /// sorts under C and reads "Claim Influence Cost", <c>army_damage_mult</c> sorts under A and
    /// reads "Army Damage". The result looked shuffled because it was sorted by a word that is not
    /// on the screen.
    /// </para>
    /// <para>
    /// Alphabetical and nothing more. A grouping was looked for first and there is none to read: the
    /// game has no modifier categories, and of the 564 modifiers an empire's choices can reach, 269
    /// begin with no scope word at all — so headings would have put half of them under "other".
    /// Sorting by name gathers the families anyway, since the game's own labels lead with the thing
    /// they are about: every "Job Efficiency for…" lands together, and so does every "Pop …".
    /// </para>
    /// </remarks>
    private IReadOnlyList<CombinedModifier> Ordered =>
        [.. Combined.OrderBy(m => Session.Modifiers.Label(m.Key), StringComparer.CurrentCulture)];

    /// <summary>Whether anything the empire has chosen carries a bonus the totals leave out.</summary>
    private bool AnyConditional =>
        (Context ?? Session.Context) is { } context && DesignEffects.AnyConditional(context);

    /// <summary>Names the choices behind a total, for the reader who wonders where it came from.</summary>
    private string SourceSummary(CombinedModifier modifier) =>
        string.Join(
            ", ",
            modifier.Sources.Select(s =>
                $"{Session.Localizer.Text(s.SourceKey)} {Session.Modifiers.Format(modifier.Key, s.Value).Value}"));

    private static string ToneClass(ModifierTone tone) => tone switch
    {
        ModifierTone.Good => "good",
        ModifierTone.Bad => "bad",
        _ => string.Empty,
    };
}
