@*
    Type anything, or choose from a list that always opens.

    The browser's own datalist cannot do the second part: it filters itself by whatever is in the
    box, so the moment a name is entered the list shrinks to that one entry and appears to stop
    working. There is no way to turn that off, hence this.
*@

@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    Whether the list is drawn is this component's own business, and nothing else's.

    It used to close when the text box lost focus, which meant tabbing towards the options dismissed
    them on the way: the list could be used with a mouse and by nothing else. Asking the stylesheet
    to hide it unless focus was inside the box fixed that and broke something worse — a finger does
    not move focus at all, so on a phone the list was drawn and hidden in the same breath and the
    box appeared to do nothing.

    So the flag decides, and the three ways of closing it are all things this component can see:
    Escape, choosing an option, and pressing the arrow again. The fourth — a press somewhere else on
    the page — is the one it cannot, and sem.js watches for that. The toggle is tabbable because it
    was the only way to open the list and could not be reached by keyboard at all.
*@
<div class="sem-combo @(_open ? "open" : null)" @onkeydown="Dismiss">
    <input type="text"
           id="@Id"
           value="@Value"
           disabled="@Disabled"
           placeholder="@Placeholder"
           @onchange="e => Commit(e.Value?.ToString())"
           @onfocus="() => _open = false" />

    <button type="button"
            class="toggle"
            disabled="@Disabled"
            title="@(_open ? "Close the list" : "Show every option")"
            aria-label="@(_open ? "Close the list" : "Show every option")"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="() => _open = !_open">▾</button>

    @if (_open && Options.Count > 0)
    {
        <ul class="options">
            @foreach (var option in Options)
            {
                @*
                    Suppressing the mousedown keeps the input from losing focus before the click
                    lands, which is what would otherwise close the list out from under the pointer.
                *@
                <li>
                    <button type="button"
                            class="@(option == Value ? "selected" : null)"
                            @onmousedown:preventDefault="true"
                            @onclick="() => Commit(option)">@option</button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private bool _open;

    private IJSObjectReference? _module;

    /// <summary>
    /// Asks for the one document-level listener that closes an open list on a press outside it.
    /// </summary>
    /// <remarks>
    /// Every box asks, and the script installs it once: a page-wide listener is not something a
    /// single box can own, and which box happens to render first is not worth depending on. Asking
    /// per box is what keeps it right when the page is reloaded under a host that outlives it.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Sem.Ui/sem.js");
        await _module.InvokeVoidAsync("closeListsOnOutsidePress");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
    }

    /// <summary>Escape closes the list, wherever inside the box the keyboard happens to be.</summary>
    private void Dismiss(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }

    /// <summary>The identifier a label points at.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>What the box currently holds.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Everything the list offers, shown in full however much has been typed.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<string> Options { get; set; }

    /// <summary>Text shown while the box is empty.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Whether the field is offered at all.
    /// </summary>
    /// <remarks>
    /// Shown and disabled rather than hidden, where a setting makes it meaningless: an heir's title
    /// is nothing to an elected government, and a box that vanishes leaves a reader wondering what
    /// used to be there. Whatever a design already holds is kept and still written back.
    /// </remarks>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Called with whatever was typed or chosen.</summary>
    [Parameter]
    public EventCallback<string> OnChange { get; set; }

    private async Task Commit(string? value)
    {
        _open = false;
        await OnChange.InvokeAsync(value ?? string.Empty);
    }
}
