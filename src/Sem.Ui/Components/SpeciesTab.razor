@*
    A species, in the order the questions arise: what it is called, what it looks like, and what it
    is good at.

    The same three subsections serve the founder species and the second one some origins call for,
    since the questions are the same either way.
*@

<div class="sem-subsections">
    <section>
        <h4>Names</h4>
        <SpeciesNames Species="@Species" />
    </section>

    <section>
        <h4>Portrait</h4>
        <PortraitPicker Species="@Species" />
    </section>

    <section>
        <h4>Traits</h4>
        <TraitPicker Species="@Species" />
    </section>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The species being designed, which may be the second one.</summary>
    [Parameter, EditorRequired]
    public required SpeciesDesign Species { get; set; }
}
