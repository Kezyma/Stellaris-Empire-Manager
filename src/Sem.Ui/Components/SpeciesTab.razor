@*
    The founder species, in the order the questions arise: what it is called, what it looks like,
    and what it is good at.
*@

<div class="sem-subsections">
    <section>
        <h4>Names</h4>
        <SpeciesNames />
    </section>

    <section>
        <h4>Portrait</h4>
        <PortraitPicker Species="@Species" />
    </section>

    <section>
        <h4>Traits</h4>
        <TraitPicker />
    </section>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private SpeciesDesign Species => Session.Current!.Species;
}
