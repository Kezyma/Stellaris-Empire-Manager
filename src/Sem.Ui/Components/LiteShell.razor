@implements IDisposable

@*
    The lite editor: the card, and whichever editor the card asked for.

    The other half of DesignerShell rather than a page of its own. Everything that makes the designer
    work - the session, the unsaved-work guard, the save and revert and delete, the shared link and
    the address bar - belongs to Designer.razor and is untouched by which of the two bodies it draws.
    So this holds a card, a dialog, and the mapping from one to the other, and nothing else.

    The editors inside the dialog are the same components the sections use. Not copies of them, not
    trimmed versions: the flag picker in here is the flag picker in there, so a fix to one is a fix
    to both and there is no second answer to what an origin costs.
*@

@*
    The session is cascaded here, as the sections' shell cascades it, because every editor that goes
    in the dialog expects to find it that way and the dialog is rendered from here.
*@
<CascadingValue Value="Session">
<div class="sem-lite-shell">
    @if (Session.Current is null)
    {
        <div class="sem-empty">
            <p>No empire is open.</p>
        </div>
    }
    else
    {
        @if (Actions is not null)
        {
            <div class="sem-lite-actions">@Actions</div>
        }

        <LiteCard Design="Session.Current" Baseline="@Session.SavedContext" OnEdit="Open" />

        @if (_editing is { } part)
        {
            <EditorDialog Title="@TitleOf(part)" OnClose="Close">
                @Editor(part)
            </EditorDialog>
        }
    }
</div>
</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public required DesignSession Session { get; set; }

    /// <summary>The save, revert, delete and share row, which both editors get from the page.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Which editor is open, and nothing when none is.</summary>
    private LitePart? _editing;

    protected override void OnInitialized() => Session.Changed += OnChanged;

    public void Dispose() => Session.Changed -= OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Open(LitePart part) => _editing = part;

    private void Close() => _editing = null;

    /// <summary>
    /// What the dialog is called.
    /// </summary>
    /// <remarks>
    /// The names the sections already use, rather than a second set looked up from the game's keys.
    /// The same editor opened from either shell has to be called the same thing, and the game's keys
    /// name whole screens rather than single editors: they titled the empire's settings "Empire
    /// Name", which is the one thing that dialog does not hold, and the species editor "Species
    /// Class", which is one field of the several in it.
    /// </remarks>
    private static string TitleOf(LitePart part) => part switch
    {
        LitePart.Empire => "Empire",
        LitePart.Government => "Government",
        LitePart.Origin => "Origin",
        LitePart.Species => "Species",
        LitePart.Portrait => "Portrait",
        LitePart.Traits => "Traits",
        LitePart.SecondSpecies => "Second species",
        LitePart.Ruler => "Ruler",
        LitePart.Homeworld => "Homeworld",
        LitePart.Flag => "Flag",
        LitePart.Room => "Room",
        LitePart.Shipset => "Shipset",
        _ => "Advisor Voice",
    };

    /// <summary>
    /// The editor for one part, which is in every case a component the sections already use.
    /// </summary>
    /// <remarks>
    /// Eleven of them need nothing but the cascading session and go in as they are. The four about a
    /// species need to be told which one, and that is the only thing this decides - the founders,
    /// except for the second-species dialog.
    /// </remarks>
    private RenderFragment Editor(LitePart part) => builder =>
    {
        var design = Session.Current!;

        switch (part)
        {
            case LitePart.Empire:
                builder.OpenComponent<EmpireSection>(10);
                builder.CloseComponent();
                break;

            case LitePart.Government:
                builder.OpenComponent<GovernmentTab>(20);
                builder.CloseComponent();
                break;

            case LitePart.Origin:
                builder.OpenComponent<OriginTab>(30);
                builder.CloseComponent();
                break;

            case LitePart.Species:
                builder.OpenComponent<SpeciesTab>(40);
                builder.AddComponentParameter(41, nameof(SpeciesTab.Species), design.Species);
                builder.AddComponentParameter(42, nameof(SpeciesTab.Founder), true);
                builder.CloseComponent();
                break;

            case LitePart.Portrait:
                builder.OpenComponent<PortraitPicker>(50);
                builder.AddComponentParameter(51, nameof(PortraitPicker.Species), design.Species);
                builder.AddComponentParameter(52, nameof(PortraitPicker.Founder), true);
                builder.CloseComponent();
                break;

            case LitePart.Traits:
                builder.OpenComponent<TraitPicker>(60);
                builder.AddComponentParameter(61, nameof(TraitPicker.Species), design.Species);
                builder.CloseComponent();
                break;

            case LitePart.SecondSpecies when design.SecondarySpecies is { } second:
                builder.OpenComponent<SpeciesTab>(70);
                builder.AddComponentParameter(71, nameof(SpeciesTab.Species), second);
                builder.CloseComponent();
                break;

            case LitePart.Ruler:
                builder.OpenComponent<RulerTab>(80);
                builder.CloseComponent();
                break;

            case LitePart.Homeworld:
                builder.OpenComponent<HomeworldTab>(90);
                builder.CloseComponent();
                break;

            case LitePart.Flag:
                builder.OpenComponent<FlagTab>(100);
                builder.CloseComponent();
                break;

            case LitePart.Room:
                builder.OpenComponent<RoomTab>(110);
                builder.CloseComponent();
                break;

            case LitePart.Shipset:
                builder.OpenComponent<ShipsetTab>(120);
                builder.CloseComponent();
                break;

            case LitePart.Advisor:
                builder.OpenComponent<AdvisorTab>(130);
                builder.CloseComponent();
                break;

            default:
                // SecondSpecies with no second species, which the card cannot offer and a stale
                // click could still ask for.
                break;
        }
    };
}
