@*
    What the species is called, and where its other names come from.

    Each of the three name fields is a combobox: type anything, or pick from the ready-made species
    the game itself would draw on for this class. Picking one fills the other two, because the three
    belong together — "Alari", "Alari", "Alarian" is one species described three ways, and choosing
    a name only to be left with the previous species' adjective is a trap.
*@

<div class="sem-row" style="justify-content:space-between;margin-bottom:8px">
    <span class="sem-hint" style="margin:0">Type a name, or choose one the game would give.</span>
    <button type="button" title="A species, its homeworld and its home system together"
            @onclick="RandomiseSpecies">Randomise</button>
</div>

<div class="sem-field">
    <label for="species-name">Species</label>
    <input id="species-name" type="text" list="species-name-options"
           value="@Species.Name.Key" @onchange="e => ChooseName(e.Value?.ToString())" />
    <datalist id="species-name-options">
        @foreach (var suggestion in Suggestions)
        {
            <option value="@suggestion.Name"></option>
        }
    </datalist>
</div>

<div class="sem-field">
    <label for="species-plural">Plural</label>
    <input id="species-plural" type="text" list="species-plural-options"
           value="@Species.Plural.Key" @onchange="e => ChoosePlural(e.Value?.ToString())" />
    <datalist id="species-plural-options">
        @foreach (var plural in Suggestions.Select(s => s.Plural).OfType<string>().Distinct(StringComparer.Ordinal))
        {
            <option value="@plural"></option>
        }
    </datalist>
</div>

<div class="sem-field">
    <label for="species-adjective">Adjective</label>
    <input id="species-adjective" type="text" list="species-adjective-options"
           value="@Species.Adjective.Key" @onchange="e => ChooseAdjective(e.Value?.ToString())" />
    <datalist id="species-adjective-options">
        @foreach (var adjective in Suggestions.Select(s => NameGenerator.Adjective(s.Name)).Distinct(StringComparer.Ordinal))
        {
            <option value="@adjective"></option>
        }
    </datalist>
</div>

<div class="sem-field">
    <label for="name-list">Name list</label>
    <select id="name-list" @onchange="e => Session.Edit(d => d.Species.NameList = e.Value?.ToString())">
        @foreach (var group in NameLists)
        {
            <optgroup label="@group.Key">
                @foreach (var list in group)
                {
                    <option value="@list.Key" selected="@(list.Key == Species.NameList)">
                        @ListName(list)
                    </option>
                }
            </optgroup>
        }
    </select>
</div>

@* What the list actually holds, since "Mammalian 1" says nothing about how its names sound. *@
@foreach (var (label, names) in Sets)
{
    <div class="sem-field sem-name-set">
        <label>@label <span class="count">@names.Count</span></label>
        <textarea readonly rows="3">@string.Join(", ", names)</textarea>
    </div>
}

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private SpeciesDesign Species => Design.Species;

    private DesignContext Context => Session.Context!;

    private readonly RequirementEvaluator _evaluator = new();

    /// <summary>
    /// The ready-made species this class could be given, which is what the game's own randomise
    /// draws on. A class the game ships none for still gets the whole set rather than an empty list.
    /// </summary>
    private IReadOnlyList<SpeciesNameSuggestion> Suggestions
    {
        get
        {
            var all = Session.Data.Database.SpeciesNames;

            var forClass = all
                .Where(s => string.Equals(s.SpeciesClass, Species.Class, StringComparison.Ordinal))
                .ToList();

            return [.. (forClass.Count > 0 ? forClass : all).OrderBy(s => s.Name, StringComparer.CurrentCulture)];
        }
    }

    /// <summary>
    /// The name lists a player may choose. A dozen exist only for the game's own creatures, and the
    /// game marks those unselectable rather than removing them.
    /// </summary>
    private IEnumerable<IGrouping<string, NameListDefinition>> NameLists =>
        Session.Data.Database.NameLists
            .Where(n => _evaluator.IsSatisfied(n.Selectable, Context))
            .GroupBy(n => n.Category ?? "Other")
            .OrderBy(g => g.Key, StringComparer.CurrentCulture);

    private string ListName(NameListDefinition list) => Session.Localizer.Text(list.NameKey, list.Key);

    /// <summary>
    /// The pools of names the chosen list holds, labelled as the game labels them.
    /// </summary>
    /// <remarks>
    /// A list either names its leaders outright or builds them from a first and a family name, so
    /// which sets exist depends on the list. Empty ones are left out rather than shown blank.
    /// </remarks>
    private IEnumerable<(string Label, IReadOnlyList<string> Names)> Sets
    {
        get
        {
            if (Session.Data.Database.NameLists.FirstOrDefault(n => n.Key == Species.NameList) is not { } list)
            {
                yield break;
            }

            var characters = list.CharacterNames;

            // A list either names its leaders outright or builds them from a first and a family
            // name, and some do both. Whichever it has is what is shown.
            if (characters.FullNames.All is { Count: > 0 } full)
            {
                yield return ("Leader names", full);
            }

            if (characters.FirstNames.All is { Count: > 0 } firsts)
            {
                yield return ("Leader first names", firsts);
            }

            if (characters.SecondNames.All is { Count: > 0 } seconds)
            {
                yield return ("Leader family names", seconds);
            }

            if (list.ShipNames.Count > 0)
            {
                yield return ("Ship names", list.ShipNames);
            }

            if (list.FleetNames.Count > 0)
            {
                yield return ("Fleet names", list.FleetNames);
            }

            if (list.PlanetNames.Count > 0)
            {
                yield return ("Colony names", list.PlanetNames);
            }
        }
    }

    private void ChooseName(string? value) =>
        Apply(value, s => s.Name, d => d.Species.Name);

    private void ChoosePlural(string? value) =>
        Apply(value, s => s.Plural, d => d.Species.Plural);

    private void ChooseAdjective(string? value) =>
        Apply(value, s => NameGenerator.Adjective(s.Name), d => d.Species.Adjective);

    /// <summary>
    /// Records what was typed, and fills the other two names when it names a species the game knows.
    /// </summary>
    /// <remarks>
    /// Text matching nothing is kept exactly as typed. That is the difference between a combobox and
    /// a dropdown, and an empire called something the game never thought of is the normal case.
    /// </remarks>
    private void Apply(
        string? value,
        Func<SpeciesNameSuggestion, string?> matching,
        Func<EmpireDesign, LocRef> field)
    {
        var text = value ?? string.Empty;

        var chosen = Suggestions.FirstOrDefault(s =>
            string.Equals(matching(s), text, StringComparison.Ordinal));

        Session.Edit(d =>
        {
            if (chosen is null)
            {
                field(d).SetLiteral(text);
                return;
            }

            d.Species.Name.SetLiteral(chosen.Name);
            d.Species.Plural.SetLiteral(chosen.Plural ?? chosen.Name);
            d.Species.Adjective.SetLiteral(NameGenerator.Adjective(chosen.Name));
        });
    }

    /// <summary>
    /// Fills in the species and where it came from together, which is what the game's own button
    /// does: one ready-made species supplies the name, its plural, a homeworld, a home system and a
    /// name list that suit each other.
    /// </summary>
    private void RandomiseSpecies()
    {
        if (Session.Names.Species(Species.Class) is not { } suggestion)
        {
            return;
        }

        Session.Edit(d =>
        {
            d.Species.Name.SetLiteral(suggestion.Name);
            d.Species.Plural.SetLiteral(suggestion.Plural ?? suggestion.Name);
            d.Species.Adjective.SetLiteral(NameGenerator.Adjective(suggestion.Name));

            if (suggestion.NameList is { Length: > 0 } list)
            {
                d.Species.NameList = list;
            }

            if (suggestion.HomePlanet is { Length: > 0 } planet)
            {
                d.PlanetName.SetLiteral(planet);
            }

            if (suggestion.HomeSystem is { Length: > 0 } system)
            {
                d.SystemName.SetLiteral(system);
            }
        });
    }
}
