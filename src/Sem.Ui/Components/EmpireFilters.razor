@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IDisposable
@implements IAsyncDisposable

@*
    What the reader is looking for, in a card above the lists.

    Above rather than inside the table, and deliberately: a filter row wedged into a header is a row
    that fights the columns for width, disappears when its column is hidden, and has nowhere to put
    a control that narrows something the table is not currently showing. These narrow the empires,
    not the columns, so they sit with the question rather than with the answer.

    One set for both lists. "Which of these are Fanatic Purifiers" is not a question about the
    player's empires or about the game's, and answering it twice with two sets of controls would be
    two chances to have them disagree.

    Written from the table of headings rather than one block per heading. There are thirteen, every
    one is the same control asking the same question of a different field, and thirteen copies is
    thirteen chances for one of them to be wired to the wrong set.
*@

<div class="sem-filters @(_open ? "open" : null)">
    <div class="head">
        @*
            The heading is the way to fold the card away. On a phone it is thirteen controls between
            the reader and the empires they came for, and every one of them is a question they have
            not asked yet.
        *@
        <button type="button" class="fold" aria-expanded="@(_open ? "true" : "false")"
                @onclick="() => _open = !_open">
            <span class="chevron" aria-hidden="true">@(_open ? "▾" : "▸")</span>
            <h2>Empire Filter</h2>
        </button>

        @if (Filter.Any)
        {
            @*
                Outside the fold, so a filter somebody folded away can still be cleared - and so a
                card that is narrowing the lists says so while it is shut.
            *@
            <button type="button" class="sem-clear" @onclick="Clear">Clear</button>
        }
    </div>

    <div class="body">
    <div class="controls">
        @*
            One box for everything somebody typed - the empire's name, its species, its world, its
            ruler, the prefix on its ships, and the biographies. Which field a word came from is
            rarely the question; the question is which empire it was.
        *@
        <div class="sem-field flush search">
            <label for="empire-search">Search</label>
            <input id="empire-search" type="text" placeholder="Any word anyone typed"
                   value="@Filter.Search"
                   @oninput="e => Search(e.Value?.ToString())" />
        </div>

        @foreach (var facet in EmpireFacet.All)
        {
            var options = Offered(facet);

            <div class="sem-field flush">
                <label>@facet.Label</label>

                <MultiSelect Label="Any" Options="@options" Selected="@Filter.Keys(facet.Key)"
                             OnChanged="OnChanged">
                    <Leading>
                        @*
                            Any or all, for a heading an empire can hold several of, and inside the
                            control it acts on rather than floating above it: it is a question about
                            this list, and a row of its own said it was about something else.

                            Two overlapping rings, shaded to say which part is being asked for. Not
                            offered where an empire holds one - asking for all of two authorities is
                            a question with no answer, and a control that can only ever empty the
                            list is a control that looks broken.
                        *@
                        @if (facet.Several)
                        {
                            <button type="button" class="mode" aria-label="@Switching(facet)"
                                    aria-pressed="@(Filter.RequiresAll(facet.Key) ? "true" : "false")"
                                    title="@Switching(facet)"
                                    @onclick="() => Switch(facet.Key)" @onclick:stopPropagation="true">
                                <ActionIcon Name="@(Filter.RequiresAll(facet.Key) ? "all" : "any")" />
                            </button>
                        }
                    </Leading>
                </MultiSelect>
            </div>
        }
    </div>

    @*
        Said once, here, rather than under every control. Two civics means either, and a civic and
        an ethic means both - which is what a set of tick boxes reads as, but not what everyone
        assumes, and the assumption is only visible in a result nobody can explain.
    *@
    <p class="sem-hint">
        Any of the things ticked under one heading, unless it is switched to all; and always all of
        the headings you use.
    </p>
    </div>
</div>

@code {
    /// <summary>
    /// Every empire there is, both lists together, which is what the choices are drawn from.
    /// </summary>
    /// <remarks>
    /// Offered rather than exhaustive: the game has eighty-one civics and a file has a handful, and
    /// a list of eighty-one where seventy-four find nothing is a list to scroll past rather than to
    /// read. What is here is what something in one of the two lists actually holds.
    /// </remarks>
    [Parameter, EditorRequired]
    public required IReadOnlyList<EmpireRow> Rows { get; set; }

    [Parameter, EditorRequired]
    public required EmpireFilter Filter { get; set; }

    /// <summary>Raised whenever the filter changed, so the page can draw the lists again.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>The choices under each heading, worked out once for the rows in hand.</summary>
    private readonly Dictionary<string, IReadOnlyList<EmpireChoice>> _offered =
        new(StringComparer.Ordinal);

    /// <summary>Whether the card is showing its controls.</summary>
    /// <remarks>
    /// Open where there is room for it and shut where there is not, which is a fact about the
    /// window rather than about the reader - so it is read once, before anything is drawn, and
    /// after that it is whatever they last pressed.
    /// </remarks>
    private bool _open = true;

    /// <summary>Below this the card starts folded, which is about where a phone is.</summary>
    private const int RoomForControls = 900;

    private IJSObjectReference? _module;

    /// <summary>The lists are worked out from the rows, so a change of rows forgets them.</summary>
    protected override void OnParametersSet() => _offered.Clear();

    /// <summary>
    /// Folds the card away on a narrow window, once, before the reader has said anything.
    /// </summary>
    /// <remarks>
    /// Asked of the browser rather than left to the stylesheet, which is where every other decision
    /// about width in this app is made. CSS can hide the controls at a width but it cannot change
    /// what the button says about them, and a chevron pointing down over a folded card is worse
    /// than the one round trip this costs.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sem.Ui/sem.js").ConfigureAwait(true);

            if (await _module.InvokeAsync<int>("viewportWidth").ConfigureAwait(true) < RoomForControls)
            {
                _open = false;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page went away first, and a card nobody is looking at may stay open.
        }
    }

    /// <summary>What the any-or-all switch is doing, said the same way in the label and the tip.</summary>
    private string Switching(EmpireFacet facet) =>
        Filter.RequiresAll(facet.Key)
            ? $"Asking for empires with every one of the {facet.Label.ToLowerInvariant()} ticked"
            : $"Asking for empires with any of the {facet.Label.ToLowerInvariant()} ticked";

    /// <summary>Everything the rows hold under one heading, once each, in the order it reads in.</summary>
    private IReadOnlyList<EmpireChoice> Offered(EmpireFacet facet)
    {
        if (_offered.TryGetValue(facet.Key, out var known))
        {
            return known;
        }

        IReadOnlyList<EmpireChoice> options =
        [
            .. Rows
                .SelectMany(facet.Values)
                .DistinctBy(c => c.Key, StringComparer.Ordinal)
                .OrderBy(c => c.Name, StringComparer.CurrentCulture)
        ];

        _offered[facet.Key] = options;
        return options;
    }

    private async Task Switch(string facet)
    {
        Filter.SetRequiresAll(facet, !Filter.RequiresAll(facet));
        await OnChanged.InvokeAsync();
    }

    /// <summary>Cancels the wait when another key arrives before the last one was acted on.</summary>
    private CancellationTokenSource? _typing;

    /// <summary>
    /// Takes what was typed, and redraws the lists once the typing stops.
    /// </summary>
    /// <remarks>
    /// Every other control here acts at once, because pressing one is a decision. Typing is not: a
    /// five-letter word is five decisions to redraw two tables, four of which are thrown away by
    /// the next keystroke, and each of them costs long enough to be felt on the way to the word.
    ///
    /// The box is not redrawn while it waits - what was typed is already in it, and putting it back
    /// from here is how a caret ends up at the start of a word.
    /// </remarks>
    private async Task Search(string? text)
    {
        Filter.Search = text ?? string.Empty;

        _typing?.Cancel();
        _typing?.Dispose();
        _typing = new CancellationTokenSource();

        try
        {
            await Task.Delay(250, _typing.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await OnChanged.InvokeAsync();
    }

    public void Dispose()
    {
        _typing?.Cancel();
        _typing?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();

        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to release.
        }
    }

    private async Task Clear()
    {
        // Nothing left to wait for, and a pending keystroke would put the search back a moment later.
        _typing?.Cancel();

        Filter.Clear();
        await OnChanged.InvokeAsync();
    }
}
