@*
    What the galaxy map draws this empire as, and the choice of whether to say so directly.

    The map takes two colours. Ordinarily it derives them from the flag - border from the primary,
    fill from the secondary - and the empire's own two map slots go unread. Turning on Independent
    Map Color reads them instead. The game states it twice, in the header of flags/colors.txt and in
    USE_MAP_COLOR_TOOLTIP: "When disabled, they are derived from the Primary and Secondary Flag
    colors."

    So the field always answers "what colour is this empire on the map", and the toggle decides
    whether there is anything under that answer to edit: with it off there is nothing here to set,
    because the colours are the flag's and the flag is where they are set. With it on, the two map
    slots appear and decide the map outright.

    The tertiary used to sit here, on the reasoning that it is the fill's fallback and had nowhere
    else to live. It lives with the flag now, which is what it is - the blue channel of the
    background, by the game's own reckoning - and a slot appearing under Map colours because of what
    the map might do with it was putting it under the wrong heading for the wrong reason.

    Drawn in the map shades rather than the flag shades, because the game keeps a pair against every
    name and this is the half that will be on screen. "Red" is not the same red in both.
*@

<div class="sem-pickers colors">
    <div class="sem-map-preview">
        <MapBlob Class="large" Border="@Shown(Design.Flag.DrawnMapBorder)" Fill="@Shown(Design.Flag.DrawnMapFill)" />

        <button type="button" class="sem-toggle" aria-pressed="@(Independent ? "true" : "false")"
                title="Manual uses the border and fill chosen here. Automatic derives them from the primary and secondary flag colours."
                @onclick="Flip">
            @(Independent ? "Manual" : "Automatic")
        </button>
    </div>

    @if (Independent)
    {
        <PickerTabs Label="Map colours" Selected="_slot" SelectedChanged="s => _slot = s" Tabs="Tabs" />
    }

    @for (var at = 0; at < Slots.Length; at++)
    {
        var index = at;

        <section class="sem-picker @(_slot == index ? null : "away")">
            <PickerHead Tab="Tabs[index]" />

            <div class="sem-swatches">
                @*
                    Letting the game decide is the ordinary answer, so it is a tile at the front
                    rather than a way of undoing a choice already made.
                *@
                <button type="button"
                        class="sem-swatch none @(Held(index) is null ? "selected" : null)"
                        title="Automatic" aria-label="Automatic"
                        aria-pressed="@(Held(index) is null ? "true" : "false")"
                        @onclick="() => Set(index, null)"></button>

                @foreach (var color in Session.Data.Database.FlagColors)
                {
                    <button type="button"
                            class="sem-swatch @(color.Key == Held(index) ? "selected" : null)"
                            style="background:@Swatch(color)"
                            title="@Localizer.Prettify(color.Key)"
                            aria-label="@Localizer.Prettify(color.Key)"
                            aria-pressed="@(color.Key == Held(index) ? "true" : "false")"
                            @onclick="() => Set(index, color.Key)"></button>
                }
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private bool Independent => Design.Flag.UseMapColor;

    /// <summary>Which palette is on show, where there is room for only one.</summary>
    private int _slot;

    /// <summary>
    /// The slots this field edits, which is none at all until the override is on.
    /// </summary>
    private static readonly (int Slot, string Title)[] Both =
        [(EmpireFlag.MapBorderSlot, "Border"), (EmpireFlag.MapFillSlot, "Fill")];

    private (int Slot, string Title)[] Slots => Independent ? Both : [];

    private PickerTabs.Tab[] Tabs =>
        [.. Slots.Select((_, at) => new PickerTabs.Tab(Slots[at].Title, Named(at), Shown(Held(at))))];

    private string? Held(int at) => Design.Flag.ColorIn(Slots[at].Slot);

    private string Named(int at) =>
        Held(at) is { Length: > 0 } key ? Localizer.Prettify(key) : "Automatic";

    /// <summary>A colour in the shade the map will draw it, which is not the flag's.</summary>
    private string? Shown(string? key) =>
        key is { Length: > 0 } named &&
        Session.Data.Database.FlagColors.FirstOrDefault(c => c.Key == named) is { } color
            ? Swatch(color)
            : null;

    private static string Swatch(FlagColorDefinition color) =>
        $"rgb({color.MapRed},{color.MapGreen},{color.MapBlue})";

    private void Set(int at, string? value) =>
        Session.Edit(d => d.Flag.SetColor(Slots[at].Slot, value));

    /// <summary>
    /// Turns the override on or off, and puts the tab back at the first palette.
    /// </summary>
    /// <remarks>
    /// The two colours are left in place when it is turned off. The game keeps them there too - an
    /// empire switched back still has its pair written in slots four and five - and throwing them
    /// away would make the toggle destructive, which a toggle should never be.
    /// </remarks>
    private void Flip()
    {
        Session.Edit(d => d.Flag.UseMapColor = !d.Flag.UseMapColor);
        _slot = 0;
    }
}
