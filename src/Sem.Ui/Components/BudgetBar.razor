@*
    Points spent against points available, which is the thing a player checks most often while
    building an empire.

    The caption is the game's own — "Trait Points Left: 2" — since the game writes the label and the
    figure as one sentence and translating half of it would read oddly. The spend against the
    allowance is ours, and stays: knowing there are two points left is less use than knowing they are
    two of five.
*@

<div class="sem-budget @StateClass">
    <div class="head">
        <span>@Session.Localizer.Counter(Key, Fallback, Value.Remaining)</span>
        <span class="value">@Value.Spent / @Value.Available</span>
    </div>
    <div class="track">
        <div class="fill" style="width:@(Percent)%"></div>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The game's key for this counter, such as <c>POINTS_LEFT</c>.</summary>
    [Parameter, EditorRequired]
    public required string Key { get; set; }

    /// <summary>What to say if a patch ever drops the key.</summary>
    [Parameter, EditorRequired]
    public required string Fallback { get; set; }

    /// <summary>The spend and the allowance.</summary>
    [Parameter, EditorRequired]
    public Budget Value { get; set; }

    private int Percent => Value.Available <= 0
        ? (Value.Spent > 0 ? 100 : 0)
        : Math.Clamp(Value.Spent * 100 / Value.Available, 0, 100);

    private string? StateClass => Value.IsOverspent
        ? "over"
        : Value.Remaining == 0 ? "full" : null;
}
