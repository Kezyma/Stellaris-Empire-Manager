@*
    Points spent against points available, which is the thing a player checks most often while
    building an empire.

    The reading sits on the bar rather than above it, so the bar is the whole of the control and a
    row of them lines up across the panel. The words are the game's — "Points", "Traits", "Ethics" —
    and the spend against the allowance is ours: knowing there are two points left is less use than
    knowing they are two of five. The game's own full sentence, "Trait Points Left: 2", is the bar's
    title, so nothing it says has been thrown away.
*@

<div class="sem-budget @StateClass" title="@Session.Localizer.Counter(Key, Fallback, Value.Remaining)">
    <div class="track">
        <div class="fill" style="width:@(Percent)%"></div>
        <span class="reading">@Session.Localizer.Gauge(Label, LabelFallback, $"{Value.Spent}/{Value.Available}")</span>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The game's key for the full sentence, such as <c>POINTS_LEFT</c>, shown on hover.</summary>
    [Parameter, EditorRequired]
    public required string Key { get; set; }

    /// <summary>What that sentence says if a patch ever drops the key.</summary>
    [Parameter, EditorRequired]
    public required string Fallback { get; set; }

    /// <summary>The game's key for the short words on the bar, such as <c>TRAIT_POINTS</c>.</summary>
    [Parameter, EditorRequired]
    public required string Label { get; set; }

    /// <summary>What those words say if a patch ever drops the key.</summary>
    [Parameter, EditorRequired]
    public required string LabelFallback { get; set; }

    /// <summary>The spend and the allowance.</summary>
    [Parameter, EditorRequired]
    public Budget Value { get; set; }

    private int Percent => Value.Available <= 0
        ? (Value.Spent > 0 ? 100 : 0)
        : Math.Clamp(Value.Spent * 100 / Value.Available, 0, 100);

    private string? StateClass => Value.IsOverspent
        ? "over"
        : Value.Remaining == 0 ? "full" : null;
}
