@using Sem.Designs

@*
    The ascension perks, arranged the way the species traits are: what may be taken on the left, what
    the plan names on the right, and whatever the pointer is over described below.

    The same arrangement because it is the same job, and because a player who has used one of these
    already knows how this one works. It wears the trait picker's own classes rather than a second
    set that would have to be kept looking like the first.

    What is blocked here is genuinely blocked. Almost every rule keeping two perks apart is written
    "not if that other one is taken", which nothing could answer while an empire was only a design -
    the plan is what answers it, so the game's own exclusions apply in full.
*@

<div class="sem-budgets">
    <BudgetBar Key="ASCENSION_PERKS" Fallback="Ascension Perks"
               Label="ASCENSION_PERKS" LabelFallback="Perks"
               Value="@Session.Rules.GetAscensionPerkBudget(Plan.Perks.Count)" />
</div>

<div class="sem-trait-lists">
    <div class="sem-trait-list" role="group" aria-label="Ascension perks on offer">
        @foreach (var perk in Available)
        {
            @Row(perk, chosen: false)
        }
    </div>

    <div class="chosen-column">
        <div class="sem-trait-list chosen" role="group" aria-label="Ascension perks planned">
            @if (Plan.Perks.Count == 0)
            {
                <p class="sem-hint padded">Nothing planned yet.</p>
            }

            @foreach (var perk in Chosen)
            {
                @Row(perk, chosen: true)
            }
        </div>

        <div class="sem-trait-detail">
            @if (Described is { } described)
            {
                <h4>@described.Name</h4>

                @if (described.Lore is { Length: > 0 } lore)
                {
                    <div class="sem-detail-lore">@((MarkupString)lore)</div>
                }

                <EffectsList Effects="@described.Effects" ShowNothing="true" />

                @if (described.Reasons.Count > 0)
                {
                    <ul class="sem-blocked">
                        @foreach (var reason in described.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>The plan as it stands, which is what decides both lists.</summary>
    [Parameter, EditorRequired]
    public required EmpirePlan Plan { get; set; }

    /// <summary>Raised with the plan as it should now be.</summary>
    [Parameter]
    public EventCallback<EmpirePlan> OnChanged { get; set; }

    /// <summary>
    /// What the detail box is describing, kept after the pointer leaves rather than cleared.
    /// </summary>
    /// <remarks>
    /// A box that empties between rows flickers as the pointer crosses the list, which the trait
    /// picker found out first.
    /// </remarks>
    private string? _described;

    private DesignContext Context => Session.Context!;

    private IReadOnlyList<OptionState> Options =>
        Session.Rules.GetAscensionPerkOptions(Context, Plan.Perks);

    private IReadOnlyDictionary<string, AscensionPerkDefinition> ByKey =>
        _byKey ??= Session.Data.Database.AscensionPerks.ToDictionary(p => p.Key, StringComparer.Ordinal);

    private IReadOnlyDictionary<string, AscensionPerkDefinition>? _byKey;

    /// <summary>
    /// What may be taken, with whatever cannot sunk to the bottom.
    /// </summary>
    /// <remarks>
    /// Only what cannot be taken for a standing reason sinks. A perk blocked merely because the plan
    /// is full keeps its place, since burying the ones a reader is choosing between is exactly
    /// backwards while they are deciding what to give up.
    /// </remarks>
    private IReadOnlyList<PerkEntry> Available =>
    [
        .. Options
            .Where(o => o.Visible && !Plan.Perks.Contains(o.Key))
            .Select(Entry)
            .OrderBy(p => p.Unavailable)
            .ThenBy(p => p.Name, StringComparer.CurrentCulture)
    ];

    /// <summary>
    /// What the plan names, in the order it was chosen, so one does not move when another is added.
    /// </summary>
    private IReadOnlyList<PerkEntry> Chosen =>
    [
        .. Plan.Perks
            .Select(key => Options.FirstOrDefault(o => o.Key == key) is { } state
                ? Entry(state)
                : Entry(OptionState.Available(key, 0)))
    ];

    private PerkEntry? Described =>
        _described is { } key ? Available.Concat(Chosen).FirstOrDefault(p => p.Key == key) : null;

    private PerkEntry Entry(OptionState state)
    {
        var definition = ByKey.GetValueOrDefault(state.Key);

        var reasons = Session.Reasons
            .Describe([.. state.Reasons.Where(r => !RuleReasons.IsBudget(r))])
            .ToList();

        if (state.RequiredDlc is { Length: > 0 } dlc)
        {
            reasons.Add($"Requires {dlc}.");
        }

        // Being full is not the same objection as being wrong: one is undone by letting a perk go,
        // the other is not, so a perk blocked only by the budget is not sunk to the bottom.
        var full = !state.Enabled && state.Reasons.Count > 0 && state.Reasons.All(RuleReasons.IsBudget);

        return new PerkEntry(
            state.Key,
            Session.Localizer.Text(definition?.NameKey ?? state.Key),
            Session.Localizer.Html(definition?.DescriptionKey, string.Empty),
            definition?.Icon,
            definition?.Effects,
            state.Enabled,
            reasons,
            Unavailable: !state.Enabled && !full);
    }

    /// <summary>
    /// Takes a perk or lets one go, and works the path out again from what is left.
    /// </summary>
    /// <remarks>
    /// A blocked perk does nothing rather than being taken and complained about, which is how the
    /// option grid treats one and is the difference between a rule and a warning.
    /// </remarks>
    private async Task Toggle(PerkEntry perk, bool chosen)
    {
        if (!chosen && !perk.Enabled)
        {
            return;
        }

        var perks = chosen
            ? Plan.Perks.Where(p => p != perk.Key).ToList()
            : [.. Plan.Perks, perk.Key];

        await OnChanged.InvokeAsync(Plan with
        {
            Perks = perks,
            Path = PlanPaths.From(perks),
        });
    }

    private RenderFragment Row(PerkEntry perk, bool chosen) =>
        @<button type="button"
                 class="sem-trait-row @(perk.Enabled || chosen ? null : "blocked")"
                 aria-pressed="@(chosen ? "true" : "false")"
                 title="@perk.Name"
                 @onmouseenter="() => _described = perk.Key"
                 @onfocus="() => _described = perk.Key"
                 @onclick="() => Toggle(perk, chosen)">

            @if (perk.Icon is { Length: > 0 } icon)
            {
                <img src="@Session.Data.AssetUrl(icon)" alt="" loading="lazy">
            }
            else
            {
                <span class="no-icon" aria-hidden="true"></span>
            }

            <span class="name">@perk.Name</span>
        </button>;

    private sealed record PerkEntry(
        string Key,
        string Name,
        string? Lore,
        string? Icon,
        EffectSet? Effects,
        bool Enabled,
        IReadOnlyList<string> Reasons,
        bool Unavailable = false);
}
