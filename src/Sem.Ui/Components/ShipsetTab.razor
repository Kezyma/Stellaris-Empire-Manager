@*
    What the empire's fleet looks like.

    Shown as ships rather than as a list of names, because that is the choice being made. The game
    has no artwork for this and spins the models instead; each of these is one of the set's own
    corvettes, drawn during extraction.

    What the ships are called is not here. The prefix is a name the empire carries whatever its
    fleet is modelled on, so it sits with the empire's other names.
*@

@*
    What the design holds, where this empire is not offered it: a turned-off content pack, or a set
    the rules exclude. Without this the grid marked nothing and a design that plainly has a shipset
    looked as though it had none. The room picker has always done this; the ships and the portraits
    did not.
*@
@if (HeldButNotOffered is { } held)
{
    <h5 class="sem-subhead apart">Not offered for this empire</h5>

    <div class="sem-thumbs">
        <button type="button" class="sem-thumb-option selected" aria-pressed="true" disabled>
            @if (held.ShipPreview is { Length: > 0 } ship)
            {
                <img class="sem-thumb" src="@Session.Data.AssetUrl(ship)" alt="@ShipSetName(held)" loading="lazy" />
            }
            <span class="caption">@ShipSetName(held)</span>
        </button>
    </div>
}

@foreach (var group in ShipSetGroups)
{
    @*
        Grouped as the game groups them — a fleet is built or it is grown, and common/ship_sets
        exists to sort the browser by exactly that.
    *@
    <h5 class="sem-subhead">@Session.Localizer.Text(group.Key.NameKey)</h5>

    <div class="sem-thumbs">
        @foreach (var culture in group.Value)
        {
            <button type="button"
                    class="sem-thumb-option @(culture.Key == Design.GraphicalCulture ? "selected" : null)"
                    aria-pressed="@(culture.Key == Design.GraphicalCulture ? "true" : "false")"
                    title="@Session.Localizer.Text(culture.DescriptionKey, string.Empty)"
                    @onclick="() => Session.Edit(d => d.GraphicalCulture = culture.Key)">
                @if (culture.ShipPreview is { Length: > 0 } ship)
                {
                    <img class="sem-thumb" src="@Session.Data.AssetUrl(ship)"
                         alt="@ShipSetName(culture)" loading="lazy" />
                }
                <span class="caption">@ShipSetName(culture)</span>
            </button>
        }
    </div>
}

@*
    And what colour the fleet is, which is a property of the ships and belongs with them.

    Ordinarily it is the flag's primary colour - the game calls that "the fallback ship entity tint"
    in the header of flags/colors.txt - and an empire that wants something else turns this on and
    picks. The game keeps this on its own screen too, with its own checkbox, rather than among the
    flag colours.

    The swatches are drawn in each colour's ship shade, which is a third value against the same name
    and much the brightest of the three: red is 158,22,22 on a flag, 151,14,18 on the map and
    255,57,36 on a hull. Ships are lit, so a flag-dark red would disappear against space.
*@
<h5 class="sem-subhead apart">Ship colour</h5>

<div class="sem-field spaced">
    <span class="sem-dot" style="--dot:@(View.ShipSwatch ?? "transparent")"></span>

    <span class="sem-hint">@View.ShipColorTold</span>

    <button type="button" class="sem-toggle" aria-pressed="@(Tinted ? "true" : "false")"
            title="When on, this empire's ships use the colour chosen here. When off, they use the primary flag colour."
            @onclick="() => Session.Edit(d => d.Flag.UseShipColor = !d.Flag.UseShipColor)">
        @(Tinted ? "Chosen" : "From the flag")
    </button>
</div>

@if (Tinted)
{
    <div class="sem-swatches">
        @*
            No "automatic" tile here. Handing the slot back is what the toggle above does, and a
            second way to do it that leaves the toggle on would be a state with nothing in it.
        *@
        @foreach (var color in Session.Data.Database.FlagColors)
        {
            <button type="button"
                    class="sem-swatch @(color.Key == Design.Flag.ShipColor ? "selected" : null)"
                    style="background:rgb(@color.ShipRed,@color.ShipGreen,@color.ShipBlue)"
                    title="@Localizer.Prettify(color.Key)"
                    aria-label="@Localizer.Prettify(color.Key)"
                    aria-pressed="@(color.Key == Design.Flag.ShipColor ? "true" : "false")"
                    @onclick="() => Session.Edit(d => d.Flag.ShipColor = color.Key)"></button>
        }
    </div>
}

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private EmpireView View => new(Session, Design);

    /// <summary>Whether the fleet wears a colour of its own rather than the flag's primary.</summary>
    private bool Tinted => Design.Flag.UseShipColor;

    private readonly RequirementEvaluator _evaluator = new();

    /// <summary>
    /// What the game calls a shipset.
    /// </summary>
    /// <remarks>
    /// It names them by their key shouted — <c>BIOGENESIS_01</c> is "Spinovore" — and only names
    /// two, the pair Biogenesis added. Every other set has no entry under any spelling, so the
    /// readable key stands in. That is a gap in the game's own text rather than one here.
    /// </remarks>
    private string ShipSetName(GraphicalCultureDefinition culture) =>
        Session.Localizer.Text(culture.NameKey, Localizer.Prettify(culture.Key));

    /// <summary>
    /// The set the design names when the groups below will not be showing it.
    /// </summary>
    private GraphicalCultureDefinition? HeldButNotOffered
    {
        get
        {
            if (Design.GraphicalCulture is not { Length: > 0 } key)
            {
                return null;
            }

            return ShipSetGroups.SelectMany(g => g.Value).Any(c => c.Key == key)
                ? null
                : Session.Data.Database.GraphicalCultures.FirstOrDefault(c => c.Key == key);
        }
    }

    /// <summary>
    /// The shipsets, in the game's own two groups.
    /// </summary>
    /// <remarks>
    /// A set that models no ships of its own is not a shipset. Solarpunk and Wilderness are the two:
    /// they dress cities, and the game flies them in whatever their fallback builds — which is why
    /// Wilderness showed a Biogenesis corvette, being a Biogenesis corvette. Both keep their place
    /// in the city list under Room, which is what they are actually for.
    /// </remarks>
    private IEnumerable<KeyValuePair<ShipSetDefinition, IReadOnlyList<GraphicalCultureDefinition>>> ShipSetGroups
    {
        get
        {
            var sets = Session.Data.Database.GraphicalCultures
                .Where(c => Session.Rules.Database.GraphicalCultures.Contains(c))
                .Where(c => _evaluator.IsSatisfied(c.Selectable, Session.Context!))
                .Where(c => c.ShipCategory is not null)
                .OrderBy(c => c.Key, StringComparer.Ordinal)
                .ToList();

            foreach (var group in Session.Data.Database.ShipSets)
            {
                var members = sets.Where(c => group.Includes(c.ShipCategory)).ToList();

                if (members.Count > 0)
                {
                    yield return new(group, members);
                }
            }
        }
    }
}
