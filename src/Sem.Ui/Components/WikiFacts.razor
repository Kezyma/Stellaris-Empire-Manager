@*
    The things true of one kind of entry and not of the others: an ethic's cost, an authority's
    elections, the traits a hive mind forces on its founders.

    Chips where the fact names things, because an ethic's opposite is a thing with a name and a
    picture and should look the same here as it does in a picker. A word where it says a word.
*@

@foreach (var fact in Facts)
{
    @*
        A fact whose chips come in runs takes the whole width instead of the answer column. The
        heading column is as wide as the longest heading on the card - "Terraforming needs" - and
        what is left in a card four across is narrower than one world chip, which is how fourteen
        chips became fourteen lines.
    *@
    <div class="one @(fact.Groups.Count > 0 ? "grouped" : null)">
        <div class="heading">@fact.Heading</div>

        <div class="said">
            @if (fact.Text is { Length: > 0 } text)
            {
                <span class="words">@text</span>
            }

            @*
                Labels rather than chips, for what has nothing behind it. A chip looks pressable and
                opens a description; these say the whole of what they mean on their face.
            *@
            @foreach (var tag in fact.Tags)
            {
                <span class="sem-tag">@tag</span>
            }

            @*
                In runs, where the fact came in runs - see WikiFact.Grouped. The word they share is
                said once above them instead of on each chip, which is most of a card's width back.
            *@
            @if (fact.Groups.Count > 0)
            {
                @foreach (var group in fact.Groups)
                {
                    <div class="run">
                        <div class="label">@group.Label</div>

                        <div class="chips">
                            @foreach (var chip in group.Chips)
                            {
                                <OptionChip Key="@chip.Key" Name="@chip.Name" Icon="@chip.Icon"
                                            DescriptionKey="@chip.Description" Effects="@chip.Effects"
                                            Badge="@chip.Badge" BadgeLevel="@chip.BadgeLevel"
                                            Deferred="true" />
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var chip in fact.Chips)
                {
                    @*
                        The badge travels too. A personality's numbers are chips wearing their own
                        figure - aggressiveness 1.75, bravery 1.5 - and without this they were a row
                        of words with the numbers dropped on the floor.
                    *@
                    <OptionChip Key="@chip.Key" Name="@chip.Name" Icon="@chip.Icon"
                                DescriptionKey="@chip.Description" Effects="@chip.Effects"
                                Badge="@chip.Badge" BadgeLevel="@chip.BadgeLevel"
                                Deferred="true" />
                }
            }

            @*
                And sentences the game has already written, which are a list of the same kind as a
                list of modifiers rather than a row of pills. Inside the answer rather than beside
                it, because the row above is a two-column grid its children fall straight into.
            *@
            @if (fact.Lines.Count > 0)
            {
                <ul class="sem-fact-lines">
                    @foreach (var line in fact.Lines)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>What to say. Empty facts are left out before they reach here.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<WikiFact> Facts { get; set; }
}
