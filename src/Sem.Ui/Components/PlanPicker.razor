@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    One part of a plan, arranged the way the species traits are: what may be taken on the left, what
    the plan names on the right, whatever the pointer is over described below.

    The same arrangement because it is the same job, and because a player who has used the trait
    picker already knows how this one works. It wears that picker's own classes rather than a second
    set that would have to be kept looking like the first.

    It knows nothing about what it is showing. The perks, the tradition trees and the civics differ
    in where they are read from and in nothing a reader can see, so they share this and differ only
    in the two dozen lines that fill it.

    Where order means something the chosen column is a numbered list with a grip on every row. Where
    it does not - the civics, which an empire simply holds - the same column is drawn without either,
    because numbering things that have no order tells the reader something untrue.
*@

<div class="sem-budgets">
    <BudgetBar Key="@BudgetKey" Fallback="@Heading" Label="@BudgetKey" LabelFallback="@Heading"
               Value="@Budget" />
</div>

<div class="sem-trait-lists">
    <div class="sem-trait-list" role="group" aria-label="@($"{Heading} on offer")">
        @if (Available.Count == 0)
        {
            <p class="sem-hint padded">Nothing else this empire can take.</p>
        }

        @foreach (var option in Available)
        {
            @Row(option, chosen: false)
        }
    </div>

    <div class="chosen-column">
        <div class="sem-trait-list chosen">
            @*
                What the empire is stuck with, above what it is choosing. These spend slots and
                cannot be given up, so they are shown rather than hidden - a player deciding what to
                reform into needs to see what is not up for discussion - but they are not part of
                the list below and take no grip, because there is nothing to do to them.

                Unlabelled. A greyed row that will not press says it is not a choice, and the row's
                own description carries the game's sentence for why, which is the answer to the
                question a label would only have raised.
            *@
            @foreach (var option in Fixed)
            {
                @Row(option, chosen: true, locked: true)
            }

            @if (Chosen.Count == 0 && Fixed.Count == 0)
            {
                <p class="sem-hint padded">Nothing planned yet.</p>
            }

            <ol class="sem-plan-order @(Ordered ? "numbered" : null)" @ref="_list"
                role="group" aria-label="@($"{Heading} planned")">
                @foreach (var (option, at) in Chosen.Select((o, i) => (o, i)))
                {
                    <li class="sem-plan-slot" data-index="@at">
                        @if (Ordered)
                        {
                            <button type="button" class="sem-plan-grip" data-grip
                                    title="@($"Drag to move {option.Name}, or use the arrow keys")"
                                    aria-label="@($"Move {option.Name}, currently {at + 1} of {Chosen.Count}. Drag, or press the up and down arrow keys.")"
                                    @onkeydown="key => Nudge(key, at)">⠿</button>
                        }

                        @Row(option, chosen: true)
                    </li>
                }
            </ol>
        </div>

        <div class="sem-trait-detail">
            @if (Described is { } described)
            {
                <h4>@described.Name</h4>

                @if (described.Lore is { Length: > 0 } lore)
                {
                    <div class="sem-detail-lore">@((MarkupString)lore)</div>
                }

                <EffectsList Effects="@described.Effects" ShowNothing="@(described.Contents is not { Count: > 0 })" />

                @*
                    What is inside a tree, which is the whole reason to open one. The game's own
                    description of a tree says what it is about and not what it gives, so a reader
                    choosing between them needs the traditions themselves - each with the words the
                    game wrote for it, and whatever it does stated underneath.
                *@
                @if (described.Contents is { Count: > 0 } contents)
                {
                    <ol class="sem-plan-contents">
                        @foreach (var inside in contents)
                        {
                            <li>
                                <div class="head">
                                    @if (inside.Icon is { Length: > 0 } within)
                                    {
                                        <img src="@Session.Data.AssetUrl(within)" alt="" loading="lazy">
                                    }

                                    <span class="name">@inside.Name</span>
                                </div>

                                @if (inside.Lore is { Length: > 0 } said)
                                {
                                    <div class="sem-detail-lore">@((MarkupString)said)</div>
                                }

                                <EffectsList Effects="@inside.Effects" />
                            </li>
                        }
                    </ol>
                }

                @if (described.Reasons.Count > 0)
                {
                    <ul class="sem-blocked">
                        @foreach (var reason in described.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>What this part of the plan is called, for the bar and for a screen reader.</summary>
    [Parameter, EditorRequired]
    public required string Heading { get; set; }

    /// <summary>The game's key for that word, so it reads in the player's language.</summary>
    [Parameter, EditorRequired]
    public required string BudgetKey { get; set; }

    /// <summary>How much of the allowance the plan has spent.</summary>
    [Parameter]
    public Budget Budget { get; set; }

    /// <summary>What may still be taken.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<PlanOption> Available { get; set; }

    /// <summary>What the plan names, in the order it means to take them.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<PlanOption> Chosen { get; set; }

    /// <summary>
    /// What is already the empire's and cannot be given up, which the plan does not name but has to
    /// count. Empty for the two halves where nothing is ever fixed.
    /// </summary>
    [Parameter]
    public IReadOnlyList<PlanOption> Fixed { get; set; } = [];

    /// <summary>Raised with the key pressed and whether it was one of the chosen ones.</summary>
    [Parameter]
    public EventCallback<(string Key, bool Chosen)> OnToggle { get; set; }

    /// <summary>
    /// Raised to move a chosen entry from one place to another, where order means anything.
    /// </summary>
    /// <remarks>
    /// Leaving it unset is what says this part of a plan is a set rather than a sequence: no grips
    /// are drawn and no numbers, because a civic is not taken third.
    /// </remarks>
    [Parameter]
    public EventCallback<(int From, int To)> OnReorder { get; set; }

    private bool Ordered => OnReorder.HasDelegate;

    private ElementReference _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PlanPicker>? _self;

    /// <summary>
    /// What the detail box is describing, kept after the pointer leaves rather than cleared.
    /// </summary>
    /// <remarks>
    /// A box that empties between rows flickers as the pointer crosses the list, which the trait
    /// picker found out first.
    /// </remarks>
    private string? _described;

    private PlanOption? Described =>
        _described is { } key
            ? Available.Concat(Chosen).Concat(Fixed).FirstOrDefault(o => o.Key == key)
            : null;

    /// <summary>
    /// Hands the chosen list to the script that drags its rows about.
    /// </summary>
    /// <remarks>
    /// On every render rather than the first, because the list is not there on the first one when
    /// nothing has been planned yet - and the script refuses a second time by its own mark, so
    /// asking again costs a call and no more. The same lesson the empire list learned.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Ordered)
        {
            return;
        }

        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Sem.Ui/sem.js").ConfigureAwait(true);

            _self ??= DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("enableCardReorder", _list, _self).ConfigureAwait(true);
        }
        catch (JSDisconnectedException)
        {
            // The page went away first; there is nothing left to drag.
        }
    }

    /// <summary>Called from the script when a row has been dragged from one place to another.</summary>
    /// <remarks>
    /// Checked rather than trusted: what arrives is whatever the page said.
    /// </remarks>
    [JSInvokable]
    public Task Reorder(int from, int to) =>
        from >= 0 && from < Chosen.Count && to >= 0 && to < Chosen.Count && from != to
            ? OnReorder.InvokeAsync((from, to))
            : Task.CompletedTask;

    /// <summary>Moves a row one place with the arrow keys, for anyone not using a pointer.</summary>
    private Task Nudge(KeyboardEventArgs key, int at) => key.Key switch
    {
        "ArrowUp" or "ArrowLeft" => Reorder(at, at - 1),
        "ArrowDown" or "ArrowRight" => Reorder(at, at + 1),
        _ => Task.CompletedTask,
    };

    /// <summary>
    /// Presses a row, unless it is one that cannot be taken.
    /// </summary>
    /// <remarks>
    /// A blocked row does nothing rather than being taken and then complained about, which is how
    /// the option grid treats one and is the difference between a rule and a warning. Letting one go
    /// is always allowed - it is what unblocks the rest - unless it is one the empire cannot give
    /// up, which is not a choice at all.
    /// </remarks>
    private async Task Press(PlanOption option, bool chosen)
    {
        if (option.Locked || (!chosen && !option.Enabled))
        {
            return;
        }

        await OnToggle.InvokeAsync((option.Key, chosen));
    }

    private RenderFragment Row(PlanOption option, bool chosen, bool locked = false) =>
        @*
            aria-disabled rather than disabled, for the locked ones. A disabled button is out of the
            tab order and fires nothing, so a reader using the keyboard could neither reach a civic
            the empire cannot give up nor hear the sentence saying why - which is the only useful
            thing about it. Pressing it still does nothing: Press turns a locked row away.
        *@
        @<button type="button"
                 class="sem-trait-row @(option.Enabled || chosen ? null : "blocked") @(locked ? "locked" : null)"
                 aria-pressed="@(chosen ? "true" : "false")"
                 aria-disabled="@(locked ? "true" : null)"
                 title="@option.Name"
                 @onmouseenter="() => _described = option.Key"
                 @onfocus="() => _described = option.Key"
                 @onclick="() => Press(option, chosen)">

            @if (option.Icon is { Length: > 0 } icon)
            {
                <img src="@Session.Data.AssetUrl(icon)" alt="" loading="lazy">
            }
            else
            {
                <span class="no-icon" aria-hidden="true"></span>
            }

            <span class="name">@option.Name</span>
        </button>;

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
                // The page is already gone, which is the only thing disposing this was for.
            }
        }
    }
}
