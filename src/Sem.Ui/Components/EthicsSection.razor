@*
    Three points buy an empire's ethos: one fanatic conviction and one ordinary one, or three
    ordinary ones, or gestalt consciousness on its own.

    Ordered as the game orders them, so a conviction sits beside the one it argues with rather than
    wherever the files happened to put it.
*@

<BudgetBar Label="Ethics points" Value="@Session.Rules.GetEthicsBudget(Context)" />

<OptionGrid Options="@Options"
            EmptyHint="Hover a conviction to see what it believes and what it grants."
            OnSelect="Toggle" />

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private DesignContext Context => Session.Context!;

    private IReadOnlyList<OptionGrid.GridOption> Options
    {
        get
        {
            var byKey = Session.Data.Database.Ethics.ToDictionary(e => e.Key, StringComparer.Ordinal);

            return
            [
                .. Session.Rules.GetEthicOptions(Context)
                    .Where(o => o.Visible)
                    .OrderBy(o => byKey.GetValueOrDefault(o.Key)?.Category, StringComparer.Ordinal)
                    .ThenBy(o => byKey.GetValueOrDefault(o.Key)?.CategoryValue ?? 0)
                    .ThenByDescending(o => o.Cost)
                    .Select(o => new OptionGrid.GridOption(o.Key, Session.Localizer.Text(o.Key))
                    {
                        Description = Session.Localizer.Html($"{o.Key}_desc", string.Empty),
                        Effects = byKey.GetValueOrDefault(o.Key)?.Effects,
                        Icon = byKey.GetValueOrDefault(o.Key)?.Icon,
                        Cost = o.Cost,
                        Selected = Design.Ethics.Contains(o.Key),
                        Enabled = o.Enabled,
                        Reasons = Session.Reasons.Describe(o.Reasons),
                    })
            ];
        }
    }

    private void Toggle(string key)
    {
        Session.Edit(d =>
        {
            var ethics = d.Ethics.ToList();

            if (ethics.Remove(key))
            {
                d.SetEthics(ethics);
                return;
            }

            // Gestalt consciousness stands alone, and taking it means clearing the rest.
            var definition = Session.Data.Database.Ethics.FirstOrDefault(e => e.Key == key);
            if (definition?.IsGestalt == true)
            {
                d.SetEthics([key]);
                return;
            }

            ethics.RemoveAll(e =>
                Session.Data.Database.Ethics.FirstOrDefault(x => x.Key == e)?.IsGestalt == true);

            ethics.Add(key);
            d.SetEthics(ethics);
        });
    }
}
