@*
    Three points buy an empire's ethos: one fanatic conviction and one ordinary one, or three
    ordinary ones, or gestalt consciousness on its own.

    Laid out as an argument. Each column is one of the game's four oppositions, running from the
    fanatic form of one side, through its ordinary form, to the ordinary and then fanatic forms of
    the other — so a conviction and the thing it contradicts are in the same column, and picking one
    visibly rules out the three beneath it. Gestalt belongs to no argument and stands apart.
*@

<BudgetBar Key="POINTS_LEFT_ETHICS" Fallback="Ethic Points Left: $POINTS|H$"
           Label="ETHICS" LabelFallback="Ethics" Value="@Session.Rules.GetEthicsBudget(Context)" />

<div class="sem-grid-and-detail">
    <div class="sem-ethics-grid">
        @foreach (var column in Columns)
        {
            <div class="column">
                @foreach (var ethic in column)
                {
                    @*
                        Marked unavailable rather than disabled, which is what the option grid does
                        and for the reason it gives: a disabled button is sent no mouse events, so it
                        can be neither hovered nor focused - and a blocked conviction is exactly the
                        one with something to explain. The panel beside this held those reasons all
                        along with no way to reach them. The press is refused in Toggle instead.

                        At-limit is drawn apart from blocked for the same reason the grids do it:
                        once three points are spent everything else is merely unaffordable, and at
                        the blocked treatment the whole argument went dim at the moment the player
                        was deciding what to give up.
                    *@
                    <button type="button"
                            class="sem-icon-option @(ethic.Selected ? "selected" : null) @(Blocked(ethic) ? (ethic.AtLimit ? "at-limit" : "blocked") : null) @(_press.IsReading(ethic.Key) ? "reading" : null)"
                            aria-pressed="@(ethic.Selected ? "true" : "false")"
                            aria-disabled="@(Blocked(ethic) ? "true" : null)"
                            title="@ethic.Name"
                            @onmouseenter="() => _hovered = ethic.Key"
                            @onfocus="() => _hovered = ethic.Key"
                            @onpointerdown="_press.Noted"
                            @ontouchstart="_press.NotedTouch"
                            @onclick="() => Choose(ethic)">

                        @if (ethic.Icon is { Length: > 0 } icon)
                        {
                            <img src="@Session.Data.AssetUrl(icon)" alt="@ethic.Name" loading="lazy">
                        }

                        <span class="cost">@ethic.Cost</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="sem-detail">
        <div class="body">
            @if (Described is { } shown)
            {
                <h4>@shown.Name</h4>

                @if (shown.Description is { Length: > 0 } description)
                {
                    <div class="sem-detail-lore">@((MarkupString)description)</div>
                }

                <EffectsList Effects="@shown.Effects" />

                @if (!shown.Enabled && shown.Reasons.Count > 0)
                {
                    <ul class="sem-blocked">
                        @foreach (var reason in shown.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Which conviction the pointer is over.
    /// </summary>
    /// <remarks>
    /// Kept after the pointer leaves rather than cleared, as the trait list does it: a panel that
    /// empties between one icon and the next flickers as the pointer crosses the grid.
    /// </remarks>
    private string? _hovered;

    /// <summary>Whether a press is a finger reading or a hand choosing.</summary>
    private readonly PressReading _press = new();

    private IReadOnlyList<OptionGrid.GridOption> _options = [];

    /// <summary>Which revision <see cref="_options"/> was worked out at; -1 is "never".</summary>
    private int _stamp = -1;

    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private DesignContext Context => Session.Context!;

    /// <summary>
    /// The convictions grouped into the arguments they belong to.
    /// </summary>
    /// <remarks>
    /// The game already describes this: opposing ethics share a category, and their place within it
    /// runs from the fanatic form of one side to the fanatic form of the other. Gestalt has a
    /// category to itself with one member, which falls out of the same grouping without a special
    /// case. Ordered by category so the columns do not move as the design changes.
    /// </remarks>
    private IEnumerable<IEnumerable<OptionGrid.GridOption>> Columns =>
        Options
            .GroupBy(o => Definition(o.Key)?.Category ?? string.Empty, StringComparer.Ordinal)
            .OrderBy(g => g.Any(o => Definition(o.Key)?.IsGestalt == true))
            .ThenBy(g => g.Key, StringComparer.Ordinal)
            .Select(g => g.OrderBy(o => Definition(o.Key)?.CategoryValue ?? 0));

    private EthicDefinition? Definition(string key) =>
        Session.Data.Database.Ethic(key);

    /// <summary>
    /// What the panel describes: whatever is under the pointer, failing that whatever is held,
    /// failing that the first there is.
    /// </summary>
    /// <remarks>
    /// That third fallback is what keeps the panel from opening empty. A fresh empire has no ethics,
    /// so the first two both came back with nothing and Government opened on a bordered box with
    /// nothing in it - a poor answer to "what is an ethic".
    /// </remarks>
    private OptionGrid.GridOption? Described =>
        Options.FirstOrDefault(o => o.Key == _hovered)
        ?? Options.FirstOrDefault(o => o.Selected)
        ?? Options.FirstOrDefault();

    /// <summary>Whether this conviction cannot be taken as things stand. A held one never is.</summary>
    private static bool Blocked(OptionGrid.GridOption ethic) => !ethic.Enabled && !ethic.Selected;

    /// <summary>Refuses the press rather than the button, so a blocked ethic can still be asked about.</summary>
    private void Choose(OptionGrid.GridOption ethic)
    {
        // A finger has no hover, so a tap is also how the panel is asked about something - and under
        // a finger the first press is only that, leaving the choice to the second.
        var reading = _press.ReadsOnly(ethic.Key);

        _hovered = ethic.Key;

        if (!reading && !Blocked(ethic))
        {
            Toggle(ethic.Key);
        }
    }

    /// <summary>
    /// The convictions on offer, worked out once per change rather than once per read.
    /// </summary>
    /// <remarks>
    /// This is a whole ethics rules pass, and it used to run two to four times per render - the grid
    /// reads it, and the detail panel reads it again for each of its three fallbacks. Worse, every
    /// button reports its own hover, so crossing the grid with the pointer re-rendered the section
    /// and paid for all of them again, on a design that had not changed.
    /// </remarks>
    private IReadOnlyList<OptionGrid.GridOption> Options
    {
        get
        {
            if (_stamp == Session.Revision)
            {
                return _options;
            }

            _stamp = Session.Revision;
            _options = Offered();

            return _options;
        }
    }

    private IReadOnlyList<OptionGrid.GridOption> Offered()
    {
        var database = Session.Data.Database;

        return
            [
                .. Session.Rules.GetEthicOptions(Context)
                    .Where(o => o.Visible)
                    .Select(o => new OptionGrid.GridOption(o.Key, Session.Localizer.Text(o.Key))
                    {
                        Description = Session.Localizer.Html($"{o.Key}_desc", string.Empty),
                        Effects = database.Ethic(o.Key)?.Effects,
                        Icon = database.Ethic(o.Key)?.Icon,
                        Cost = o.Cost,
                        Selected = Design.Ethics.Contains(o.Key),
                        Enabled = o.Enabled,

                        // Read from the reasons while they are still keys, the same line the grids
                        // and the trait picker use to tell "no room left" from "not for this empire".
                        AtLimit = !o.Enabled && o.Reasons.Count > 0 && o.Reasons.All(RuleReasons.IsBudget),

                        Reasons = Session.Reasons.Describe(o.Reasons),
                    })
            ];
    }

    private void Toggle(string key)
    {
        Session.Edit(d =>
        {
            var ethics = d.Ethics.ToList();

            if (ethics.Remove(key))
            {
                d.SetEthics(ethics);
                return;
            }

            // Gestalt consciousness stands alone, and taking it means clearing the rest.
            var definition = Session.Data.Database.Ethic(key);
            if (definition?.IsGestalt == true)
            {
                d.SetEthics([key]);
                return;
            }

            ethics.RemoveAll(e =>
                Session.Data.Database.Ethic(e)?.IsGestalt == true);

            // Moving between an ethic and its fanatic form replaces it rather than joining it, which
            // is how the game's own designer behaves. Added beside it, the empire would hold both
            // halves of one conviction and be rejected.
            if (Session.Rules.EthicReplacedBy(Context, key) is { } replaced)
            {
                ethics.Remove(replaced);
            }

            ethics.Add(key);
            d.SetEthics(ethics);
        });
    }
}
