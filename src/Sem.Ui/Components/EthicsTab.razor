@*
    Three points buy an empire's ethos: one fanatic conviction and one ordinary one, or three
    ordinary ones, or gestalt consciousness on its own.
*@

<div class="sem-panel">
    <h3>Ethics</h3>

    <BudgetBar Label="Ethics points" Value="@Session.Rules.GetEthicsBudget(Context)" />

    <p class="sem-hint">
        Opposing convictions share a group, so only one may be taken from each. Gestalt
        consciousness replaces an ethos entirely rather than joining one.
    </p>

    <div class="sem-options">
        @foreach (var option in Ordered)
        {
            <OptionCard Name="@Session.Localizer.Text(option.Key)"
                        Description="@Session.Localizer.Text($"{option.Key}_desc", string.Empty)"
                        Icon="@IconFor(option.Key)"
                        Cost="@option.Cost"
                        Selected="@Design.Ethics.Contains(option.Key)"
                        Enabled="@option.Enabled"
                        Reasons="@Session.Reasons.Describe(option.Reasons)"
                        OnSelect="() => Toggle(option.Key)" />
        }
    </div>
</div>

@code {
    [CascadingParameter]
    public required DesignSession Session { get; set; }

    private EmpireDesign Design => Session.Current!;

    private DesignContext Context => Session.Context!;

    /// <summary>
    /// Grouped by the pairs they oppose, so a conviction sits beside the one it argues with rather
    /// than wherever the files happened to put it.
    /// </summary>
    private IEnumerable<OptionState> Ordered
    {
        get
        {
            var byKey = Session.Data.Database.Ethics.ToDictionary(e => e.Key, StringComparer.Ordinal);

            return Session.Rules.GetEthicOptions(Context)
                .Where(o => o.Visible)
                .OrderBy(o => byKey.GetValueOrDefault(o.Key)?.Category, StringComparer.Ordinal)
                .ThenBy(o => byKey.GetValueOrDefault(o.Key)?.CategoryValue ?? 0)
                .ThenByDescending(o => o.Cost);
        }
    }

    private string? IconFor(string key) =>
        Session.Data.Database.Ethics.FirstOrDefault(e => e.Key == key)?.Icon;

    private void Toggle(string key)
    {
        Session.Edit(d =>
        {
            var ethics = d.Ethics.ToList();

            if (ethics.Remove(key))
            {
                d.SetEthics(ethics);
                return;
            }

            // Gestalt consciousness stands alone, and taking it means clearing the rest.
            var definition = Session.Data.Database.Ethics.FirstOrDefault(e => e.Key == key);
            if (definition?.IsGestalt == true)
            {
                d.SetEthics([key]);
                return;
            }

            ethics.RemoveAll(e =>
                Session.Data.Database.Ethics.FirstOrDefault(x => x.Key == e)?.IsGestalt == true);

            ethics.Add(key);
            d.SetEthics(ethics);
        });
    }
}
