@*
    The game's four gender buttons, wearing the game's own sprites.

    A row of icons rather than a dropdown, as the game has it: there are four, they never change, and
    each has a picture that says what it is faster than its name does. Used by the species editor and
    by the ruler, which is why it is a component rather than markup in one of them.
*@

<div class="sem-genders">
    @foreach (var (key, label, icon) in Genders)
    {
        <button type="button"
                class="sem-gender @(key == Current ? "selected" : null)"
                title="@label"
                aria-pressed="@(key == Current ? "true" : "false")"
                @onclick="() => OnChange.InvokeAsync(key)">

            @if (Session.Data.Database.Icons.GetValueOrDefault(icon) is { Length: > 0 } path)
            {
                <img src="@Session.Data.AssetUrl(path)" alt="@label">
            }
            else
            {
                <span>@label</span>
            }
        </button>
    }
</div>

@code {
    /// <summary>
    /// The genders a design may hold.
    /// </summary>
    /// <remarks>
    /// Four, in the game's own order: no preference, male, female, and a species that has no gender
    /// at all. The first is what a design holds when it says nothing.
    /// </remarks>
    private static readonly (string Key, string Label, string Icon)[] Genders =
    [
        ("not_set", "Both", "GFX_button_gender_all"),
        ("male", "Male", "GFX_button_male"),
        ("female", "Female", "GFX_button_female"),
        ("indeterminable", "None", "GFX_button_no_gender"),
    ];

    [CascadingParameter]
    public required DesignSession Session { get; set; }

    /// <summary>What the design holds, which is "not_set" when it holds nothing.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Called with the chosen gender's key.</summary>
    [Parameter]
    public EventCallback<string> OnChange { get; set; }

    private string Current => Value is { Length: > 0 } set ? set : "not_set";

    /// <summary>
    /// The sprite and the word for one gender, for somewhere that shows the held one rather than
    /// offering all four.
    /// </summary>
    /// <remarks>
    /// The card shows the answer and opens this picker to change it, so the four live here and are
    /// read from here - a second list of the game's four sprites would be a second thing to keep
    /// right.
    /// </remarks>
    /// <summary>
    /// All four, for somewhere that lists them rather than offering them as buttons.
    /// </summary>
    /// <remarks>
    /// A filter has to name every gender a design could hold, not only the ones some empire in the
    /// list happens to hold - a heading that offers three of four is a heading that quietly says
    /// the fourth does not exist.
    /// </remarks>
    public static IReadOnlyList<(string Key, string Label, string Icon)> Offered => Genders;

    public static (string Label, string Icon) Held(string? gender)
    {
        var key = gender is { Length: > 0 } set ? set : "not_set";

        return Genders.FirstOrDefault(g => g.Key == key, Genders[0]) is var (_, label, icon)
            ? (label, icon)
            : (Genders[0].Label, Genders[0].Icon);
    }
}
