@page "/designer"
@inject SessionHost Host
@inject NavigationManager Navigation
@inject EditorState Editor

<PageTitle>@Title - Stellaris Empire Manager</PageTitle>

@*
    The advanced editor: the empire in sections, on a page of its own.

    Everything that makes editing work - the buttons, the questions, the guard, the address - is
    EmpireEditor's and is the same here as it is in the dialog on the list. This is the route, the
    loading states, and the way back.

    It has no route of its own for a shared link any more. A link opens the list, which is where the
    editor lives now, and this page is reached from that editor by the button across.
*@
@*
    As on the list: above the branches, because the router looks for it while the session is still
    on its way. Title reads without one, which is why the page title above can already use it.
*@
<h1 class="sem-visually-hidden">@Title</h1>

@if (_session is null && Host.LoadError is { } loadError)
{
    <div class="sem-empty">
        <h2>The game data is not available</h2>
        <p class="sem-hint">@loadError</p>
        <button type="button" class="primary" @onclick="@(() => Navigation.NavigateTo("", forceLoad: true))">
            Try again
        </button>
    </div>
}
else if (_session is null)
{
    <div class="sem-loading"><p>Loading…</p></div>
}
else
{
    <EmpireEditor Session="_session" StaysHere="SameEmpire" OnBack="Back" OnDeleted="Finished">
        <Body Context="actions">
            <DesignerShell Session="_session" Actions="@actions" />
        </Body>
    </EmpireEditor>
}

@code {
    private DesignSession? _session;

    private string Title => _session?.Current is { } design
        ? _session.Localizer.Name(design.Name, design.Key)
        : "Designer";

    protected override async Task OnInitializedAsync() => _session = await Host.GetAsync();

    /// <summary>
    /// Whether a destination is still this same empire.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The list counts, but only while the button back to it is being pressed: that button reopens
    /// the editor there, so the empire is in hand either side, unsaved work and all, and being asked
    /// whether to save it on the way to looking at the same empire in the other editor is a question
    /// with no answer worth giving.
    /// </para>
    /// <para>
    /// The header's Empires link goes to the same address and is not the same thing at all - it
    /// leaves the empire behind, with nothing open on it. Waved through unconditionally, a new
    /// empire created and never saved was left sitting in the list looking exactly like one that
    /// had been: it is in the file only because the editor needs something to work on, and only
    /// the question that was not asked would have taken it back out.
    /// </para>
    /// </remarks>
    private bool SameEmpire(string route) => route is "designer" || (_crossing && route.Length == 0);

    /// <summary>
    /// Set while the button back to the list is being pressed, and never otherwise.
    /// </summary>
    /// <remarks>
    /// The guard is asked about every destination and cannot see which control started it, so the
    /// one navigation that is not a departure has to say so itself.
    /// </remarks>
    private bool _crossing;

    /// <summary>
    /// Back to the list, which opens its own editor on the empire still in hand.
    /// </summary>
    /// <remarks>
    /// No question asked, for the reason above. There is no separate way across to the card either -
    /// the card is what is underneath, so one button does both.
    /// </remarks>
    private void Back()
    {
        _crossing = true;
        Editor.IsOpen = true;
        Navigation.NavigateTo(string.Empty);
    }

    /// <summary>Back to the list with nothing open, the empire having been deleted.</summary>
    /// <remarks>
    /// Crossing as well, because there is nothing left to ask about: deleting has already cleared
    /// the unsaved flag, and the guard stopping to ask about an empire that no longer exists would
    /// be a question with no subject.
    /// </remarks>
    private void Finished()
    {
        _crossing = true;
        Editor.IsOpen = false;
        Navigation.NavigateTo(string.Empty);
    }
}
