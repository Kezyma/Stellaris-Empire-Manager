@page "/designer"
@implements IDisposable
@inject SessionHost Host
@inject IFileExchange Files
@inject NavigationManager Navigation

<PageTitle>@Title — Stellaris Empire Manager</PageTitle>

@if (_session is null)
{
    <div class="sem-loading"><p>Loading…</p></div>
}
else if (_session.Current is null)
{
    <div class="sem-empty">
        <p>No empire is open.</p>
        <button type="button" class="primary" @onclick="@(() => Navigation.NavigateTo(""))">
            Back to your empires
        </button>
    </div>
}
else
{
    <div class="sem-panel">
        <div class="sem-row">
            <button type="button" @onclick="@(() => Navigation.NavigateTo(""))">← Empires</button>

            @* Shown, not edited: the empire is named once, in its own section. *@
            <span class="sem-title">@Title</span>

            @*
                The count opens the list. It used to be a word beside the title while the problems
                themselves were listed in the preview, which made that panel read as a verdict on the
                empire rather than a description of it. Here the count is next to the empire it is
                about, and the detail is one click away rather than always underfoot.
            *@
            @if (_session.Report.IsValid && _session.Report.Warnings.Count == 0)
            {
                <span class="sem-status ok">Valid</span>
            }
            else
            {
                <button type="button" class="sem-status-toggle @(_session.Report.IsValid ? "warn" : "bad")"
                        aria-expanded="@(_showProblems ? "true" : "false")"
                        @onclick="() => _showProblems = !_showProblems">
                    @ProblemSummary
                    <span class="chevron" aria-hidden="true">@(_showProblems ? "▾" : "▸")</span>
                </button>
            }

            @*
                Kept even though the address bar now carries the same link: it saves selecting the
                bar, and it is the only thing that says out loud that the link was taken.
            *@
            <button type="button" @onclick="CopyLink" title="The address bar carries this link too">
                @(_copied ? "Link copied" : "Copy link")
            </button>
            @*
                The same empire in the game's own arrangement. One session behind both, so this is
                a change of view rather than a change of empire.
            *@
            <button type="button" @onclick="@(() => Navigation.NavigateTo("designer/classic"))"
                    title="The same empire, laid out the way the game lays it out">
                Game layout
            </button>
            <button type="button" class="danger" @onclick="Delete">Delete</button>
            <button type="button" class="primary" @onclick="Export">@Files.SaveVerb</button>
        </div>
    </div>

    @if (_showProblems)
    {
        <div class="sem-problems">
            @foreach (var problem in _session.Report.Errors)
            {
                <div class="sem-problem">
                    <div class="area">@problem.Area</div>
                    <div>@problem.Message</div>

                    @foreach (var reason in problem.Reasons.Distinct())
                    {
                        <div class="why">@_session.Localizer.Text(reason)</div>
                    }
                </div>
            }

            @foreach (var problem in _session.Report.Warnings)
            {
                <div class="sem-problem warning">
                    <div class="area">@problem.Area</div>
                    <div>@problem.Message</div>
                </div>
            }
        </div>
    }

    <DesignerShell Session="_session" />
}

@code {
    private DesignSession? _session;

    /// <summary>Whether the last thing the player did was copy the link, so the button can say so.</summary>
    private bool _copied;

    /// <summary>Whether the list behind the problem count is open.</summary>
    private bool _showProblems;

    /// <summary>
    /// What the count says, which is what there is rather than always "problems".
    /// </summary>
    /// <remarks>
    /// An empire with nothing wrong but something worth mentioning was reading "Valid" while
    /// carrying three warnings nobody could see.
    /// </remarks>
    private string ProblemSummary
    {
        get
        {
            var errors = _session!.Report.Errors.Count;
            var warnings = _session.Report.Warnings.Count;

            var parts = new List<string>();

            if (errors > 0)
            {
                parts.Add($"{errors} problem{(errors == 1 ? string.Empty : "s")}");
            }

            if (warnings > 0)
            {
                parts.Add($"{warnings} warning{(warnings == 1 ? string.Empty : "s")}");
            }

            return string.Join(", ", parts);
        }
    }

    private string Title => _session?.Current is { } design
        ? _session.Localizer.Name(design.Name, design.Key)
        : "Designer";

    /// <summary>
    /// The empire the address bar is currently showing, so it is only rewritten when it changes.
    /// </summary>
    private string? _shown;

    protected override async Task OnInitializedAsync()
    {
        _session = await Host.GetAsync();

        if (_session is not null)
        {
            _session.Changed += OnChanged;
            OpenSharedDesign();
            ShowInAddressBar();
        }
    }

    /// <summary>
    /// Opens an empire someone sent a link to, adding it to whatever file is already open.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Added rather than swapped in: the link is a gift, not a replacement for the empires the
    /// player already has. A name already taken gets a number after it, as a copy would.
    /// </para>
    /// <para>
    /// An empire the file already holds is selected instead of copied. That matters now that the
    /// address bar always carries the empire being edited: without it, every reload of an ordinary
    /// editing session would add another copy of the same empire.
    /// </para>
    /// </remarks>
    private void OpenSharedDesign()
    {
        var query = new Uri(Navigation.Uri).Query;

        if (System.Web.HttpUtility.ParseQueryString(query)[DesignLink.Parameter] is not { Length: > 0 } shared ||
            DesignLink.Decode(shared) is not { } design)
        {
            return;
        }

        // Compared as encoded text because that is exactly what a link carries: two designs with the
        // same encoding are the same empire down to the byte, and no field has to be named here.
        if (_session!.File?.Designs.FirstOrDefault(d => DesignLink.Encode(d) == shared) is { } already)
        {
            _session.Select(already);
            _shown = shared;
            return;
        }

        _session.EditFile(file =>
        {
            var key = design.Key;

            for (var attempt = 2; file.Find(key) is not null; attempt++)
            {
                key = $"{design.Key} {attempt}";
            }

            _session.Select(file.AddCopy(design, key));
        });
    }

    /// <summary>
    /// Puts the empire being edited in the address bar, so it can be shared by copying it.
    /// </summary>
    /// <remarks>
    /// Replacing rather than pushing, so that editing an empire does not fill the back button with
    /// one entry per keystroke. Only written when it actually changed, since navigating is not free
    /// and this runs on every edit.
    /// </remarks>
    private void ShowInAddressBar()
    {
        if (_session?.Current is not { } design)
        {
            return;
        }

        var encoded = DesignLink.Encode(design);

        if (encoded == _shown)
        {
            return;
        }

        _shown = encoded;
        Navigation.NavigateTo($"designer?{DesignLink.Parameter}={encoded}", replace: true);
    }

    private async Task CopyLink()
    {
        if (_session?.Current is not { } design)
        {
            return;
        }

        var link = $"{Navigation.BaseUri}designer?{DesignLink.Parameter}={DesignLink.Encode(design)}";

        _copied = await Files.CopyToClipboardAsync(link);
    }

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
        }
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        ShowInAddressBar();
        StateHasChanged();
    });

    private void Delete()
    {
        if (_session?.Current is { } design)
        {
            _session.EditFile(file => file.Remove(design));
            _session.Select(_session.File?.Designs.FirstOrDefault());
            Navigation.NavigateTo("");
        }
    }

    private async Task Export()
    {
        var name = _session!.FileName is { Length: > 0 } existing ? existing : EmpireDesignsFile.FileName;
        await Files.SaveAsync(name, _session.Save());
    }
}
