@page "/designer/classic"
@implements IDisposable
@inject SessionHost Host
@inject NavigationManager Navigation

@*
    The same empire, arranged the way the game arranges it.

    Not a replacement for the designer: that page is the complete editor and stays so. This one is
    for the player who knows where everything is because they have used the game's own creation
    screen, and would rather not learn a second arrangement.

    Both pages share one SessionHost, so an empire half-built in one is half-built in the other and
    either can be left at any point.
*@

<PageTitle>@Title — Stellaris Empire Manager</PageTitle>

@if (_session is null)
{
    <div class="sem-loading"><p>Loading…</p></div>
}
else if (_session.Current is null)
{
    <div class="sem-empty">
        <p>No empire is open.</p>
        <button type="button" class="primary" @onclick="@(() => Navigation.NavigateTo(""))">
            Back to your empires
        </button>
    </div>
}
else
{
    <CascadingValue Value="_session">
        <div class="sem-classic">
            <div class="sem-row">
                <button type="button" @onclick="@(() => Navigation.NavigateTo("designer"))">
                    ← Full editor
                </button>

                <span class="sem-title">@Title</span>

                <span class="sem-status @(_session.Report.IsValid ? "ok" : "bad")">
                    @(_session.Report.IsValid ? "Valid" : $"{_session.Report.Errors.Count} problem(s)")
                </span>
            </div>

            @*
                The tab strip. The game does not have one — it moves between sub-editors with Back
                and Next, having walked the player through them in order — but a player who already
                has an empire wants to reach one part of it, and thirteen Next presses is not that.
            *@
            <div class="sem-gui-tabs">
                @foreach (var (key, name) in Editors)
                {
                    <button type="button" class="@(key == _editor ? "selected" : null)"
                            aria-pressed="@(key == _editor)"
                            disabled="@(key != "flag")"
                            @onclick="() => _editor = key">@name</button>
                }
            </div>

            @*
                The sub-editor, at the 1040 by 405 the game's own interface file states, scaled down
                as one piece where the page is narrower. Scaled rather than reflowed because the
                arrangement is the point: a layout read off the game's coordinates and then allowed
                to wrap would be neither the game's nor ours.
            *@
            <div class="sem-gui-stage">
                <GuiSurface Name="GFX_subwindow_tile_plain_solid" Class="window" Width="1040" Height="405">
                    @if (_editor == "flag")
                    {
                        <GuiFlagEditor />
                    }
                </GuiSurface>
            </div>

            @*
                What the sub-window opens over. The game shows the empire being made behind its
                editors, which is how a player sees a flag change while choosing its colour.
            *@
            <EmpireShowcase Design="_session.Current" />
        </div>
    </CascadingValue>
}

@code {
    private DesignSession? _session;

    /// <summary>Which sub-editor is open, by the game's own window name without its suffix.</summary>
    private string _editor = "flag";

    /// <summary>
    /// The game's thirteen sub-editors, in the order its own file declares them.
    /// </summary>
    /// <remarks>
    /// All thirteen are listed from the start, and the ones not yet arranged are shown disabled
    /// rather than hidden. The strip is a map of the game's designer, and a map missing most of its
    /// places would say the wrong thing about what this page is going to be.
    /// </remarks>
    private static readonly (string Key, string Name)[] Editors =
    [
        ("empire", "Empire"),
        ("species", "Species"),
        ("names", "Names"),
        ("traits", "Traits"),
        ("origin", "Origin"),
        ("government", "Government"),
        ("homeworld", "Homeworld"),
        ("ruler", "Ruler"),
        ("ruler-traits", "Ruler Traits"),
        ("flag", "Flag"),
        ("room", "Room"),
        ("shipset", "Shipset"),
        ("advisor", "Advisor"),
    ];

    private string Title => _session?.Current is { } design
        ? _session.Localizer.Name(design.Name, design.Key)
        : "Designer";

    protected override async Task OnInitializedAsync()
    {
        _session = await Host.GetAsync();

        if (_session is not null)
        {
            _session.Changed += OnChanged;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
        }
    }
}
