@page "/"
@implements IDisposable
@inject SessionHost Host
@inject IFileExchange Files
@inject NavigationManager Navigation

<PageTitle>Empires — Stellaris Empire Manager</PageTitle>

@if (_session is null)
{
    <div class="sem-loading">
        @if (Host.LoadError is { } error)
        {
            <h2>The game data is not available</h2>
            <p class="sem-hint">@error</p>
            <p class="sem-hint">
                A local build needs the data extracted first:
                <code>dotnet run --project src/Sem.Cli -- extract --web</code>
            </p>
        }
        else
        {
            <p>Loading game data…</p>
        }
    </div>
}
else
{
    <div class="sem-panel">
        <div class="sem-row">
            <div>
                <h2 style="margin:0">Your empires</h2>
                <span class="sem-hint">
                    @if (_session.File is { } file && file.Designs.Count > 0)
                    {
                        @($"{file.Designs.Count} in {_session.FileName}")
                        @if (_session.IsModified)
                        {
                            <text> · unsaved changes</text>
                        }
                    }
                    else
                    {
                        <text>Open your empire designs file to begin.</text>
                    }
                </span>
            </div>

            <span class="sem-spacer"></span>

            <label class="sem-button" for="designs-file">Open designs file</label>
            <InputFile id="designs-file" OnChange="OpenFile" style="display:none" accept=".txt" />

            <button type="button" @onclick="AddEmpire">New empire</button>

            <button type="button" class="primary"
                    disabled="@(_session.File is null || _session.File.Designs.Count == 0)"
                    @onclick="Export">
                @Files.SaveVerb
            </button>
        </div>

        @if (_error is { } message)
        {
            <p class="sem-status bad" style="margin-top:10px">@message</p>
        }
    </div>

    <p class="sem-hint" style="margin-bottom:16px">
        Your file is read in this tab and never uploaded. Empires you do not touch are written back
        exactly as they were.
    </p>

    @*
        The select screen: the empires to choose from on one side, and whichever one is highlighted
        shown in full on the other. On a narrow screen the preview comes first, as it does in the
        designer — it is the answer, and the lists are the way to change the question.
    *@
    <CascadingValue Value="_session">
        <div class="sem-select">
            <div class="preview">
                @if (Previewed is { } previewed)
                {
                    <EmpireShowcase Design="previewed" Lore="@_previewSource?.DescriptionKey">
                        <Actions>
                            @if (_previewOwn)
                            {
                                <button type="button" class="primary" @onclick="() => OpenDesigner(previewed)">
                                    Edit
                                </button>
                            }
                            else if (_previewSource is { } source)
                            {
                                <button type="button" class="primary" @onclick="() => Duplicate(source)">
                                    Duplicate
                                </button>
                            }
                        </Actions>
                    </EmpireShowcase>
                }
                else
                {
                    <div class="sem-empty">
                        <p>Pick an empire to see it here.</p>
                    </div>
                }
            </div>

            <div class="lists">
                <EmpireBrowser Session="_session" OnSelected="PreviewOwn" />

                @*
                    The game's own empires, for everyone. They are worth reading on their own — a
                    good deal of the game's writing is in them — and worth copying, since starting
                    from one that already works beats starting from a blank slate.
                *@
                @*
                    A section rather than a card: there are fifty-two of these and a panel drawn
                    round them made one very large box on a page that is already boxes. The heading
                    is enough to say where the list starts.
                *@
                <div class="sem-prescripted">
                    <h2 style="margin:0">The game's empires</h2>
                    <span class="sem-hint">@Prescripted.Count built in.</span>

                    <div class="sem-empires sem-empires-preset">
                        @foreach (var empire in Prescripted)
                        {
                            var read = Read(empire);

                            <EmpireCard Flag="@read?.Design.Flag"
                                        Portrait="@Thumbnail(empire)"
                                        Name="@_session.Localizer.Text(empire.NameKey, empire.Key)"
                                        Government="@read?.Government"
                                        SpeciesClass="@ClassOf(empire)"
                                        Selected="@ReferenceEquals(empire, _previewSource)"
                                        Disabled="@(read is null)"
                                        OnClick="() => PreviewPrescripted(empire)" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </CascadingValue>
}

@code {
    private DesignSession? _session;
    private string? _error;

    /// <summary>Whether the panel is showing one of the player's own empires or one of the game's.</summary>
    private bool _previewOwn;

    /// <summary>The built-in empire being shown, and the design read out of it.</summary>
    private PrescriptedEmpireSummary? _previewSource;

    private EmpireDesign? _previewDesign;

    protected override async Task OnInitializedAsync()
    {
        _session = await Host.GetAsync();

        // The content packs decide which of the game's empires a player could actually start as, and
        // the bar that turns them on and off is a different component. Without listening, turning a
        // pack off left its empires sitting in the list.
        if (_session is not null)
        {
            _session.Changed += OnChanged;

            // Coming back from the designer, the empire that was being edited is the one to show.
            _previewDesign = _session.Current;
            _previewOwn = _previewDesign is not null;
        }
    }

    /// <summary>
    /// The empire the panel is showing, whichever list it came from.
    /// </summary>
    /// <remarks>
    /// It stops being shown once it leaves the list beside it: one of the player's own when a
    /// different file is opened, one of the game's when the content pack it needs is turned off.
    /// A panel describing an empire that is no longer there would be describing nothing.
    /// </remarks>
    private EmpireDesign? Previewed => _previewDesign is { } design && StillListed ? design : null;

    private bool StillListed =>
        _previewOwn
            ? _session?.File?.Designs.Contains(_previewDesign!) is true
            : _previewSource is { } source && Prescripted.Contains(source);

    private void PreviewOwn(EmpireDesign design)
    {
        _previewDesign = design;
        _previewOwn = true;
        _previewSource = null;
    }

    /// <summary>
    /// Shows one of the game's own empires without copying it into the player's file.
    /// </summary>
    /// <remarks>
    /// Read into a file of its own, which nothing ever saves — the same reading the list beside it
    /// already did to learn what the empire's government is called, so it costs nothing here.
    /// </remarks>
    private void PreviewPrescripted(PrescriptedEmpireSummary empire)
    {
        if (Read(empire) is not { } preset)
        {
            return;
        }

        _previewDesign = preset.Design;
        _previewSource = empire;
        _previewOwn = false;
    }

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
        }
    }

    private void OnChanged()
    {
        // The content packs decide which empires are listed, so the list is worked out again.
        _prescripted = null;
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenFile(InputFileChangeEventArgs e)
    {
        _error = null;

        try
        {
            // Generous enough for any real designs file; the player's own is about forty kilobytes.
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _session!.Load(buffer.ToArray(), e.File.Name);
        }
        catch (Exception ex) when (ex is Sem.Clausewitz.CwSyntaxException or IOException)
        {
            // Loading half a damaged file would be worse than refusing it.
            _error = $"That file could not be read: {ex.Message}";
        }
    }

    private void AddEmpire()
    {
        if (_session?.File is null)
        {
            _session?.StartEmptyFile();
        }

        var name = Available("New Empire");
        var template = _session!.Data.Database.NewEmpireTemplate;

        // The game keeps a blank template of its own; starting from it means a new empire is
        // playable straight away rather than an empty shell.
        _session.EditFile(file =>
        {
            if (string.IsNullOrEmpty(template))
            {
                file.Add(name);
            }
            else
            {
                file.AddFromTemplate(template, name);
            }
        });

        _session.Select(_session.File!.Find(name));
        Navigation.NavigateTo("designer");
    }

    /// <summary>
    /// The game's own empires, those a player could actually start as, worked out once.
    /// </summary>
    /// <remarks>
    /// Several are marked playable only with a content pack, and a couple not at all — the game
    /// keeps a legacy United Nations of Earth beside the playable one. Judged against what the
    /// player says they own, so the list matches what their game would show.
    /// </remarks>
    /// <remarks>
    /// Held rather than recomputed: judging one needs a context, and building that per empire meant
    /// fifty-two throwaway files and designs every time the page drew. Cleared when the session
    /// changes, which is what turning a content pack on and off does.
    /// </remarks>
    private IReadOnlyList<PrescriptedEmpireSummary> Prescripted =>
        _prescripted ??= BuildPrescripted();

    private IReadOnlyList<PrescriptedEmpireSummary>? _prescripted;

    private readonly RequirementEvaluator _evaluator = new();

    private IReadOnlyList<PrescriptedEmpireSummary> BuildPrescripted()
    {
        // A built-in empire's own conditions are almost all about content packs, so nothing about
        // any particular design matters here — only what the player has.
        var context = _session!.Rules.CreateContext(
            EmpireDesignsFile.CreateEmpty().Add("scratch"),
            _session.OwnedDlc);

        return
        [
            .. _session.Data.Database.PrescriptedEmpires
                .Where(e => _evaluator.IsSatisfied(e.Playable, context))
                .OrderBy(e => _session.Localizer.Text(e.NameKey, e.Key), StringComparer.CurrentCulture)
        ];
    }

    private string? Thumbnail(PrescriptedEmpireSummary empire) =>
        PortraitArtwork.For(_session!.Data.Database, empire.Portrait, gender: null);

    /// <summary>The third line of the game's own list entry: what kind of thing lives there.</summary>
    private string? ClassOf(PrescriptedEmpireSummary empire) =>
        empire.SpeciesClass is { Length: > 0 } kind ? _session!.Localizer.Text(kind) : null;

    /// <summary>One of the game's empires, read out of its stored text.</summary>
    private sealed record Preset(EmpireDesign Design, string Government);

    /// <summary>
    /// The game's own empires as designs, read once and held.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A built-in empire's flag and its government are both inside the stored text rather than
    /// beside it in the summary, so showing either means parsing the empire. Fifty-two of them, and
    /// the list draws on every keystroke elsewhere on the page — so they are read once.
    /// </para>
    /// <para>
    /// Never cleared, unlike the list of which empires are offered. What an empire's government is
    /// called depends on its authority, ethics and civics, and not one of the game's hundred and
    /// seventy government types asks about a content pack — so turning a pack off can change which
    /// of these are listed but never what any of them is called.
    /// </para>
    /// </remarks>
    private Preset? Read(PrescriptedEmpireSummary empire)
    {
        if (_presets.TryGetValue(empire.Key, out var known))
        {
            return known;
        }

        var preset = Parse(empire);
        _presets[empire.Key] = preset;
        return preset;
    }

    private readonly Dictionary<string, Preset?> _presets = new(StringComparer.Ordinal);

    private Preset? Parse(PrescriptedEmpireSummary empire)
    {
        if (empire.Design is not { Length: > 0 } text)
        {
            return null;
        }

        try
        {
            if (EmpireDesignsFile.LoadText(text).Designs.FirstOrDefault() is not { } design)
            {
                return null;
            }

            var context = _session!.Rules.CreateContext(design, _session.OwnedDlc);

            return new Preset(
                design,
                _session.Rules.DeriveGovernment(context) is { } government
                    ? _session.Localizer.Text(government.Key)
                    : _session.Localizer.Text(design.Authority));
        }
        catch (Sem.Clausewitz.CwSyntaxException)
        {
            // One unreadable built-in empire should not take the page down with it.
            return null;
        }
    }

    /// <summary>
    /// Copies one of the game's empires into the player's file and opens it.
    /// </summary>
    /// <remarks>
    /// A copy, not a link: the point is to edit it. The name gains a number where one is already
    /// taken, as a duplicate of anything else would.
    /// </remarks>
    private void Duplicate(PrescriptedEmpireSummary empire)
    {
        if (empire.Design is not { Length: > 0 } design)
        {
            return;
        }

        if (_session!.File is null)
        {
            _session.StartEmptyFile();
        }

        var name = Available(_session.Localizer.Text(empire.NameKey, empire.Key));

        _session.EditFile(file => file.AddFromTemplate(design, name));
        _session.Select(_session.File!.Find(name));
        Navigation.NavigateTo("designer");
    }

    /// <summary>A name nothing in the file has yet.</summary>
    private string Available(string wanted)
    {
        if (_session?.File?.Find(wanted) is null)
        {
            return wanted;
        }

        for (var i = 2; ; i++)
        {
            var candidate = $"{wanted} {i}";
            if (_session.File.Find(candidate) is null)
            {
                return candidate;
            }
        }
    }

    private void OpenDesigner(EmpireDesign design)
    {
        _session!.Select(design);
        Navigation.NavigateTo("designer");
    }

    private async Task Export()
    {
        var name = _session!.FileName is { Length: > 0 } existing ? existing : EmpireDesignsFile.FileName;
        await Files.SaveAsync(name, _session.Save());
    }
}
