@page "/"
@page "/e/{Shared}"
@implements IDisposable
@inject SessionHost Host
@inject IFileExchange Files
@inject NavigationManager Navigation
@inject UnsavedWorkGuard Unsaved
@inject EditorState Editor

<PageTitle>Empires - Stellaris Empire Manager</PageTitle>

@if (_session is null)
{
    <div class="sem-loading">
        @if (Host.LoadError is { } error)
        {
            <h2>The game data is not available</h2>
            <p class="sem-hint">@error</p>
            <p class="sem-hint">
                A local build needs the data extracted first:
                <code>dotnet run --project src/Sem.Cli -- extract --web</code>
            </p>
        }
        else
        {
            <p>Loading game data…</p>
        }
    </div>
}
else
{
    @*
        No card of file buttons here any more. Create, Import and Export are in the header, where
        they are reachable from the designer too and are not written out twice.
    *@
    @*
        What is open. It used to sit in the header beside the buttons that act on it, which made the
        header four items and a sentence; this is the file's own page, so it says so here.
    *@
    <p class="sem-hint">
        @if (_session.File is { } file && file.Designs.Count > 0)
        {
            @($"{file.Designs.Count} empires in {_session.FileName}.")

            @* The desktop's alone: a browser stores the file as soon as the list changes, so
               nothing is ever outstanding there. *@
            @if (Files.SavesInPlace && _session.HasUnwrittenFileChanges)
            {
                <text> Not yet written back.</text>
            }
        }
        else
        {
            <text>No empires yet. Import a designs file, or create one.</text>
        }
    </p>

    <CascadingValue Value="_session">
        @*
            Two ways of being shown the same empires, and the controls that decide which.

            Cards answer "which one is that" - a flag, a face, and the two lines that tell one
            empire from another at a glance. The table answers the questions a card cannot, because
            they are questions about the set rather than about any one of them: which of these are
            Fanatic Purifiers, what does the file hold three of, which of the game's empires start
            on a Relic World. Neither is a better version of the other.
        *@
        <div class="sem-list-head">
            <div class="sem-view-toggle" role="group" aria-label="How to show the empires">
                <button type="button" aria-pressed="@(_listView ? "false" : "true")"
                        @onclick="() => ShowList(false)">Cards</button>

                <button type="button" aria-pressed="@(_listView ? "true" : "false")"
                        @onclick="() => ShowList(true)">List</button>
            </div>

            @if (_listView)
            {
                @*
                    Which columns, beside the toggle rather than in the filter card: it says what the
                    table looks like, not which empires are in it, and a reader clearing the filters
                    should not find their columns cleared with them.
                *@
                <div class="sem-columns">
                    <label id="column-picker">Columns</label>
                    <MultiSelect Label="Choose" Options="@ColumnOptions" Selected="@_visible"
                                 OnChanged="RememberColumns" />
                </div>
            }
        </div>

        @if (_listView)
        {
            <EmpireFilters Rows="@AllRows" Filter="@_filter" OnChanged="StateHasChanged" />

            <EmpireTable Heading="Your empires" Rows="@Narrowed(OwnRows)" Total="@OwnRows.Count"
                         Columns="@VisibleColumns" OnOpen="OpenRow"
                         Empty="None of your empires match." />

            <EmpireTable Heading="The game's empires" Rows="@Narrowed(PresetRows)"
                         Total="@PresetRows.Count" Columns="@VisibleColumns" OnOpen="OpenRow"
                         Empty="None of the game's empires match." />
        }
        else
        {
        @*
            The lists, and the editor over them when one is open.

            There is no preview panel beside them any more. It was a column-wide summary of an empire
            you had to open the designer to change, which meant every real question about an empire
            was answered on another page; pressing one now opens the empire itself, in full, over the
            list it came from. What the preview showed is in there, in the card's second column.
        *@
        <div class="sem-select">
            <div class="lists">
                <EmpireBrowser Session="_session" OnSelected="OpenOwn"
                               OnCopyLink="CopyLink" CopyTitle="CopyTitleFor" />

                @*
                    The game's own empires, for everyone. They are worth reading on their own — a
                    good deal of the game's writing is in them — and worth copying, since starting
                    from one that already works beats starting from a blank slate.
                *@
                @*
                    A section rather than a card: there are fifty-two of these and a panel drawn
                    round them made one very large box on a page that is already boxes. The heading
                    is enough to say where the list starts.
                *@
                <div class="sem-prescripted">
                    <h2>The game's empires</h2>
                    <span class="sem-hint">@Prescripted.Count built in.</span>

                    <div class="sem-empires sem-empires-preset">
                        @foreach (var empire in Prescripted)
                        {
                            var read = Read(empire);

                            <EmpireCard Flag="@read?.Design.Flag"
                                        Portrait="@Thumbnail(empire)"
                                        Name="@_session.Localizer.Text(empire.NameKey, empire.Key)"
                                        Government="@read?.Government"
                                        SpeciesClass="@ClassOf(empire)"
                                        Disabled="@(read is null)"
                                        OnCopyLink="@(read is null ? default : EventCallback.Factory.Create(this, () => CopyLink(read.Design)))"
                                        CopyTitle="@(read is null ? string.Empty : CopyTitleFor(read.Design))"
                                        OnClick="() => OpenPrescripted(empire)" />
                        }
                    </div>
                </div>
            </div>
        </div>
        }

        @if (Editing)
        {
            @*
                The editor, over the list rather than on a page of its own.

                A dialog inside a dialog, since the card opens one of its own for whichever part was
                pressed. Both are fixed to the viewport and neither ancestor gives them a containing
                block, so the inner one covers this and is covered in turn by a question - which is
                the order they have to be in.
            *@
            <div class="sem-modal sem-lite-modal" @onclick="Close">
                <div class="sheet" role="dialog" aria-modal="true" aria-label="@($"Editing {Name}")"
                     tabindex="-1" @ref="_sheet" @onkeydown="OnKey" @onclick:stopPropagation="true">

                    <EmpireEditor Session="_session" StaysHere="SameEmpire" TracksAddress="true"
                                  InDialog="true" OnBack="Close" OnDeleted="Finished">
                        <Body Context="actions">
                            <LiteShell Session="_session" Actions="@actions"
                                       OnPartClosed="() => _focused = false" />
                        </Body>
                        <Across>
                            @*
                                The other editor, named for what it does rather than for what it is
                                called: the same empire, as it stands, in a page of sections. The
                                empire goes across unsaved and comes back the same way, so nothing
                                is asked on the way through.
                            *@
                            <button type="button" class="icon primary" title="Open the advanced editor"
                                    aria-label="Open the advanced editor" @onclick="OpenAdvanced">
                                <ActionIcon Name="edit" />
                            </button>
                        </Across>
                    </EmpireEditor>
                </div>
            </div>
        }
    </CascadingValue>
}

@code {
    private DesignSession? _session;

    /// <summary>
    /// The empire a link carried, taken from the address itself rather than from a query.
    /// </summary>
    /// <remarks>
    /// Null whenever the page was reached any other way - the Empires button, a Create, or one of
    /// the links written before the route was shortened, which still arrive as "designer?d=…".
    /// </remarks>
    [Parameter]
    public string? Shared { get; set; }

    /// <summary>Whether the editor is drawn over the list.</summary>
    /// <remarks>
    /// Kept in a service rather than here, because two of the things that open it are not on this
    /// page: the header's Create, and the way back from the advanced editor.
    /// </remarks>
    private bool Editing => Editor.IsOpen && _session?.Current is not null;

    private string Name => _session?.Current is { } design
        ? _session.Localizer.Name(design.Name, design.Key)
        : "empire";

    /// <summary>The dialog, so Escape reaches it and Tab stays inside.</summary>
    private ElementReference _sheet;

    /// <summary>Whether the dialog has taken the keyboard, so it is only taken once.</summary>
    private bool _focused;

    /// <summary>Whether the session has loaded and any shared link has been opened.</summary>
    private bool _ready;

    /// <summary>Whether the empires are drawn as a table rather than as cards.</summary>
    private bool _listView;

    /// <summary>What the reader has narrowed both lists down to.</summary>
    private readonly EmpireFilter _filter = new();

    /// <summary>Which columns the table draws, beside the name.</summary>
    private HashSet<string> _visible = [];

    /// <summary>What the two settings above are remembered under.</summary>
    private const string ViewSetting = "empire-view";

    private const string ColumnSetting = "empire-columns";

    /// <summary>The value of the view setting that means the table.</summary>
    private const string ListView = "list";

    /// <summary>
    /// Set from the editor closing until the address it left behind has been cleared.
    /// </summary>
    /// <remarks>
    /// Closing may change the empire in hand - one of the game's goes back out of the file, and the
    /// next one along is selected - and that change is written into the address by an editor that
    /// has not finished unmounting. Without this the page read its own leftover address as somebody
    /// opening a link and put the editor straight back up, on whichever empire the close had landed
    /// on. Clicking outside the dialog on one of the game's empires reopened it on the first of the
    /// player's own.
    ///
    /// Here rather than in the editor, which cannot see two of the three ways out: the backdrop and
    /// Escape are this page's, and only the button is the editor's own.
    /// </remarks>
    private bool _closing;

    /// <summary>
    /// Set while stepping across to the advanced editor, so the guard reads it as the same empire.
    /// </summary>
    /// <remarks>
    /// The button is the only way to that page from here, but the guard is asked about every
    /// destination and "designer" is not one it should wave through on a link somebody else wrote.
    /// </remarks>
    private bool _crossing;

    /// <summary>The empire the last link was copied from, and whether the clipboard took it.</summary>
    /// <remarks>
    /// Held against the design rather than as one flag for the page, because these buttons are on
    /// every card: a single flag reported one card's success on all fifty-three of them. The preset
    /// designs are parsed once and kept, so the same empire is the same object every render and
    /// comparing by reference is sound.
    /// </remarks>
    private EmpireDesign? _copiedFrom;

    private bool _copyWorked;

    /// <summary>
    /// Opens an empire the address gained while this page was already on screen.
    /// </summary>
    /// <remarks>
    /// Which is the Back button, in practice: opening an empire writes it into the address and
    /// closing takes it out again, so going back asks for the one just closed. Without this the
    /// address changed and nothing else did, and the clearing below then undid the Back.
    ///
    /// The editor being shut is what makes this safe to run on any change. The address is also
    /// rewritten every time the empire is saved, and that happens with the editor open - which this
    /// ignores, rather than reading the page's own bookkeeping as a fresh link.
    /// </remarks>
    protected override void OnParametersSet()
    {
        if (_ready && !Editing && !_closing && Shared is { Length: > 0 })
        {
            OpenSharedDesign();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _session = await Host.GetAsync();

        // The content packs decide which of the game's empires a player could actually start as, and
        // the bar that turns them on and off is a different component. Without listening, turning a
        // pack off left its empires sitting in the list.
        if (_session is not null)
        {
            _session.Changed += OnChanged;

            // Read before anything is drawn, so somebody who chose the table is not shown the cards
            // for a frame on the way to it.
            _listView = _session.Preferences.Get(ViewSetting) == ListView;
            _visible = KeptColumns();

            OpenSharedDesign();

            // Last, and only here. Until the link has been read there is nothing to say about the
            // address, and saying it early is what wiped the link.
            _ready = true;
        }
    }

    /// <summary>
    /// Takes the keyboard when the editor appears, so Escape reaches it.
    /// </summary>
    /// <remarks>
    /// Once, rather than on every render. The card's own dialogs take the focus while they are open
    /// and this page redraws under them on every edit; grabbing it back each time would put the
    /// caret outside whatever was being typed into.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Editing)
        {
            if (!_focused)
            {
                _focused = true;
                await _sheet.FocusAsync();
            }

            return;
        }

        _focused = false;

        // The editor keeps the empire in the address while it is open, and writes there once more
        // on its way out: reverting an empire that was never saved selects another, and that change
        // reaches the address after the dialog has already gone. Cleared here rather than as the
        // editor closes, because here there is nothing still queued to undo it - and an address
        // left naming an empire nobody has open would reopen it on the next reload.
        //
        // Never before the link has been read. The first render happens while the game data is
        // still being awaited, so this ran with no session, no editor open and the payload sitting
        // in the address - and cleared it before anything had looked at it. A shared link opened
        // the bare list.
        if (_ready && Shared is { Length: > 0 })
        {
            Navigation.NavigateTo(string.Empty, replace: true);
            return;
        }

        // The address is clear, so whatever turns up in it next really is somebody opening a link.
        _closing = false;
    }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    /// <summary>What one empire's share button says, which is only ever news about that one.</summary>
    private string CopyTitleFor(EmpireDesign? design) =>
        design is not null && ReferenceEquals(design, _copiedFrom)
            ? _copyWorked ? "Link copied" : "The clipboard would not take it"
            : "Copy a link to this empire";

    /// <summary>
    /// Puts a link to one empire on the clipboard, without opening it.
    /// </summary>
    /// <remarks>
    /// The same link the editor offers, and built the same way — against the address the app is
    /// published at, since on the desktop the window's own origin is somewhere only this process
    /// can reach. Offered from the list because taking a link used to mean opening the empire
    /// first, which for one of the game's own meant copying it into your file to get at it.
    /// </remarks>
    private async Task CopyLink(EmpireDesign design)
    {
        var origin = Files.ShareBaseUri ?? Navigation.BaseUri;

        _copyWorked = await Files.CopyToClipboardAsync(
            origin + DesignLink.Address(DesignLink.Encode(design)));

        _copiedFrom = design;
    }

    /// <summary>Opens one of the player's own empires in the editor.</summary>
    private void OpenOwn(EmpireDesign design)
    {
        _session!.Select(design);
        Editor.IsOpen = true;
    }

    /// <summary>
    /// Opens one of the game's empires as a copy, which is the only way it can be edited.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A copy, not a link: the game's own file is not ours to write. Held out of the player's file
    /// until they press Save, the same as a new empire and the same as a shared one - opening one of
    /// the game's to see how it is put together should not leave a copy behind. The name gains a
    /// number where one is already taken, as a duplicate of anything else would.
    /// </para>
    /// <para>
    /// Not counted as unsaved work, though, which the other two are. Nothing is at stake in an
    /// empire that can be opened again from the same shelf, and being asked whether to save it
    /// every time one is closed made the question something to dismiss rather than to read. It
    /// becomes unsaved work the moment anything in it is changed.
    /// </para>
    /// </remarks>
    private void OpenPrescripted(PrescriptedEmpireSummary empire)
    {
        if (empire.Design is not { Length: > 0 } design)
        {
            return;
        }

        _session!.CreateEmpire(
            file => file.AddFromTemplate(
                design, Available(_session.Localizer.Text(empire.NameKey, empire.Key))),
            countsAsUnsavedWork: false);

        Editor.IsOpen = true;
    }

    /// <summary>Closes the editor, once whatever is unsaved has been dealt with.</summary>
    /// <remarks>
    /// Through the shared guard, which is the question the editor itself registered. Closing the
    /// dialog is not a navigation, so nothing else would have asked.
    /// </remarks>
    private async Task Close()
    {
        if (await Unsaved.ConfirmAsync())
        {
            Finished();
        }
    }

    /// <summary>Takes the editor down. The address follows on the next render.</summary>
    /// <remarks>
    /// An empire that was never in the file goes back out of it. Unsaved work has already been dealt
    /// with by the time this runs - saved, or put back - but one of the game's own carries none, so
    /// nothing else would have taken it out and it would have stayed in the list looking like an
    /// empire the player owned.
    /// </remarks>
    private void Finished()
    {
        _closing = true;
        Editor.IsOpen = false;

        if (_session is { IsHeldOut: true, IsModified: false })
        {
            _session.Revert();
        }
    }

    /// <summary>Opens the same empire, as it stands, in the page of sections.</summary>
    private void OpenAdvanced()
    {
        _crossing = true;
        Editor.IsOpen = false;
        Navigation.NavigateTo("designer");
    }

    /// <summary>
    /// Whether a destination is still this page, or the same empire in the other editor.
    /// </summary>
    /// <remarks>
    /// This page rewrites its own address on every save, to keep the shareable link current, so most
    /// of what arrives here is the page describing itself. The sections count too, but only while
    /// the button across is being pressed: the empire is in hand either side, unsaved work and all.
    /// </remarks>
    private bool SameEmpire(string route) =>
        route is "" or "e"
        || route.StartsWith("e/", StringComparison.Ordinal)
        || (_crossing && route is "designer");

    /// <summary>
    /// Opens an empire someone sent a link to, without giving it to the player until they say so.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Offered rather than swapped in: the link is a gift, not a replacement for the empires the
    /// player already has. A name already taken gets a number after it, as a copy would. And a gift
    /// is not kept until it is accepted - the empire is created rather than added, so it lives in
    /// the file only for as long as the editor is looking at it and is written nowhere until Save.
    /// </para>
    /// <para>
    /// An empire the file already holds is selected instead of copied. That matters now that the
    /// address bar always carries the empire being edited: without it, every reload of an ordinary
    /// editing session would add another copy of the same empire.
    /// </para>
    /// </remarks>
    private void OpenSharedDesign()
    {
        if (SharedDesign() is not { Length: > 0 } shared || DesignLink.Decode(shared) is not { } design)
        {
            return;
        }

        Editor.IsOpen = true;

        // Compared as encoded text because that is exactly what a link carries: two designs with the
        // same encoding are the same empire down to the byte, and no field has to be named here.
        if (_session!.File?.Designs.FirstOrDefault(d => DesignLink.Encode(d) == shared) is { } already)
        {
            _session.Select(already);
            return;
        }

        // Created rather than added to the file, which is the whole difference between looking at
        // somebody's empire and being given it. A created empire is held out of the player's file
        // until they press Save - it is in there only because the editor has to have something to
        // work on - and turning to anything else takes it back out again. Added, it was theirs
        // before they had seen it: EditFile announces the change, the host keeps the file, and it
        // was in browser storage by the time the page finished drawing.
        //
        // Selecting inside the change was the second half of that. Select takes a saved snapshot,
        // so the empire arrived already looking saved: the Save button was disabled, the revert
        // icon was not drawn, and leaving asked nothing. There was no way to accept a shared empire
        // even deliberately.
        _session.CreateEmpire(file =>
        {
            var key = design.Key;

            for (var attempt = 2; file.Find(key) is not null; attempt++)
            {
                key = $"{design.Key} {attempt}";
            }

            return file.AddCopy(design, key);
        });
    }

    /// <summary>
    /// The packed empire this page was opened with, whichever way it was written.
    /// </summary>
    /// <remarks>
    /// The path is what links carry now - nine characters shorter than the query it replaced, and
    /// with no question mark or equals sign for a chat client to decide is punctuation. The query
    /// is still read, and always will be: it is what every link shared before this carries, and a
    /// link somebody sent is not ours to expire.
    /// </remarks>
    private string? SharedDesign() =>
        Shared is { Length: > 0 } fromPath
            ? fromPath
            : System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)[DesignLink.Parameter];

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnChanged;
        }
    }

    private void OnChanged()
    {
        // The content packs decide which empires are listed, so the list is worked out again - and
        // the rows with it, since every one of them is a reading of an empire that may have just
        // been edited, and a government that is no longer the empire's is worse than no government.
        _prescripted = null;
        _rows = null;
        _ownRows = null;
        _presetRows = null;

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Both lists as rows, which is what the table sorts and the filters offer choices from.
    /// </summary>
    /// <remarks>
    /// Held, and only built when the table is actually being drawn. Each row costs a rules context
    /// - a government is derived rather than stored - and ninety of those on every keystroke in the
    /// search box would be a filter you could watch happening. Cleared with the prescripted list,
    /// which is to say whenever anything about the session changes.
    /// </remarks>
    private IReadOnlyList<EmpireRow> AllRows => _rows ??= [.. OwnRows, .. PresetRows];

    private IReadOnlyList<EmpireRow> OwnRows => _ownRows ??=
    [
        .. (_session!.File?.Designs ?? []).Select(d => EmpireRow.Read(_session, d))
    ];

    private IReadOnlyList<EmpireRow> PresetRows => _presetRows ??=
    [
        .. Prescripted
            .Select(e => (Empire: e, Read: Read(e)))
            .Where(p => p.Read is not null)
            .Select(p => EmpireRow.Read(_session!, p.Read!.Design, p.Empire))
    ];

    private IReadOnlyList<EmpireRow>? _rows;
    private IReadOnlyList<EmpireRow>? _ownRows;
    private IReadOnlyList<EmpireRow>? _presetRows;

    /// <summary>One list, narrowed by whatever is in the filter card.</summary>
    private IReadOnlyList<EmpireRow> Narrowed(IReadOnlyList<EmpireRow> rows) =>
        _filter.Any ? [.. rows.Where(_filter.Matches)] : rows;

    /// <summary>The columns on offer, named as the picker shows them.</summary>
    private IReadOnlyList<EmpireChoice> ColumnOptions { get; } =
    [
        .. EmpireColumn.All.Select(c => new EmpireChoice(c.Key, c.Header, null, null))
    ];

    /// <summary>The chosen columns, in the order the table declares rather than the order ticked.</summary>
    private IReadOnlyList<EmpireColumn> VisibleColumns =>
        [.. EmpireColumn.All.Where(c => _visible.Contains(c.Key))];

    /// <summary>Swaps the views, and remembers it.</summary>
    private void ShowList(bool list)
    {
        _listView = list;
        _session?.Preferences.Set(ViewSetting, list ? ListView : "cards");
    }

    /// <summary>
    /// Keeps the chosen columns, written as their keys.
    /// </summary>
    /// <remarks>
    /// An empty choice is stored as a single space rather than as nothing, because nothing is what
    /// an unanswered setting looks like - and a reader who turned every column off would have found
    /// the defaults back on the next time they opened the page.
    /// </remarks>
    private void RememberColumns() =>
        _session?.Preferences.Set(
            ColumnSetting,
            _visible.Count == 0 ? " " : string.Join(",", _visible));

    /// <summary>Opens whichever list the row came from, the same way pressing its card would.</summary>
    private void OpenRow(EmpireRow row)
    {
        if (row.Preset is { } preset)
        {
            OpenPrescripted(preset);
        }
        else
        {
            OpenOwn(row.Design);
        }
    }

    /// <summary>
    /// The game's own empires, those a player could actually start as, worked out once.
    /// </summary>
    /// <remarks>
    /// Several are marked playable only with a content pack, and a couple not at all — the game
    /// keeps a legacy United Nations of Earth beside the playable one. Judged against what the
    /// player says they own, so the list matches what their game would show.
    /// </remarks>
    /// <remarks>
    /// Held rather than recomputed: judging one needs a context, and building that per empire meant
    /// fifty-two throwaway files and designs every time the page drew. Cleared when the session
    /// changes, which is what turning a content pack on and off does.
    /// </remarks>
    private IReadOnlyList<PrescriptedEmpireSummary> Prescripted =>
        _prescripted ??= BuildPrescripted();

    private IReadOnlyList<PrescriptedEmpireSummary>? _prescripted;

    private readonly RequirementEvaluator _evaluator = new();

    private IReadOnlyList<PrescriptedEmpireSummary> BuildPrescripted()
    {
        // A built-in empire's own conditions are almost all about content packs, so nothing about
        // any particular design matters here — only what the player has.
        var context = _session!.Rules.CreateContext(
            EmpireDesignsFile.CreateEmpty().Add("scratch"),
            _session.OwnedDlc);

        return
        [
            .. _session.Data.Database.PrescriptedEmpires
                .Where(e => _evaluator.IsSatisfied(e.Playable, context))
                .OrderBy(e => _session.Localizer.Text(e.NameKey, e.Key), StringComparer.CurrentCulture)
        ];
    }

    private string? Thumbnail(PrescriptedEmpireSummary empire) =>
        PortraitArtwork.For(_session!.Data.Database, empire.Portrait, gender: null);

    /// <summary>The third line of the game's own list entry: what kind of thing lives there.</summary>
    private string? ClassOf(PrescriptedEmpireSummary empire) =>
        empire.SpeciesClass is { Length: > 0 } kind ? _session!.Localizer.Text(kind) : null;

    /// <summary>One of the game's empires, read out of its stored text.</summary>
    private sealed record Preset(EmpireDesign Design, string Government);

    /// <summary>
    /// The game's own empires as designs, read once and held.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A built-in empire's flag and its government are both inside the stored text rather than
    /// beside it in the summary, so showing either means parsing the empire. Fifty-two of them, and
    /// the list draws on every keystroke elsewhere on the page — so they are read once.
    /// </para>
    /// <para>
    /// Never cleared, unlike the list of which empires are offered. What an empire's government is
    /// called depends on its authority, ethics and civics, and not one of the game's hundred and
    /// seventy government types asks about a content pack — so turning a pack off can change which
    /// of these are listed but never what any of them is called.
    /// </para>
    /// </remarks>
    private Preset? Read(PrescriptedEmpireSummary empire)
    {
        if (_presets.TryGetValue(empire.Key, out var known))
        {
            return known;
        }

        var preset = Parse(empire);
        _presets[empire.Key] = preset;
        return preset;
    }

    private readonly Dictionary<string, Preset?> _presets = new(StringComparer.Ordinal);

    private Preset? Parse(PrescriptedEmpireSummary empire)
    {
        if (empire.Design is not { Length: > 0 } text)
        {
            return null;
        }

        try
        {
            if (EmpireDesignsFile.LoadText(text).Designs.FirstOrDefault() is not { } design)
            {
                return null;
            }

            var context = _session!.Rules.CreateContext(design, _session.OwnedDlc);

            return new Preset(
                design,
                _session.Rules.DeriveGovernment(context) is { } government
                    ? _session.Localizer.Text(government.Key)
                    : _session.Localizer.Text(design.Authority));
        }
        catch (Sem.Clausewitz.CwSyntaxException)
        {
            // One unreadable built-in empire should not take the page down with it.
            return null;
        }
    }

    /// <summary>
    /// Which columns to draw, from what was kept, or the ones worth having at first sight.
    /// </summary>
    /// <remarks>
    /// The defaults are what a player would put on a card if a card had room: what the empire is
    /// called, how it is run, what it believes, and what lives there. The rest are here for the
    /// questions somebody comes to a table with, and are off until they are asked for.
    /// </remarks>
    private HashSet<string> KeptColumns()
    {
        if (_session?.Preferences.Get(ColumnSetting) is not { Length: > 0 } kept)
        {
            return [.. EmpireColumn.All.Where(c => c.OnByDefault).Select(c => c.Key)];
        }

        return
        [
            .. kept
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(key => EmpireColumn.All.Any(c => c.Key == key))
        ];
    }

    /// <summary>A name nothing in the file has yet.</summary>
    private string Available(string wanted)
    {
        if (_session?.File?.Find(wanted) is null)
        {
            return wanted;
        }

        for (var i = 2; ; i++)
        {
            var candidate = $"{wanted} {i}";
            if (_session.File.Find(candidate) is null)
            {
                return candidate;
            }
        }
    }
}
