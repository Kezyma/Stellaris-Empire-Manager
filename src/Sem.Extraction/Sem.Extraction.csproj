<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sem.Clausewitz\Sem.Clausewitz.csproj" />
    <ProjectReference Include="..\Sem.GameData\Sem.GameData.csproj" />
    <ProjectReference Include="..\Sem.Designs\Sem.Designs.csproj" />
    <ProjectReference Include="..\Sem.Assets\Sem.Assets.csproj" />
    <ProjectReference Include="..\Sem.MeshBake\Sem.MeshBake.csproj" />
    <ProjectReference Include="..\Sem.Io\Sem.Io.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    So the tests can reach the pruner directly.

    What it decides is which words the app ships with, and the failure mode is silent: a kind whose
    description is never seeded simply has no prose on its page, and the only thing that notices is
    a reader. Testing it through the writer would mean a whole extraction per assertion.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Sem.Extraction.Tests" />
  </ItemGroup>

</Project>
