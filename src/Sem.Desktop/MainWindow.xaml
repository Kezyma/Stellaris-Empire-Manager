<Window x:Class="Sem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="Stellaris Empire Manager"
        Height="900" Width="1440"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Grid>
        <!--
            Shown while the game files are being read, which takes a few seconds the first time and
            after a patch. Native rather than in the designer, because the designer cannot start
            until the data it runs on exists.
        -->
        <StackPanel x:Name="StartupPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="620">

            <TextBlock Text="Stellaris Empire Manager"
                       Foreground="#DBE2EA"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="StatusText"
                       Text="Looking for your Stellaris installation…"
                       Foreground="#8B97A6"
                       FontSize="14"
                       Margin="0,16,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DetailText"
                       Foreground="#5D6875"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="Progress"
                         Height="4"
                         Margin="0,20,0,0"
                         IsIndeterminate="True"
                         Background="#151B24"
                         Foreground="#4A9FD4"
                         BorderThickness="0" />

            <StackPanel x:Name="ChoosePanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">

                <Button x:Name="ChooseInstallButton"
                        Content="Choose installation…"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="OnChooseInstall" />

                <Button x:Name="RetryButton"
                        Content="Try again"
                        Padding="14,7"
                        Click="OnRetry" />
            </StackPanel>
        </StackPanel>

        <blazor:BlazorWebView x:Name="WebView"
                              HostPage="wwwroot\index.html"
                              Visibility="Collapsed" />
    </Grid>
</Window>
