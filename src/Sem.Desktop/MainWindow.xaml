<Window x:Class="Sem.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Stellaris Empire Manager"
        Height="900" Width="1440"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0D1117">

    <!--
        No title bar: the designer draws its own buttons into its header, where the rest of the app's
        chrome already is, and a second bar above them in a different set of colours was the one part
        of the window that did not belong to it.

        A WindowChrome rather than WindowStyle="None" on its own, which loses everything the frame
        was also doing — snapping, the resize borders, and the work area, so that a maximised window
        covered the taskbar. This keeps the frame and gives it no height, which is what a title bar
        is. CaptionHeight is zero because the draggable band belongs to the page: the web view is a
        child window and hit tests its own area, so a caption declared here would be felt only over
        the startup panel, where the window is dragged by hand instead.
    -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            The three window buttons, for the minutes before the designer exists to draw its own.
            Flat, quiet, and sized as Windows sizes its own, with the hover colour carried on Tag so
            that close can be red without a second copy of the template.
        -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#8B97A6" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Tag" Value="#1B2430" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill"
                                        Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            Shown while the game files are being read, which takes a few seconds the first time and
            after a patch. Native rather than in the designer, because the designer cannot start
            until the data it runs on exists.

            The layer fills the window and is painted rather than left transparent, so that the whole
            of it answers a press and the window can be dragged by any part of this screen. Its own
            buttons, because the read now bakes the wardrobe as well and takes long enough that a
            window with no way to close it would be a trap.
        -->
        <Grid x:Name="StartupLayer" Background="#0D1117" MouseLeftButtonDown="OnDragWindow">
            <StackPanel x:Name="StartupPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="620">

                <TextBlock Text="Stellaris Empire Manager"
                           Foreground="#DBE2EA"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock x:Name="StatusText"
                           Text="Looking for your Stellaris installation…"
                           Foreground="#8B97A6"
                           FontSize="14"
                           Margin="0,16,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="DetailText"
                           Foreground="#5D6875"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <ProgressBar x:Name="Progress"
                             Height="4"
                             Margin="0,20,0,0"
                             IsIndeterminate="True"
                             Background="#151B24"
                             Foreground="#4A9FD4"
                             BorderThickness="0" />

                <StackPanel x:Name="ChoosePanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">

                    <Button x:Name="ChooseInstallButton"
                            Content="Choose installation…"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Click="OnChooseInstall" />

                    <Button x:Name="RetryButton"
                            Content="Try again"
                            Padding="14,7"
                            Click="OnRetry" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">

                <Button Content="&#xE921;"
                        ToolTip="Minimise"
                        Style="{StaticResource CaptionButton}"
                        Click="OnMinimise" />

                <Button Content="&#xE922;"
                        ToolTip="Maximise"
                        Style="{StaticResource CaptionButton}"
                        Click="OnToggleMaximise" />

                <Button Content="&#xE8BB;"
                        ToolTip="Close"
                        Tag="#C42B1C"
                        Style="{StaticResource CaptionButton}"
                        Click="OnCloseWindow" />
            </StackPanel>
        </Grid>

        <blazor:BlazorWebView x:Name="WebView"
                              HostPage="wwwroot\index.html"
                              Visibility="Collapsed" />
    </Grid>
</Window>
