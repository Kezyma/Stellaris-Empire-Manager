<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      On so the compiler checks doc comments: malformed XML, a <param> naming an argument that does
      not exist, two <summary> elements on one member. Nothing checked them before, and sixteen
      members had quietly ended up carrying a second summary that belonged to something else.

      CS1591 - "missing doc comment on a public member" - is suppressed while the comment pass works
      through the projects one at a time. Removing it from this list is how each project is declared
      finished.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1031</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Stellaris Empire Manager</Product>
    <Company>Alex Ashmore</Company>
    <Copyright>Copyright (c) Alex Ashmore</Copyright>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/Kezyma/Stellaris-Empire-Manager</RepositoryUrl>
  </PropertyGroup>

  <!--
    Deterministic builds keep round-trip fixture hashes stable across machines.
  -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == ''">
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
